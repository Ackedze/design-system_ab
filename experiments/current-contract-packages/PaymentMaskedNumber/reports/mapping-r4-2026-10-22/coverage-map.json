      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.minor-last-four-digits",
      "text": "Minor содержит ровно последние четыре цифры номера счёта или карты.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
