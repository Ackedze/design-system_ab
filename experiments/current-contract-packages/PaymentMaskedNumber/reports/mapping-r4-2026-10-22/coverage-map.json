    {
      "RuleID": "component:web-corp.payment-masked-number.public-root-only",
      "text": "Самостоятельно разрешено использовать только PaymentMaskedNumber. Major, Minor, RightAddon и SwapMe являются внутренними частями семейства.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
