    {
      "RuleID": "component:web-corp.payment-masked-number.addon-uses-final-component",
      "text": "Addon по умолчанию скрыт. Если Addon показан, служебный SwapMe должен быть заменён подходящим сценарию компонентом; список допустимых swap-компонентов этим контрактом не ограничивается.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
        "bytes": 40525,
        "pointer": "/manual/rules/5"
      },
