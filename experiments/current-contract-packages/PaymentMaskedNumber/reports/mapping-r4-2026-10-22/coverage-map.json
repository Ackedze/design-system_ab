    {
      "RuleID": "component:web-corp.payment-masked-number.typography-follows-effective-pair",
      "text": "Major и Minor сохраняют свои text styles из effective baseline как согласованную пару; независимое ручное изменение типографики одной из частей запрещено.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
