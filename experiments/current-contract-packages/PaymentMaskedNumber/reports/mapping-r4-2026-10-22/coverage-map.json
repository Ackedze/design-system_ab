    {
      "RuleID": "component:web-corp.payment-masked-number.text-style-binding-required",
      "text": "Major и Minor используют опубликованные Figma Text Styles дизайн-системы; raw fontSize, lineHeight, fontWeight и другие ручные параметры без text style запрещены.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
