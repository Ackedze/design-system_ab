      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.narrow-overflow-preserves-last-four",
      "text": "В узком контейнере начало номера сокращается штатным ellipsis, компонент остаётся в одну строку, а последние четыре цифры Minor сохраняются видимыми.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
        "bytes": 40525,
        "pointer": "/manual/rules/9"
      },
      "compiledAuthority": null,
      "figma": "source correspondence only; no new checking/native acceptance",
      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.interaction-and-states-are-contextual",
      "text": "У PaymentMaskedNumber нет собственных loading, disabled и error состояний. Кликабельность root и Addon зависит от продуктового контекста и не является обязательной или запрещённой сама по себе.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
        "bytes": 40525,
        "pointer": "/manual/rules/10"
      },
      "compiledAuthority": null,
      "figma": "source correspondence only; no new checking/native acceptance",
      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.lifecycle-context-is-informational",
      "text": "Lifecycle status компонента является контекстом для агента. Не считай его дизайн-нарушением, если не найден отдельный pattern или exact design rule.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
