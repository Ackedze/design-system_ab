        "pointer": "/manual/rules/0"
      },
      "compiledAuthority": null,
      "figma": "source correspondence only; no new checking/native acceptance",
      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.unmasked-major-format",
      "text": "При Mask Number=False Major содержит начало номера счёта или карты со штатной группировкой через математический пробел U+205F.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
        "bytes": 40525,
        "pointer": "/manual/rules/1"
      },
      "compiledAuthority": null,
      "figma": "source correspondence only; no new checking/native acceptance",
      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.mask-format",
      "text": "При Mask Number=True Major содержит два интерпункта U+00B7 и тонкий пробел U+2009.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
        "bytes": 40525,
        "pointer": "/manual/rules/2"
