      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.parts-share-color-token",
      "text": "Major и Minor можно синхронно перекрасить в любой подходящий цветовой токен. Обе части должны использовать один и тот же token binding; raw-цвет и разные токены запрещены.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
        "bytes": 40525,
