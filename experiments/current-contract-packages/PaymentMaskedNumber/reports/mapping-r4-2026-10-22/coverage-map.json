      "figma": "source correspondence only; no new checking/native acceptance",
      "frontend": "UNKNOWN_NORM_PARITY",
      "Ready": false
    },
    {
      "RuleID": "component:web-corp.payment-masked-number.addon-geometry",
      "text": "Между номером и Addon сохраняется отступ 6 px, а высота Addon не превышает line-height текстовой части номера.",
      "source": {
        "path": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/PaymentMaskedNumber/rules.json",
        "sha256": "9c46afcf8b7ee33c13160575683036c24a9c859b064a99013137eb07bb4eb9fe",
