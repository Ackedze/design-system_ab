        {
          "sourceRuleId": "component:web-corp.background-plate.colored-and-border-use-color-tokens.surface.fill",
          "ruleText": "Для Type=Colored цвет заливки должен быть задан через цветовой токен дизайн-системы. Для Type=Border через цветовой токен задаётся цвет обводки, а видимая заливка запрещена отдельным правилом. Конкретный цвет может отличаться по смыслу поверхности, но raw fill или raw stroke без требуемого token binding являются нарушением."
        },
        {
          "sourceRuleId": "component:web-corp.background-plate.colored-uses-fill-without-stroke.surface",
          "ruleText": "Type=Colored формируется только видимой токенизированной заливкой. Любая видимая обводка, включая привязанную к цветовому токену, нарушает контракт."
        }
      ]
