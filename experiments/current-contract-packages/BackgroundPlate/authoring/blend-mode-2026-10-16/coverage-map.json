      ],
      "sharedSourceStatus": "NOT_APPLIED",
      "nativeStatus": "NOT_RUN_R4; historical unchanged bindings only"
    },
    {
      "sourceRuleId": "component:web-corp.background-plate.padding-is-designer-controlled",
      "sourceText": "Рекомендуемый стартовый padding BackgroundPlateSlot: 32 px для Level-1 (outer) и 24 px для Level-2 (inner). Дизайнер может свободно изменить padding под контекст композиции или применимый паттерн. Само отличие от рекомендуемого значения и отсутствие token binding не являются нарушением и не требуют сброса.",
      "sourcePath": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/BackgroundPlate/rules.json",
      "action": "unchanged",
      "owner": "component",
