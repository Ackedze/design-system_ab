      ],
      "externalRuleIds": [],
      "compiledRuleIds": [],
      "sharedSourceStatus": "NOT_APPLIED",
      "nativeStatus": "NOT_RUN_R4; historical unchanged bindings only"
    },
    {
      "sourceRuleId": "component:web-corp.background-plate.radius-is-fixed-by-component-baseline",
      "sourceText": "Скругления BackgroundPlate, BackgroundPlateSlot и вложенных Style Level задаются компонентом и его effective baseline. Дизайнер не должен вручную изменять radius/cornerRadius у root-layer BackgroundPlate, BackgroundPlateSlot или Style Level. Любое отличие radius от effective baseline является нарушением, а не допустимой композиционной настройкой.",
      "sourcePath": "/Users/alexkukhta/Desktop/workplace/shared/design-system_ab/JSONS/web/components/web-corp/BackgroundPlate/rules.json",
      "action": "unchanged",
      "owner": "component",
      "manualRuleIds": [
