  "decisions": [
    {
      "id": "decision:core.web.button.nowrap-conditional-width",
      "status": "accepted",
      "summary": "nowrap=false разрешает перенос; обязательный FILL относится только к явно заданному сценарию ограниченной ширины.",
      "rationale": "Подтверждено владельцем 29.09.2026. Контекст не является code/Figma prop, не выводится из actual или defaultValue. При отсутствии видимого текста правило неприменимо. Неизвестная видимость/идентичность/ожидание не означает pass. Обычный аудит продолжает проверять согласованные Hug/Fill профили независимо от спецификации. Clipping внешнего контейнера не становится универсальным ограничением Button: cookbook-рекомендацию нужно оценивать в контексте размещения; этот mapping не обещает отсутствие внешнего обрезания. Продуктовые и канальные паттерны не включены.",
      "sourceRefs": [
        "ds-ai-hub.button.bridge",
        "ds-ai-hub.button.figma-cookbook"
      ]
    },
    {
      "id": "decision:core.web.button.working-default",
      "status": "accepted",
      "summary": "Рабочий default генерации не равен техническому default Figma.",
      "rationale": "Для новых макетов явно применяется Secondary/56 без Hint и Addon; технический default Accent/72 нужен только как библиотечный факт.",
      "sourceRefs": [
        "ds-ai-hub.button.bridge",
        "ds-ai-hub.button.figma-cookbook"
      ]
    },
    {
      "id": "decision:core.web.button.one-semantic-component",
      "status": "accepted",
      "summary": "Четыре Figma component set и три React export являются представлениями одного componentId.",
      "rationale": "Default/inverted и desktop/mobile не создают параллельные семантические компоненты.",
      "sourceRefs": [
        "ds-ai-hub.button.bridge"
      ]
    },
    {
      "id": "decision:core.web.button.pattern-ownership",
      "status": "accepted",
      "summary": "Правила применения, каналов, продуктов и группировки не входят в ComponentContract Button.",
      "rationale": "Пять существующих правил применения перенесены с прежними RuleID в ручной источник будущего паттерна кнопок. В Button нет нормативных копий, делегаций или pending-заглушек этих правил. API, intrinsic constraints и зависимости остаются компонентными. Проверка Button не является проверкой применения; паттерн пока не подключён.",
      "sourceRefs": [
        "ds-ai-hub.button.guidelines"
      ]
    },
    {
      "id": "decision.button.addon-baseline-and-swap-domain",
      "status": "accepted",
      "summary": "Сохранить библиотечный legacy baseline; требовать glyph-26 при смене ключа иконки.",
      "rationale": "Владелец принял 2026-09-26. Размер Addon проверяется по ключу component set. Неоднозначный порт, неизвестный или конфликтующий ключ — unknown. Состояние после swap требует собственного reference в host context; baseline старого ассета не переносится.",
      "sourceRefs": [
        "ds-ai-hub.button.bridge",
        "ds-ai-hub.button.figma-cookbook"
      ]
    },
    {
      "id": "decision.button.spinner-palette-scope",
      "status": "accepted",
      "summary": "Матрица View→Spinner.Inverted/Static действует для обычных [D]/[M] Button всех размеров 32–72, слева и справа; не для Button_Inverted.",
      "rationale": "Обычная матрица для D/M всех размеров 32–72 подтверждена 28.09.2026 и сохранена. Отдельная inverted-матрица утверждена 29.09.2026 в decision:core.web.button.inverted-loading-palette; матрица принята владельцем, отдельный повтор live-кейсов не требуется. Приёмка и границы свидетельств сохранены в QA.",
      "sourceRefs": [
        "ds-ai-hub.button.bridge"
      ]
    },
    {
      "id": "decision:core.web.button.inverted-loading-palette",
      "status": "accepted",
      "summary": "Button_Inverted: Accent → Inverted=True/Static=True; Primary → False/False; Secondary/Outlined/Transparent/Text → True/False. D/M, Size=32–72, оба слота.",
      "rationale": "Утверждено владельцем 29.09.2026. Локальное ограничение композиции Button, не паттерн применения. Собственный pinned контракт Spinner r8 остаётся неизменным.",
      "sourceRefs": [
        "ds-ai-hub.button.bridge"
      ]
    },
    {
      "id": "decision:core.web.button.hint-enabled-vs-visible",
      "status": "accepted",
      "summary": "hintEnabled — настроенный BOOLEAN; hintVisible — read-only видимость semantic target. Собственное ограничение Hint/Size проверяет видимый контент.",
      "rationale": "Владелец согласовал после BL11/BL12 2026-09-28. Результат задаётся manual bindings; общий runtime вычисляет факты, Predicate Engine исполняет прежние RuleIDs. Старые r20 snapshots сохраняют прежнюю семантику. Продуктовые ограничения определяются внешним владельцем, а не Button.",
      "sourceRefs": [
