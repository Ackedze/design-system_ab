  "semantics": {
    "purpose": "Контейнер основного содержимого desktop-страницы корпоративного интерфейса. Сохраняет системную геометрию и оформление библиотечного компонента и предоставляет открытый слот Body для произвольного содержимого и композиций.",
    "useWhen": [
      "Нужно разместить основное содержимое desktop-страницы в системном контейнере CorporateContent.",
      "Нужно собрать произвольную композицию внутри Body, сохранив библиотечную геометрию и оформление контейнера."
    ],
    "doNotUseWhen": [
      {
        "condition": "Нужна mobile-web версия: это представление и профиль предназначены для desktop."
      },
      {
        "condition": "Нужен контейнер самостоятельной модальной поверхности: CorporateContent допускает только page modes фона."
      }
    ],
