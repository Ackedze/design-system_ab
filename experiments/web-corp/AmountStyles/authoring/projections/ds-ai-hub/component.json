  "decisions": [
    {
      "id": "preset-owner-boundaries",
      "status": "accepted",
      "summary": "Addon только IconView/StatusBadge и не выше line-height; Opacity Minor/Currency запрещён в пресете.",
      "rationale": "Прямые ответы владельца 2026-09-29. Не переносить эти ограничения в Core Amount и не выносить их в продуктовый паттерн.",
      "sourceRefs": []
    },
    {
      "id": "amount-dependency",
      "status": "accepted",
      "summary": "Core Amount r5 подключён по revision и двум hashes; правила дочернего компонента не копируются.",
      "rationale": "Пресет сужает API вложенного Amount. Эффективная типографика определяется Style пресета, внутреннее устройство — контрактом Amount.",
      "sourceRefs": []
    },
    {
      "id": "operation-default-drift",
      "status": "accepted",
      "summary": "Живой библиотечный default Operation=True; старый текст Operation=False не является запретом.",
      "rationale": "Проверены все 19 публичных variants. Hub не исправлен молча; расхождение внесено в backlog.",
      "sourceRefs": [
        "athena.amount-styles.rules",
        "hub.amount-styles.instructions"
      ]
    },
    {
      "id": "partial-runtime-r1",
      "status": "accepted",
      "summary": "r1 — Draft с явными неисполненными проверками; не заявлять полноту по отсутствию нарушений.",
      "rationale": "Нужны новые проверки равенства токенов/типографики и live acceptance. Code mapping и patterns отдельно.",
      "sourceRefs": []
    },
    {
      "id": "currency-custom-scope",
      "status": "accepted",
      "summary": "Ограничение Currency.Custom только для отсутствующей в списке валюты полностью отменено.",
      "rationale": "Прямой ответ владельца 2026-09-29: «убираем это ограничение вообще». Не переносить его в паттерн; старые sources сохраняются только как evidence отменённой нормы.",
      "sourceRefs": [
        "athena.amount-styles.rules",
        "hub.amount-styles.instructions"
      ]
    },
    {
      "id": "remove-single-line",
      "status": "accepted",
      "summary": "Правило однострочности полностью отменено; ширина и клиппинг внешнего контейнера принадлежат паттерну.",
      "rationale": "Владелец 2026-09-29 подтвердил «удаляем». Не переносить однострочность в другое активное правило и не восстанавливать из Athena evidence.",
      "sourceRefs": [
        "athena.amount-styles.rules",
        "hub.amount-styles.instructions"
      ],
      "retiredRuleIds": [
        "component:web-corp.amount-styles.amount-stays-on-one-line"
      ]
    },
    {
      "id": "remaining-preset-checks",
      "status": "accepted",
      "summary": "Следующие этапы: запрет изменения текста Operation; внутренняя геометрия; запрет ручного оформления без условия кликабельности.",
      "rationale": "Operation может быть скрыт и переключать Negative штатно. Геометрия не включает внешнюю ширину, клиппинг и отменённую однострочность. У ручного оформления исключить внешнее содержимое Addon. Эти проверки остаются context-only до реализации и тестов.",
      "sourceRefs": []
    },
    {
      "id": "operation-native-sign-r7",
      "status": "accepted",
      "summary": "Operation: библиотечный текст выбранного Negative неизменяем; штатное переключение Negative и скрытие разрешены.",
      "rationale": "Сохранены оба исходных RuleID: запрет текста исполняется через propertyForbidden/library-text, штатная настройка является policy-only. Ожидаемый знак берётся из pinned Athena variant evidence по componentKey, не выводится из имени или текста actual. Существующий same-family-text связывает sign с Operation при переключении варианта.",
      "sourceRefs": [
        "athena.amount-styles.rules"
      ]
    }
  ],
