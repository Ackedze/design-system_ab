    {
      "id": "decision:core.web.button.desktop-hint-canonical-rule",
      "status": "accepted",
      "summary": "Запрет Hint для desktop Альфа-Бизнес хранится только в component:web-core.button.desktop-hint-restricted; тестовый ID component:core.web.button.root.component-properties-hint-4-8 сохранён как deprecated.",
      "rationale": "Пользователь подтвердил запрет Hint в Альфа-Бизнес и согласовал консолидацию. Product ID ab соответствует Editor. Другие неподтверждённые ограничения View/Size/Shape/mobile не становятся подтверждёнными автоматически.",
      "sourceRefs": [
