{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "rule:components.title-view.external-spacing",
      "ruleKind": "design-rule",
      "authority": {
        "status": "active",
        "provenance": "design-system-author",
        "revision": 1
      },
      "severity": "error",
      "applicability": {
        "pageTypes": [],
        "channels": ["Desktop", "MobileWeb"]
      },
      "scope": {
        "kind": "layout-relations",
        "titleViewVariants": ["xLarge"]
      },
      "assertion": {
        "kind": "vertical-spacing-relations",
        "expectations": [
          {
            "relationKind": "page-top-margin",
            "fromRole": "header",
            "toRole": "title-view",
            "spacing": 40,
            "unit": "px",
            "token": "TopMargin"
          },
          {
            "relationKind": "next-content-gap",
            "fromRole": "title-view",
            "toRoles": ["content", "tabs-view", "filters-block", "plate"],
            "spacing": 32,
            "unit": "px"
          },
          {
            "relationKind": "next-content-gap",
            "fromRole": "title-view",
            "toRoles": ["top-bar"],
            "spacing": 12,
            "unit": "px"
          }
        ]
      },
      "requiredEvidence": [
        "scan.channel",
        "facts.layoutRelations[].relationKind",
        "facts.layoutRelations[].semantic",
        "facts.layoutRelations[].measurement.actualPx"
      ],
      "messages": {
        "title": "Нарушен внешний отступ TitleView",
        "observed": "Фактический вертикальный отступ равен {actualPx} px.",
        "expected": "Вертикальный отступ для связи {fromRole} -> {toRole} должен быть {expectedPx} px.",
        "remediation": "Установите нормативный внешний отступ для этой связи."
      },
      "source": {
        "path": "patterns/p_title-view.md",
        "dsAiHubPath": "products/ab/patterns/title-view.md",
        "ruleId": "rule:components.title-view.external-spacing",
        "section": "Rule 11: Соблюдай внешние отступы TitleView",
        "quote": "Между [D] Header и [D] TitleView используется 40 px через TopMargin. Между [D] TitleView и основным контентом используется 32 px. Для TopBar используется 12 px."
      }
    },
    {
      "id": "rule:forms.construction-rules.title-medium-one-per-plate",
      "ruleKind": "design-rule",
      "authority": {
        "status": "active",
        "provenance": "design-system-author",
        "revision": 1
      },
      "severity": "error",
      "applicability": {
        "pageTypes": ["form"],
        "channels": ["Desktop", "MobileWeb"]
      },
      "scope": {
        "kind": "component-subtree",
        "containerComponentNames": [
          "[D] BackgroundPlateSlot",
          "[M] BackgroundPlateSlot"
        ]
      },
      "target": {
        "componentNames": ["[D] TitleView", "[M] TitleView"],
        "variantProperties": {
          "View": ["Medium"]
        }
      },
      "assertion": {
        "kind": "max-descendant-count-per-container",
        "maximum": 1
      },
      "requiredEvidence": [
        "scan.pageType",
        "scan.channel",
        "facts.occurrences[].component.name",
        "facts.occurrences[].variant.properties",
        "facts.occurrences[].ancestors"
      ],
      "messages": {
        "title": "На одной подложке используется несколько TitleView Medium",
        "observed": "В одной подложке найдено {actualCount} заголовка TitleView с View=Medium.",
        "expected": "На одной подложке формы допускается только один TitleView с View=Medium.",
        "remediation": "Оставьте один TitleView Medium как главный заголовок логической части; дополнительные заголовки переведите на следующий уровень иерархии."
      },
      "source": {
        "path": "patterns/p_form-construction-rules.md",
        "ruleId": "rule:forms.construction-rules.title-medium-one-per-plate",
        "section": "Rule 9: Используйте один TitleView Medium на одной подложке",
        "quote": "TitleView :: Medium используется только в левой части и является главным заголовком логической части. На одной подложке может быть только один заголовок Medium."
      }
    }
  ]
}
