{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "content-card-wrapper.desktop-background-level",
      "match": {
        "hostComponentNames": ["[D] ContentCardWrapper"]
      },
      "selector": {
        "nestedComponentNames": ["[D] BackgroundPlate"]
      },
      "assert": {
        "variantProperties": {
          "Position": { "oneOf": ["Level 2 (inner)"] }
        }
      },
      "messages": {
        "allowed": "Уровень BackgroundPlate соответствует desktop-композиции ContentCardWrapper",
        "violation": "В [D] ContentCardWrapper требуется BackgroundPlate Position=Level 2 (inner)"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "content-card-wrapper.mobile-background-level",
      "match": {
        "hostComponentNames": ["[M] ContentCardWrapper"]
      },
      "selector": {
        "nestedComponentNames": ["[M] BackgroundPlate"]
      },
      "assert": {
        "variantProperties": {
          "Position": { "oneOf": ["Level 1 (outer)"] }
        }
      },
      "messages": {
        "allowed": "Уровень BackgroundPlate соответствует mobile-композиции ContentCardWrapper",
        "violation": "В [M] ContentCardWrapper требуется BackgroundPlate Position=Level 1 (outer)"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "onboarding-hint.button-fixed",
      "match": {
        "hostComponentNames": ["Onboarding Hint"]
      },
      "selector": {
        "nestedComponentNames": ["[D] Button"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["32"] },
          "View": { "oneOf": ["Text"] },
          "Shape": { "oneOf": ["Rectangular"] },
          "SingleIcon": { "oneOf": ["False"] },
          "DisabledState": { "oneOf": ["False"] }
        }
      },
      "messages": {
        "allowed": "Кнопка соответствует конфигурации Onboarding Hint",
        "violation": "Встроенная кнопка Onboarding Hint должна использовать Size=32, View=Text и штатную форму"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "onboarding-hint.close-fixed",
      "match": {
        "hostComponentNames": ["Onboarding Hint"]
      },
      "selector": {
        "nestedComponentNames": ["Cross"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["24"] },
          "TransparentBg": { "oneOf": ["False"] },
          "View": { "oneOf": ["Primary"] }
        }
      },
      "messages": {
        "allowed": "Close соответствует конфигурации Onboarding Hint",
        "violation": "Close внутри Onboarding Hint должен использовать Size=24, TransparentBg=False и View=Primary"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "onboarding-hint.close-icon-type",
      "match": {
        "hostComponentNames": ["Onboarding Hint"]
      },
      "selector": {
        "nestedComponentNames": ["🔩 Icon"]
      },
      "assert": {
        "variantProperties": {
          "Type": { "oneOf": ["icon-20"] }
        }
      },
      "messages": {
        "allowed": "Иконка Close соответствует конфигурации Onboarding Hint",
        "violation": "Иконка Close внутри Onboarding Hint должна использовать Type=icon-20"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "onboarding-hint.close-glyph-fixed",
      "match": {
        "hostComponentNames": ["Onboarding Hint"]
      },
      "selector": {
        "nestedComponentNames": ["cross"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["20"] },
          "Color": { "oneOf": ["False"] },
          "Style": { "oneOf": ["Thinline"] }
        }
      },
      "messages": {
        "allowed": "Glyph Close соответствует конфигурации Onboarding Hint",
        "violation": "Glyph Close внутри Onboarding Hint должен использовать Size=20, Color=False и Style=Thinline"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "onboarding-tooltip.buttons-fixed",
      "match": {
        "hostComponentNames": ["Onboarding Tooltip"]
      },
      "selector": {
        "nestedComponentNames": ["[D] Button"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["40"] },
          "Shape": { "oneOf": ["Rectangular"] },
          "SingleIcon": { "oneOf": ["False"] },
          "DisabledState": { "oneOf": ["False"] }
        }
      },
      "messages": {
        "allowed": "Кнопка соответствует общей конфигурации Onboarding Tooltip",
        "violation": "Кнопки Onboarding Tooltip должны использовать Size=40, Shape=Rectangular, SingleIcon=False и DisabledState=False"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "onboarding-tooltip.close-glyph-fixed",
      "match": {
        "hostComponentNames": ["Onboarding Tooltip"]
      },
      "selector": {
        "nestedComponentNames": ["cross"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["24"] },
          "Color": { "oneOf": ["False"] },
          "Style": { "oneOf": ["Line"] }
        }
      },
      "messages": {
        "allowed": "Close соответствует конфигурации Onboarding Tooltip",
        "violation": "Close внутри Onboarding Tooltip должен использовать Size=24, Color=False и Style=Line"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "button-stack.option-states-fixed",
      "match": {
        "hostComponentNames": ["🔒 [M] ButtonStack"]
      },
      "selector": {
        "nestedComponentNames": ["CheckboxLabel_24"]
      },
      "assert": {
        "variantProperties": {
          "DisabledLabel": { "oneOf": ["False"] },
          "ErrorMessage": { "oneOf": ["False"] },
          "Hint": { "oneOf": ["False"] }
        }
      },
      "messages": {
        "allowed": "Option соответствует конфигурации ButtonStack",
        "violation": "Option внутри ButtonStack не должна использовать DisabledLabel, ErrorMessage или Hint"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "button-stack.information-addon-fixed",
      "match": {
        "hostComponentNames": ["🔒 [M] ButtonStack"]
      },
      "selector": {
        "nestedComponentNames": ["StatusBadge"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["16"] },
          "View": { "oneOf": ["NeutralInformation"] }
        }
      },
      "messages": {
        "allowed": "Information addon соответствует конфигурации ButtonStack",
        "violation": "Information addon внутри ButtonStack должен использовать StatusBadge Size=16 и View=NeutralInformation"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "status-preset.desktop-shape",
      "match": {
        "hostComponentNames": ["🔒 [D] StatusPreset"]
      },
      "selector": {
        "nestedComponentNames": ["Status"]
      },
      "assert": {
        "variantProperties": {
          "Shape": { "oneOf": ["Rounded"] }
        }
      },
      "messages": {
        "allowed": "Shape соответствует конфигурации desktop StatusPreset",
        "violation": "Status внутри desktop StatusPreset должен использовать Shape=Rounded"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "status-preset.mobile-shape",
      "match": {
        "hostComponentNames": ["🔒 [M] StatusPreset"]
      },
      "selector": {
        "nestedComponentNames": ["Status"]
      },
      "assert": {
        "variantProperties": {
          "Shape": { "oneOf": ["Rounded"] }
        }
      },
      "messages": {
        "allowed": "Shape соответствует конфигурации mobile StatusPreset",
        "violation": "Status внутри mobile StatusPreset должен использовать Shape=Rounded"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "property-preset.desktop-shape",
      "match": {
        "hostComponentNames": ["🔒 [D] PropertyPreset"]
      },
      "selector": {
        "nestedComponentNames": ["Status"]
      },
      "assert": {
        "variantProperties": {
          "Shape": { "oneOf": ["Rectangular"] }
        }
      },
      "messages": {
        "allowed": "Shape соответствует конфигурации desktop PropertyPreset",
        "violation": "Status внутри desktop PropertyPreset должен использовать Shape=Rectangular"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "property-preset.mobile-shape",
      "match": {
        "hostComponentNames": ["🔒 [M] PropertyPreset"]
      },
      "selector": {
        "nestedComponentNames": ["Status"]
      },
      "assert": {
        "variantProperties": {
          "Shape": { "oneOf": ["Rectangular"] }
        }
      },
      "messages": {
        "allowed": "Shape соответствует конфигурации mobile PropertyPreset",
        "violation": "Status внутри mobile PropertyPreset должен использовать Shape=Rectangular"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "status-property.desktop-uppercase",
      "match": {
        "hostComponentNames": ["🔒 [D] StatusPreset", "🔒 [D] PropertyPreset"]
      },
      "selector": {
        "nestedComponentNames": ["🔩 Label"]
      },
      "assert": {
        "variantProperties": {
          "Uppercase": { "oneOf": ["True"] }
        }
      },
      "messages": {
        "allowed": "Регистр соответствует desktop-версии Status/Property",
        "violation": "Label внутри desktop Status/Property должен использовать Uppercase=True"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "status-property.mobile-uppercase",
      "match": {
        "hostComponentNames": ["🔒 [M] StatusPreset", "🔒 [M] PropertyPreset"]
      },
      "selector": {
        "nestedComponentNames": ["Label"]
      },
      "assert": {
        "variantProperties": {
          "Uppercase": { "oneOf": ["False"] }
        }
      },
      "messages": {
        "allowed": "Регистр соответствует mobile-версии Status/Property",
        "violation": "Label внутри mobile Status/Property должен использовать Uppercase=False"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "tabs-view.desktop-secondary-fixed",
      "match": {
        "hostComponentNames": ["[D] TabsView"]
      },
      "selector": {
        "nestedComponentNames": ["[D] Tag"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["40"] },
          "View": { "oneOf": ["Filled"] },
          "Shape": { "oneOf": ["Rounded"] },
          "SingleIcon": { "oneOf": ["False"] }
        }
      },
      "messages": {
        "allowed": "Secondary tab соответствует конфигурации desktop TabsView",
        "violation": "Secondary tabs в desktop TabsView должны использовать Size=40, View=Filled, Shape=Rounded и SingleIcon=False"
      },
      "presentation": "semantic-variant"
    },
    {
      "id": "tabs-view.mobile-secondary-fixed",
      "match": {
        "hostComponentNames": ["[M] TabsView"]
      },
      "selector": {
        "nestedComponentNames": ["[M] Tag"]
      },
      "assert": {
        "variantProperties": {
          "Size": { "oneOf": ["40"] },
          "View": { "oneOf": ["Filled"] },
          "Shape": { "oneOf": ["Rounded"] },
          "SingleIcon": { "oneOf": ["False"] }
        }
      },
      "messages": {
        "allowed": "Secondary tab соответствует конфигурации mobile TabsView",
        "violation": "Secondary tabs в mobile TabsView должны использовать Size=40, View=Filled, Shape=Rounded и SingleIcon=False"
      },
      "presentation": "semantic-variant"
    }
  ]
}
