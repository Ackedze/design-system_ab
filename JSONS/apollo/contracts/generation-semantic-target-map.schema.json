{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ackedze.github.io/design-system_ab/JSONS/apollo/contracts/generation-semantic-target-map.schema.json",
  "title": "Apollo generation semantic target map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "componentId",
    "sourceContract",
    "profiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "generation-semantic-target-map" },
    "componentId": { "type": "string", "minLength": 1 },
    "sourceContract": { "const": "contract.generated.json" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "path", "nodeTypes", "occurrence"],
      "properties": {
        "strategy": { "const": "path-suffix" },
        "path": { "type": "string", "minLength": 1 },
        "nodeTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["TEXT", "SLOT", "INSTANCE", "FRAME", "COMPONENT"]
          }
        },
        "occurrence": { "type": "integer", "minimum": 0 }
      }
    },
    "propertyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "values"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": ["string", "boolean", "number"] }
        }
      }
    },
    "editContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "value"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z0-9][A-Za-z0-9]*)+$"
        },
        "value": { "type": ["string", "boolean", "number"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "supported"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z0-9][A-Za-z0-9]*)+$"
        },
        "kind": {
          "enum": [
            "variant-property",
            "text",
            "slot",
            "node-visibility",
            "instance-property",
            "unsupported"
          ]
        },
        "supported": { "type": "boolean" },
        "property": { "type": "string", "minLength": 1 },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "boolean", "number"]
          }
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" }
        },
        "writePolicy": { "enum": ["first", "all"] },
        "availableWhen": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/propertyCondition" }
        },
        "onUnavailable": { "enum": ["error", "omit"] },
        "editContext": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/editContext" }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "supported": { "const": false } } },
          "then": {
            "properties": { "kind": { "const": "unsupported" } },
            "required": ["reason"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["text", "slot", "node-visibility", "instance-property"]
              }
            }
          },
          "then": { "required": ["selectors"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["variant-property", "instance-property"] }
            }
          },
          "then": { "required": ["property", "values"] }
        },
        {
          "if": { "required": ["onUnavailable"] },
          "then": { "required": ["availableWhen"] }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "contractId",
        "publicRoot",
        "verification",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "platform": { "enum": ["desktop", "mobile-web", "universal"] },
        "contractId": { "type": "string", "minLength": 1 },
        "publicRoot": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "liveInstanceVerified"],
          "properties": {
            "source": { "const": "contract.generated.json" },
            "liveInstanceVerified": { "type": "boolean" }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    }
  }
}
