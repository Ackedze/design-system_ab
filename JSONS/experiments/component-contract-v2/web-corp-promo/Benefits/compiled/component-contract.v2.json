    {
      "id": "rule-ir:web-corp-promo.benefits.capacity-matches-card-count",
      "source": {
        "file": "JSONS/web/components/web-corp-promo/Benefits/rules.json",
        "sourceRuleIds": [
          "component:web.benefits.capacity-matches-card-count"
        ],
        "patternRuleId": null
      },
      "severity": "error",
      "enforcement": "classification",
      "select": {
        "host": "host.package",
        "targets": "tree.package"
      },
      "when": {
        "op": "all",
        "clauses": {
          "allowedCardCounts": [
            3,
            4
          ],
          "requiredMapping": {
            "3": 3,
            "4": 4
          }
        }
      },
      "assert": {
        "op": "classificationPolicy",
        "treatAsViolation": true,
        "designSeverity": "error",
        "resetSurface": "parameters"
      },
      "verdict": {
        "pass": "allowed",
        "fail": "unknown",
        "unknown": "unknown"
      },
      "evidence": [
        "ancestry",
        "component.identity",
        "node.documentOrder",
        "semanticRole",
        "variant.properties"
      ],
      "remediation": {
        "kind": "rule-defined-remediation",
        "specification": "Выберите Capacity, равный числу карточек. Для группы меньше трёх или больше четырёх соберите BenefitCard вручную без Benefits."
      },
      "presentation": {
        "message": "Benefits содержит строго три или четыре BenefitCard: Capacity=3 соответствует трём карточкам, Capacity=4 — четырём. Удалять карточки из пресета, добавлять пятую или использовать Benefits для другого количества нельзя. Ручная группа отдельных BenefitCard разрешена только при количестве меньше трёх или больше четырёх.",
        "group": "variant.Capacity|component.composition"
      },
      "capabilities": {
        "selectors": [
          "component-identity",
          "self-and-descendants"
        ],
        "facts": [
          "ancestry",
          "component.identity",
          "node.documentOrder",
          "semanticRole",
          "variant.properties"
        ],
        "operators": [
          "classificationPolicy"
        ],
        "remediations": [
          "rule-defined-remediation"
        ]
      }
    },
