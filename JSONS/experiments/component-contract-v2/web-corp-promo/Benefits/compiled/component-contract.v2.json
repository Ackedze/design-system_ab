      "id": "rule-ir:web-corp-promo.benefits.desktop-compact-required-at-1024",
      "source": {
        "file": "JSONS/web/components/web-corp-promo/Benefits/rules.json",
        "sourceRuleIds": [
          "component:web.benefits.desktop-compact-required-at-1024"
        ],
