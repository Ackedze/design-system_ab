      },
      "severity": "error",
      "enforcement": "enforced",
      "select": {
        "host": "host.package",
        "targets": "tree.package"
      },
      "when": {
        "op": "all",
        "clauses": {
          "uniformProperties": [
            "Background",
            "CardAxis",
            "Compact",
            "GraphicPosition"
          ],
          "allowedPerCardDifferences": {
            "surfaceTypes": [
              "Border",
              "Colored"
