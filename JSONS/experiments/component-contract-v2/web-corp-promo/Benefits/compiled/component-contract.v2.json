        "layout.properties",
        "variant.properties"
      ],
      "remediation": {
        "kind": "rule-defined-remediation",
        "specification": "Установите Compact=True при viewport 1024 px и меньше, Compact=False — при viewport больше 1024 px."
      },
      "presentation": {
        "message": "Desktop Benefits использует Compact=True при viewport 1024 px и меньше и Compact=False при viewport больше 1024 px. Compact=False размещает карточки в одну строку с интервалом 24 px; Compact=True использует интервал 16 px, а Capacity=4 перестраивается в сетку 2 × 2. Capacity=3 при Compact=True остаётся в одной строке.",
        "group": "variant.Compact|layout.*"
      },
