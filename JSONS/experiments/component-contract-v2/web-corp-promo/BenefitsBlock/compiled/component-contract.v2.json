    {
      "id": "rule-ir:web-corp-promo.benefits-block.root-sizing-and-height-scope",
      "source": {
        "file": "JSONS/web/components/web-corp-promo/BenefitsBlock/rules.json",
        "sourceRuleIds": [
          "component:web.benefits-block.root-sizing-and-height-scope"
        ],
        "patternRuleId": null
      },
      "severity": "error",
      "enforcement": "enforced",
      "select": {
        "host": "host.package",
        "targets": "tree.package"
      },
      "when": {
        "op": "all",
        "clauses": {
          "HeightCustomAffectsOnly": "BackgroundPlate height",
          "manualSizingOfOtherPartsAllowed": false
        }
      },
      "assert": {
        "op": "propertiesEqual",
        "values": {
          "layout.sizing.horizontal": "FILL",
          "layout.sizing.vertical": "HUG"
        }
      },
      "verdict": {
        "pass": "expected",
        "fail": "violation",
        "unknown": "unknown"
      },
      "evidence": [
        "component.identity",
        "layout.properties",
        "variant.properties"
      ],
      "remediation": {
        "kind": "rule-defined-remediation",
        "specification": "Восстановите root Fill/Hug; используйте HeightCustom только для высоты BackgroundPlate."
      },
      "presentation": {
        "message": "BenefitsBlock использует Fill по ширине и Hug по высоте. HeightCustom меняет только высоту BackgroundPlate и не разрешает ручные размеры остальных частей.",
        "group": "layout.sizing.*|variant.HeightCustom"
      },
      "capabilities": {
        "selectors": [
          "component-identity",
          "self-and-descendants"
        ],
        "facts": [
          "component.identity",
          "layout.properties",
          "variant.properties"
        ],
        "operators": [
          "propertiesEqual"
        ],
        "remediations": [
          "rule-defined-remediation"
        ]
      }
    }
