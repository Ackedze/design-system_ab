{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/onboarding-personalization",
  "version": "80.10.0",
  "component": "OnboardingPersonalizationPage",
  "exports": [
    "OnboardingPersonalizationChat",
    "OnboardingPersonalizationHeader",
    "OnboardingPersonalizationLogo",
    "OnboardingPersonalizationPage"
  ],
  "props": [
    {
      "name": "ChatComponent",
      "type": "ReactNode",
      "description": "Компонент чата, размещаемый в нижней части страницы"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс контейнера"
    },
    {
      "name": "HeaderComponent",
      "type": "ReactNode",
      "description": "Компонент шапки, размещаемый в верхней части страницы"
    },
    {
      "name": "view",
      "type": "OnboardingPersonalizationView",
      "values": [
        "mmb",
        "alfa-boss"
      ],
      "default": "mmb",
      "description": "Тема оформления"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
