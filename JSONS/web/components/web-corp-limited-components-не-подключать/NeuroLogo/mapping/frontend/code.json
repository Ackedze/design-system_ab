{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/neuro-logo",
  "version": "80.10.0",
  "component": "NeuroLogo",
  "exports": [
    "NeuroLogo"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный ClassName"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для автоматизированного тестирования"
    },
    {
      "name": "label",
      "type": "boolean",
      "default": "true",
      "description": "Отображение лейбла"
    },
    {
      "name": "onClick",
      "type": "MouseEventHandler<HTMLDivElement>",
      "description": "Обработчик клика по компоненту"
    },
    {
      "name": "pro",
      "type": "boolean",
      "default": "false",
      "description": "Вариант для платной подписки"
    },
    {
      "name": "shadow",
      "type": "boolean",
      "default": "false",
      "description": "Градиентный фон у иконки"
    },
    {
      "name": "size",
      "type": "32 | 40 | 28 | 36",
      "values": [
        32,
        40,
        28,
        36
      ],
      "default": "28",
      "description": "Размер компонента"
    },
    {
      "name": "width",
      "type": "number",
      "description": "Пользовательская ширина контейнера\nНе может быть меньше ширины контента (иконка + текст)"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
