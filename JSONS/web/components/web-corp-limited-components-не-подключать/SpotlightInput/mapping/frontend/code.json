{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/spotlight-input",
  "version": "80.10.0",
  "component": "SpotlightInput",
  "exports": [
    "SpotlightInput"
  ],
  "props": [
    {
      "name": "block",
      "type": "boolean",
      "default": "false",
      "description": "Растягивает компонент на ширину контейнера"
    },
    {
      "name": "bottomAddons",
      "type": "ReactNode",
      "description": "Слот под инпутом (подсказка, ошибка)"
    },
    {
      "name": "clear",
      "type": "boolean",
      "default": "true",
      "description": "Показывать крестик для очистки поля (при наличии значения)"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "defaultValue",
      "type": "string",
      "description": "Начальное значение поля"
    },
    {
      "name": "error",
      "type": "boolean",
      "description": "Отображение ошибки — подсвечивает обводку"
    },
    {
      "name": "fieldClassName",
      "type": "string",
      "description": "Дополнительный класс для поля ввода"
    },
    {
      "name": "filledClassName",
      "type": "string",
      "description": "Класс, применяемый при заполненном поле"
    },
    {
      "name": "focusedClassName",
      "type": "string",
      "description": "Класс, применяемый при фокусе"
    },
    {
      "name": "inputClassName",
      "type": "string",
      "description": "Дополнительный класс для нативного input"
    },
    {
      "name": "leftAddons",
      "type": "ReactNode",
      "description": "Слот слева (иконка поиска, например)"
    },
    {
      "name": "onChange",
      "type": "(event: ChangeEvent<HTMLInputElement, Element>, payload: { value: string; }) => void",
      "description": "Обработчик изменения значения"
    },
    {
      "name": "onClear",
      "type": "(event: MouseEvent<HTMLButtonElement, MouseEvent>) => void",
      "description": "Обработчик нажатия кнопки очистки"
    },
    {
      "name": "onClick",
      "type": "(event: MouseEvent<HTMLDivElement, MouseEvent>) => void",
      "description": "Обработчик клика по полю"
    },
    {
      "name": "onMouseDown",
      "type": "(event: MouseEvent<HTMLDivElement, MouseEvent>) => void",
      "description": "Обработчик MouseDown по полю"
    },
    {
      "name": "onSubmit",
      "type": "(event: KeyboardEvent<HTMLInputElement> | MouseEvent<HTMLButtonElement, MouseEvent>) => void",
      "description": "Обработчик нажатия кнопки отправки (клик или Enter)"
    },
    {
      "name": "rightAddons",
      "type": "ReactNode",
      "description": "Слот справа (дополнительные кнопки)"
    },
    {
      "name": "showSubmit",
      "type": "boolean",
      "default": "true",
      "description": "Показывать кнопку отправки (стрелка вверх)"
    },
    {
      "name": "value",
      "type": "string",
      "description": "Значение поля ввода"
    },
    {
      "name": "wrapperRef",
      "type": "Ref<HTMLDivElement>",
      "required": true,
      "description": "Ref для обертки"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
