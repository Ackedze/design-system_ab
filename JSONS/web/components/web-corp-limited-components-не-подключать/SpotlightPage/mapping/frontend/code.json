{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/spotlight-page",
  "version": "80.10.0",
  "component": "SpotlightPage",
  "exports": [
    "SpotlightPage"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "colorsButton",
      "type": "\"default\" | \"inverted\"",
      "values": [
        "default",
        "inverted"
      ],
      "default": "default",
      "description": "Набор цветов для компонентов кнопок"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "disableVerticalInlinePaddings",
      "type": "boolean",
      "description": "Отключить инлайновые вертикальные паддинги"
    },
    {
      "name": "iconInfo",
      "type": "ReactElement<unknown, string | JSXElementConstructor<any>>",
      "default": "<DiamondsLine24Icon />",
      "description": "Иконка для кнопки info"
    },
    {
      "name": "menuLogo",
      "type": "ReactNode",
      "required": true,
      "description": "logo для menu"
    },
    {
      "name": "onCloseButtonClick",
      "type": "(event?: MouseEvent<Element, MouseEvent>) => void",
      "required": true,
      "description": "Обработчик клика на close кнопку"
    },
    {
      "name": "onInfoButtonClick",
      "type": "(event?: MouseEvent<Element, MouseEvent>) => void",
      "description": "Обработчик клика на info кнопку"
    },
    {
      "name": "pageContent",
      "type": "ReactNode",
      "required": true,
      "description": "Контент страницы"
    },
    {
      "name": "pageMenu",
      "type": "ReactNode",
      "required": true,
      "description": "Контент menu"
    },
    {
      "name": "verticalPaddings",
      "type": "Partial<Record<\"mobile\" | \"desktop\", VerticalPaddingsValue>>",
      "description": "Вертикальные отступы"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
