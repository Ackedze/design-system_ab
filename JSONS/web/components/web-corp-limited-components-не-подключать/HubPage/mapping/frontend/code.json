{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/hub-page",
  "version": "80.10.0",
  "component": "HubPage",
  "exports": [
    "HubPage"
  ],
  "props": [
    {
      "name": "blockHeader",
      "type": "boolean",
      "default": "false"
    },
    {
      "name": "className",
      "type": "string"
    },
    {
      "name": "dataTestId",
      "type": "string"
    },
    {
      "name": "hasOffset",
      "type": "boolean",
      "default": "true"
    },
    {
      "name": "header",
      "type": "ReactNode"
    },
    {
      "name": "headerTheme",
      "type": "ThemeType",
      "values": [
        "alfa-on-color",
        "alfa-on-white",
        "grey"
      ],
      "default": "alfa-on-white"
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "theme",
      "type": "ThemeType",
      "values": [
        "alfa-on-color",
        "alfa-on-white",
        "grey"
      ]
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
