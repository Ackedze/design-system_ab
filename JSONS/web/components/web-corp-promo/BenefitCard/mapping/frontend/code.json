{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/benefit-card",
  "version": "80.10.0",
  "component": "BenefitCard",
  "exports": [
    "BenefitCard",
    "BenefitCardDesktop",
    "BenefitCardMobile"
  ],
  "props": [
    {
      "name": "backgroundPlateProps",
      "type": "Omit<BackgroundPlateProps, \"children\">",
      "description": "Дополнительные пропсы для компонента BackgroundPlate"
    },
    {
      "name": "bottomSlot",
      "type": "BottomSlot",
      "description": "Пресеты с ссылкой или кастомным контентом"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс для компонента"
    },
    {
      "name": "compactView",
      "type": "boolean",
      "description": "Компактное отображение компонента"
    },
    {
      "name": "customHeight",
      "type": "number",
      "description": "Позволяет задать свое значение высоты компоненту"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "graphicContent",
      "type": "GraphicContent",
      "description": "Набор для графического контента"
    },
    {
      "name": "graphicPosition",
      "type": "\"right\" | \"left\"",
      "values": [
        "right",
        "left"
      ],
      "description": "Позиционирование графики"
    },
    {
      "name": "orientation",
      "type": "\"horizontal\" | \"vertical\"",
      "values": [
        "horizontal",
        "vertical"
      ],
      "description": "Горизонтальное или вертикальное расположение элементов"
    },
    {
      "name": "rightSubtitleAddon",
      "type": "ReactNode",
      "description": "Правый слот у подзаголовка"
    },
    {
      "name": "rightTitleAddon",
      "type": "ReactNode",
      "description": "Правый слот у заголовка"
    },
    {
      "name": "spaced",
      "type": "boolean",
      "description": "Позволяет отдалить элементы друг от друга"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Подзаголовок для компонента"
    },
    {
      "name": "textAling",
      "type": "\"center\" | \"start\"",
      "values": [
        "center",
        "start"
      ],
      "description": "Позволяет задать выравнивание текстового контента, работает только в горизонтальном виде"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Заголовок для компонента"
    },
    {
      "name": "titleView",
      "type": "\"primary\" | \"secondary\"",
      "values": [
        "primary",
        "secondary"
      ],
      "description": "Позволяет менять размер заголовка"
    },
    {
      "name": "withBackgroundPlate",
      "type": "boolean",
      "description": "Позволяет отображать компонент с подложкой или без"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
