{
  "$schema": "hub/code-connect.overrides@1",
  "description": "Авторский маппинг Figma → React. Побеждает автоматическое сопоставление tools/lib/code-connect.mjs.",
  "reviewedAt": "2026-07-23",
  "properties": [
    {
      "figma": "Background",
      "react": "withBackgroundPlate",
      "values": {
        "False": false,
        "True": true
      }
    },
    {
      "figma": "CardAxis",
      "react": "orientation",
      "values": {
        "Horizontal": "horizontal",
        "Vertical": "vertical"
      }
    },
    {
      "figma": "Compact",
      "react": "compactView",
      "values": {
        "False": false,
        "True": true
      }
    },
    {
      "figma": "GraphicPosition",
      "react": "graphicPosition",
      "values": {
        "Left": "left",
        "Right": "right"
      }
    },
    {
      "figma": "Title",
      "react": "titleView",
      "values": {
        "Primary": "primary",
        "Secondary": "secondary"
      },
      "figmaComponent": "[D] ContentWrapper"
    },
    {
      "figma": "Presets",
      "react": "graphicContent",
      "values": {
        "Icon": {
          "type": "icon"
        },
        "IconView": {
          "type": "icon-view"
        },
        "Image": {
          "type": "image"
        }
      },
      "figmaComponent": "[D] Graphic",
      "note": "GraphicContent is a discriminated union with 'type' field"
    },
    {
      "figma": "Presets",
      "react": "bottomSlot",
      "values": {
        "Link": {
          "type": "link"
        },
        "SwapMe": {
          "type": "custom-slot"
        }
      },
      "figmaComponent": "[D] BottomContent",
      "note": "BottomSlot is a discriminated union with 'type' field"
    }
  ]
}
