{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/footer",
  "version": "80.10.0",
  "component": "Footer",
  "description": "Компонент подвала сайта.\nОбычно используется совместно с компонентом `Page`.",
  "exports": [
    "Footer"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "copyright",
      "type": "ReactNode",
      "description": "Содержимое блока копирайта"
    },
    {
      "name": "data-test-id",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "id",
      "type": "string",
      "description": "Уникальный идентификатор блока"
    },
    {
      "name": "showYears",
      "type": "boolean",
      "description": "Отображение годов"
    },
    {
      "name": "target",
      "type": "\"_blank\" | \"_self\"",
      "values": [
        "_blank",
        "_self"
      ],
      "description": "Открыть ссылку в новой вкладке"
    },
    {
      "name": "theme",
      "type": "ThemeType",
      "values": [
        "alfa-on-color",
        "alfa-on-white",
        "grey"
      ],
      "description": "Тема компонента"
    },
    {
      "name": "version",
      "type": "string",
      "description": "Версия приложения, отображается при наведении курсора на значок ©"
    }
  ],
  "status": {
    "lifecycle": "deprecated",
    "since": "2024-09-30"
  }
}
