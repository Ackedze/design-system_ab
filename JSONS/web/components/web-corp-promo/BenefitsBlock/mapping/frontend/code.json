{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/benefit-block",
  "version": "80.10.0",
  "component": "BenefitBlock",
  "exports": [
    "BenefitBlock",
    "BenefitBlockDesktop",
    "BenefitBlockMobile"
  ],
  "props": [
    {
      "name": "backgroundPlateProps",
      "type": "BackgroundPlateProps",
      "description": "Дополнительные пропы для BackgroundPlate"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный ClassName"
    },
    {
      "name": "compact",
      "type": "boolean",
      "description": "Компактная версия компонента"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для автоматизированного тестирования"
    },
    {
      "name": "heightCustom",
      "type": "number",
      "description": "Кастомная высота блока"
    },
    {
      "name": "image",
      "type": "ReactNode",
      "required": true,
      "description": "Слот для отрисовки картинки"
    },
    {
      "name": "imagePositionDesktop",
      "type": "ImagePositionDesktop",
      "values": [
        "right",
        "left"
      ],
      "default": "right",
      "description": "Положение картинки в десктопе - Right/Left"
    },
    {
      "name": "imagePositionMobile",
      "type": "ImagePositionMobile",
      "values": [
        "bottom",
        "top"
      ],
      "default": "bottom",
      "description": "Положение картинки в мобилке - Bottom/Top"
    },
    {
      "name": "listItems",
      "type": "ListItems",
      "description": "Пропы для отрисовки элементов List\nОбязательно для preset=\"list\""
    },
    {
      "name": "preset",
      "type": "\"list\" | \"text\" | \"steps\"",
      "values": [
        "list",
        "text",
        "steps"
      ],
      "description": "Выбор пресета Text/List/Steps"
    },
    {
      "name": "primaryButtonProps",
      "type": "BottomAddonButton",
      "description": "Пропсы для primary кнопки"
    },
    {
      "name": "secondaryButtonProps",
      "type": "BottomAddonButton",
      "description": "Пропсы для secondary кнопки"
    },
    {
      "name": "stepsItems",
      "type": "StepsItems",
      "description": "Пропы для отрисовки Steps\nОбязательно для preset=\"steps\""
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Подзаголовок для пресета Text"
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "Заголовок"
    },
    {
      "name": "withBackground",
      "type": "boolean",
      "default": "true",
      "description": "Переключатель BackgroundPlate"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
