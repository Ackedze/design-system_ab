      }
    },
    {
      "area": "api",
      "topic": "imageOverflow",
      "body": {
        "HeightCustom=False": "allowed outside BackgroundPlate when content is not overlapped and image stays inside root",
        "HeightCustom=True": "not allowed outside BackgroundPlate"
      }
    },
    {
      "area": "api",
      "topic": "lifecycle",
      "body": {
        "status": "active",
