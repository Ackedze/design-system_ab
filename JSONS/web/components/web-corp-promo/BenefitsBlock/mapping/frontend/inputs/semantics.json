        "plannedReplacement": false,
        "legacyVariants": false
      }
    },
    {
      "area": "api",
      "topic": "layoutOwnership",
      "body": {
        "owner": "BenefitsBlock",
        "manualChangesAllowed": false,
        "properties": [
          "gap",
