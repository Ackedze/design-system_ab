          "optional": true,
          "allowed": [
            "Primary only",
            "Secondary only",
            "Primary + Secondary"
          ]
        }
      }
    },
    {
      "area": "api",
      "topic": "responsivePolicy",
      "body": {
        "preserveAcrossPlatforms": [
          "content",
          "image",
          "action count",
          "action order"
        ],
        "imagePositionMayDiffer": true
      }
    },
    {
      "area": "api",
      "topic": "surfacePolicy",
      "body": {
        "Background=True": [
          "Primary",
          "Colored"
        ],
        "Background=False": "host shared surface"
      }
    },
    {
      "area": "api",
      "topic": "mobilePolicy",
      "body": {
        "heightCustomExposed": false,
        "heightSource": "content and mobile preset layout"
      }
    },
    {
      "area": "api",
      "topic": "titleViewPolicy",
      "body": {
        "rightAddonVisible": false,
        "titleAddonAllowedType": "StatusBadge"
      }
    },
    {
      "area": "api",
      "topic": "imagePolicy",
      "body": {
        "required": true,
        "Crop": "Center",
        "Segment": "match landing segment"
      }
    },
    {
      "area": "api",
      "topic": "surfaceOverrides",
      "body": {
        "Colored": "token-bound fill only",
        "Primary": "preserve baseline; no color override"
      }
    },
    {
      "area": "api",
      "topic": "loadingPolicy",
      "body": {
        "allowedWhenBackgroundFalse": true,
        "scope": "entire BenefitsBlock",
        "covers": [
          "Title",
          "ContentPresets",
          "Image",
          "ButtonGroup"
        ],
        "actionsBlocked": true
      }
    },
    {
      "area": "api",
      "topic": "sizing",
      "body": {
        "horizontal": "Fill",
        "vertical": "Hug",
        "heightCustomScope": "BackgroundPlate height only",
        "manualSizingOfOtherPartsAllowed": false
      }
    },
    {
      "area": "api",
      "topic": "collectionPolicy",
      "body": {
        "List": "item count is constrained by nested component",
        "Steps": {
          "countSource": "nested component",
