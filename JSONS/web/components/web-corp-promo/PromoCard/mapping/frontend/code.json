{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/promo-card",
  "version": "80.10.0",
  "component": "PromoCard",
  "exports": [
    "PromoCard",
    "PromoCardDesktop",
    "PromoCardMobile"
  ],
  "props": [
    {
      "name": "backgroundPlateProps",
      "type": "BackgroundPlateProps",
      "description": "Дополнительные пропы для BackgroundPlate"
    },
    {
      "name": "bottomAddon",
      "type": "ReactNode",
      "description": "Слот для дополнительного контента под основным контентом"
    },
    {
      "name": "buttonsDirection",
      "type": "\"row\" | \"column\"",
      "values": [
        "row",
        "column"
      ],
      "description": "Расположение кнопок в линию или в колонку"
    },
    {
      "name": "centred",
      "type": "boolean",
      "description": "Центрирование контента"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный ClassName"
    },
    {
      "name": "customHeight",
      "type": "string | number",
      "description": "Кастомная высота карточки"
    },
    {
      "name": "customWidth",
      "type": "string | number",
      "description": "Кастомная ширина карточки"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для автоматизированного тестирования"
    },
    {
      "name": "image",
      "type": "ReactNode",
      "description": "Слот для отрисовки картинки"
    },
    {
      "name": "imageAlign",
      "type": "\"normal\" | \"bottomRight\"",
      "values": [
        "normal",
        "bottomRight"
      ],
      "description": "Позиционирование картинки в bottom ориентации"
    },
    {
      "name": "imageCrop",
      "type": "boolean",
      "description": "Crop картинка"
    },
    {
      "name": "imageOffset",
      "type": "boolean",
      "description": "Смещение картинки (только для imageOrientation: top)"
    },
    {
      "name": "imageOrientation",
      "type": "\"bottom\" | \"top\"",
      "values": [
        "bottom",
        "top"
      ],
      "default": "bottom",
      "description": "Расположение картинки"
    },
    {
      "name": "primaryButtonProps",
      "type": "BottomAddonButton",
      "description": "Дополнительные пропсы для primary кнопки"
    },
    {
      "name": "rightSubtitleAddon",
      "type": "ReactNode",
      "description": "Правый слот у подзаголовка"
    },
    {
      "name": "rightTitleAddon",
      "type": "ReactNode",
      "description": "Правый слот у заголовка"
    },
    {
      "name": "secondaryButtonProps",
      "type": "BottomAddonButton",
      "description": "Дополнительные пропсы для secondary кнопки"
    },
    {
      "name": "size",
      "type": "\"small\" | \"medium\" | \"large\"",
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium",
      "description": "Слот для отрисовки картинки"
    },
    {
      "name": "spaced",
      "type": "boolean",
      "description": "Позволяет отдалить элементы друг от друга(для кастомных размеров)"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Подзаголовок для пресета Text"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Заголовок"
    },
    {
      "name": "titleView",
      "type": "\"primary\" | \"secondary\"",
      "values": [
        "primary",
        "secondary"
      ],
      "description": "Размеры для заголовка"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
