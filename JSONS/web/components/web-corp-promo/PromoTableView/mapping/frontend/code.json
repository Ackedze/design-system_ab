{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/promo-table-view",
  "version": "80.10.0",
  "component": "PromoTableView",
  "exports": [
    "PromoTableView",
    "PromoTableViewDesktop",
    "PromoTableViewMobile"
  ],
  "props": [
    {
      "name": "backgroundPlateBorder",
      "type": "boolean",
      "description": "Позволяет убрать или добавить обводку к компоненту BackgroundPlate"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный css класснейм"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "direction",
      "type": "\"row\" | \"column\"",
      "values": [
        "row",
        "column"
      ],
      "description": "Позволяет управлять расположением карточек в строчку или в колонку"
    },
    {
      "name": "emptyHeaderCellClassName",
      "type": "string",
      "description": "Дополнительный css класснейм для последней пустой ячейки"
    },
    {
      "name": "firstCells",
      "type": "FirstCell[]",
      "description": "Первые ячейки с пресетами"
    },
    {
      "name": "headerCells",
      "type": "HeaderCell[]",
      "required": true,
      "description": "Ячейки для шапки таблицы"
    },
    {
      "name": "lastCells",
      "type": "LastCell[]",
      "description": "Последние ячейки  с пресетами"
    },
    {
      "name": "orientation",
      "type": "\"horizontal\" | \"vertical\"",
      "values": [
        "horizontal",
        "vertical"
      ],
      "description": "Позволяет представить компонент в виде таблицы или карточек"
    },
    {
      "name": "rows",
      "type": "Row[]",
      "required": true,
      "description": "Строки"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
