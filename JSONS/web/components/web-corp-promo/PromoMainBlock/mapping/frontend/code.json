{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/promo-main-block",
  "version": "80.10.0",
  "component": "PromoMainBlock",
  "exports": [
    "PromoMainBlock"
  ],
  "props": [
    {
      "name": "appearance",
      "type": "\"dark\" | \"light\"",
      "values": [
        "dark",
        "light"
      ],
      "default": "light",
      "description": "Темный или светлый вид компонента"
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "description": "Кастомный цвет заднего фона"
    },
    {
      "name": "blurEffect",
      "type": "boolean",
      "default": "true",
      "description": "Добавляет blur снизу картинки только для десктопного вида"
    },
    {
      "name": "buttonsGroupLayout",
      "type": "\"horizontal\" | \"vertical\"",
      "values": [
        "horizontal",
        "vertical"
      ],
      "description": "Расположение кнопок по вертикали или горизонтали"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный css класс"
    },
    {
      "name": "compact",
      "type": "boolean",
      "description": "Компактный вид отображения"
    },
    {
      "name": "corporateFilterCompanySelectProps",
      "type": "CorporateFilterCompanySelectProps",
      "description": "Свойства компонента CorporateFilterCompanySelect"
    },
    {
      "name": "customAddon",
      "type": "ReactNode",
      "description": "Кастомный слот под текстовым блоком"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для автоматизированного тестирования"
    },
    {
      "name": "imageProps",
      "type": "Omit<DetailedHTMLProps<ImgHTMLAttributes<HTMLImageElement>, HTMLImageElement>, \"ref\">",
      "description": "Пропсы для картинки"
    },
    {
      "name": "primaryButtonProps",
      "type": "ButtonProps",
      "description": "Пропсы для primary кнопки"
    },
    {
      "name": "secondaryButtonProps",
      "type": "ButtonProps",
      "description": "Пропсы для secondary кнопки"
    },
    {
      "name": "statuses",
      "type": "StatusProps[]",
      "description": "Список статусов, отображаемых над заголовком"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Текст для подзаголовка"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Текст для заголовка"
    },
    {
      "name": "view",
      "type": "\"page\" | \"modal\"",
      "values": [
        "page",
        "modal"
      ],
      "description": "Вид отображения"
    },
    {
      "name": "withBackground",
      "type": "boolean",
      "default": "true",
      "description": "Использование BackgroundPlate"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
