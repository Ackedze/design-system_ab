{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/navigation-card-view",
  "version": "80.10.0",
  "component": "NavigationCardView",
  "exports": [
    "NavigationCardView"
  ],
  "props": [
    {
      "name": "benefits",
      "type": "string[]",
      "description": "Бенефиты (небольшие блоки с текстом), будут отрисованы в футере"
    },
    {
      "name": "buttons",
      "type": "ButtonProps[]",
      "description": "Кнопки для отрисовки в футере"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный className"
    },
    {
      "name": "customFooterContent",
      "type": "ReactNode",
      "description": "Кастомный контент в футере"
    },
    {
      "name": "customSubtitle",
      "type": "ReactNode",
      "description": "Кастомный подзаголовок (можно пробросить свой кастомный контент вместо дефолтного текста)"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для автоматизированного тестирования"
    },
    {
      "name": "desktopBackgroundPlateProps",
      "type": "BackgroundPlateProps",
      "description": "Пропсы для компонента BackgroundPlate в десктопной версии"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Выключенное состояние"
    },
    {
      "name": "footerClassName",
      "type": "string",
      "description": "Дополнительный className для обертки кастомногоного контента в футере"
    },
    {
      "name": "hasHover",
      "type": "boolean",
      "description": "Реагирует ли компонент при наведении"
    },
    {
      "name": "iconViewGroup",
      "type": "ReactElement<unknown, string | JSXElementConstructor<any>>[]",
      "description": "Группа IconView"
    },
    {
      "name": "loading",
      "type": "boolean",
      "description": "Состояние загрузки"
    },
    {
      "name": "mobileBackgroundPlateProps",
      "type": "BackgroundPlateProps",
      "description": "Пропсы для компонента BackgroundPlate в мобильной версии"
    },
    {
      "name": "onClick",
      "type": "() => void",
      "description": "Обработчик клика по карточке"
    },
    {
      "name": "rightAddon",
      "type": "ReactNode | ((imgClassName?: string) => ReactNode)",
      "description": "Слот для отрисовки справа"
    },
    {
      "name": "rightAddonPosition",
      "type": "\"center\" | \"bottom\"",
      "values": [
        "center",
        "bottom"
      ],
      "description": "Позиционирование слота справа"
    },
    {
      "name": "size",
      "type": "\"small\" | \"large\"",
      "values": [
        "small",
        "large"
      ],
      "default": "large",
      "description": "Размер карточки (только десктоп)"
    },
    {
      "name": "skeletonClassName",
      "type": "string",
      "description": "Дополнительный класс для скелетона"
    },
    {
      "name": "statusProps",
      "type": "StatusProps",
      "description": "Пропсы для компоненты Status из core-components,\nпри передаче будет отрисован с переданными пропсами"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Подзаголовок карточки"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Заголовок карточки"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
