{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/voc",
  "version": "80.10.0",
  "component": "VOC",
  "exports": [
    "VOC"
  ],
  "props": [
    {
      "name": "additionalRateBlockProps",
      "type": "AdditionalRateBlockProps",
      "description": "Дополнительный блок с рейтингом"
    },
    {
      "name": "breakpoint",
      "type": "number",
      "default": "1024",
      "description": "Контрольная точка, с нее начинается desktop версия"
    },
    {
      "name": "customAdditionalRateBlock",
      "type": "ReactNode",
      "description": "Кастомный блок с оценкой"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "data-test-id для модального окна"
    },
    {
      "name": "defaultMatchMediaValue",
      "type": "boolean | (() => boolean)",
      "default": "true",
      "description": "Значение по-умолчанию для хука useMatchMedia\n@deprecated Используйте client"
    },
    {
      "name": "onClose",
      "type": "(event: MouseEvent<HTMLElement, MouseEvent> | KeyboardEvent<HTMLElement>, reason?: \"backdropClick\" | \"escapeKeyDown\" | \"closerClick\") => void",
      "required": true,
      "description": "Обработчик закрытия"
    },
    {
      "name": "onStarRatingClick",
      "type": "(starIndex: number) => void",
      "required": true,
      "description": "Обработчик клика на рейтинг"
    },
    {
      "name": "onSubmitButtonClick",
      "type": "() => void",
      "description": "Обработчик клика на submit кнопку"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true,
      "description": "Управление видимостью модалки"
    },
    {
      "name": "rateHint",
      "type": "string",
      "default": "Поставьте оценку от 1 до 5, где 5 — очень довольны",
      "description": "Подсказка"
    },
    {
      "name": "shouldShowStatusScreen",
      "type": "boolean",
      "default": "true",
      "description": "Нужно ли рендерить StatusScreen при сабмите"
    },
    {
      "name": "statusScreenProps",
      "type": "StatusScreenProps",
      "description": "Пропсы для StatusScreen"
    },
    {
      "name": "subtitleLabel",
      "type": "string",
      "default": "Насколько вам понравился компонент?",
      "description": "Подзаголовок"
    },
    {
      "name": "titleLabel",
      "type": "string",
      "default": "Ваше мнение — это важно",
      "description": "Заголовок"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
