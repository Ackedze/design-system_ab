            "🔒 [M] AmountHeadline",
            "🔒 AmountParagraph",
            "AmountParagraph",
            "AmountStyles",
            "Operation"
          ]
        },
        "ruleText": "Изменения layer/style внутри этого семейства компонентов нужно сравнивать с effective baseline текущего component variant и nested owner context."
      }
