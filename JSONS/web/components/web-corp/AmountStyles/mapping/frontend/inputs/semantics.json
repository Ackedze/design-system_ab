{
  "$schema": "hub/facet.semantics@1",
  "summary": "AmountStyles предоставляет Figma-only presets AmountHeadline для крупных акцентных сумм и AmountParagraph для таблиц, списков, карточек и второстепенных значений. Operation является внутренней частью и не используется отдельно.",
  "guidance": [
    {
      "area": "usage",
      "topic": "availability",
      "body": {
        "figmaOnlyPresets": [
          "🔒 [D] AmountHeadline",
          "🔒 [M] AmountHeadline",
          "🔒 AmountParagraph"
        ],
        "codeExports": [],
        "internalOnly": [
          "Operation"
        ]
      }
    },
    {
      "area": "usage",
      "topic": "partDefaults",
      "body": {
        "Major": "required",
        "Minor": true,
        "Currency": true,
        "Operation": false,
        "Addon": false
      }
    },
    {
      "area": "usage",
      "topic": "contentPolicy",
      "body": {
        "editableTextLayers": [
          "Major",
          "Minor",
          "Currency"
        ],
        "requiredLayers": [
          "Major"
        ],
        "addonComponents": [
          "IconView",
          "StatusBadge"
        ],
        "addonMaxHeight": "Line-height текстовой части Amount.",
        "addonColorPolicy": "IconView и StatusBadge сохраняют собственные контекстные цвета и не обязаны совпадать с цветом текстовых частей Amount."
      }
    },
    {
      "area": "usage",
      "topic": "anatomyPolicy",
      "body": {
        "fixedOrder": "Operation → Major → Minor → Currency → Addon",
        "reorderAllowed": false
      }
    },
    {
      "area": "usage",
      "topic": "usagePolicy",
      "body": {
        "AmountInput": "Внутри AmountInput используется Web Core Amount; контракт Web Corp AmountStyles к нему не применяется."
      }
    },
    {
      "area": "usage",
      "topic": "currencyPolicy",
      "body": {
        "allowedTypes": "Любой штатный Type.",
        "customPurpose": "Type=Custom используется для отсутствующего в штатных Type кода валюты или символа."
      }
    },
    {
      "area": "usage",
      "topic": "responsivePolicy",
      "body": {
        "desktopHeadline": "🔒 [D] AmountHeadline используется только на desktop.",
        "mobileWebHeadline": "🔒 [M] AmountHeadline используется только на mobile-web.",
        "paragraph": "🔒 AmountParagraph применяется на desktop и mobile-web."
      }
    },
    {
      "area": "usage",
      "topic": "valueFormatPolicy",
      "body": {
        "locale": "ru-RU",
        "minorDigits": "Один или два знака.",
        "moreThanTwoMinorDigits": "Округлить до двух знаков.",
        "majorMaxCharacters": "13 без учёта математических пробелов между разрядами.",
        "zero": "0 или 0,00.",
        "unknown": "Не используй Amount; выведи отдельным текстовым элементом длинное тире —.",
        "negativeParentheses": false
      }
    },
    {
      "area": "usage",
      "topic": "valueDomainPolicy",
      "body": {
        "allowed": "Денежные суммы и балансы.",
        "points": "Поддерживаются компонентом, но требуют отдельного паттерна.",
        "excluded": "Проценты и произвольные числовые величины с единицами."
      }
    },
    {
      "area": "usage",
      "topic": "publicComponentProperties",
      "body": {
        "AmountParagraph.variant.Style": [
          "Paragraph 14/20",
          "Action 14/20",
          "Accent 14/20",
          "Action 16/24",
          "Action 16/20",
          "Paragraph 16/24",
          "Paragraph 16/20",
          "Accent 16/24",
