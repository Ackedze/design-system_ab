      "area": "api",
      "topic": "responsivePolicy",
      "body": {
        "desktop": {
          "channel": "desktop",
          "headlinePreset": "🔒 [D] AmountHeadline"
        },
        "mobileWeb": {
          "channel": "mobile-web",
          "headlinePreset": "🔒 [M] AmountHeadline"
        },
        "paragraphPreset": "🔒 AmountParagraph",
        "paragraphChannels": [
          "desktop",
          "mobile-web"
        ]
      }
