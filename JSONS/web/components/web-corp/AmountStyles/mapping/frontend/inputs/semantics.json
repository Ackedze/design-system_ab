    {
      "area": "api",
      "topic": "statePolicy",
      "body": {
        "ownStates": [],
        "skeleton": "future-pattern"
      }
    },
    {
      "area": "api",
      "topic": "interactionPolicy",
      "body": {
        "clickable": true,
        "dependsOnContext": true,
        "interactiveAddonAllowed": true,
        "addonActionMustMatchAmount": true,
        "manualUnderlineAllowed": false,
        "manualBackgroundAllowed": false,
        "hoverState": "future-rule"
      }
    },
    {
      "area": "api",
      "topic": "optionalPartsPolicy",
      "body": {
        "canCoexist": true
      }
    },
    {
      "area": "api",
      "topic": "valueFormatPolicy",
      "body": {
        "locale": "ru-RU",
        "decimalSeparator": ",",
        "groupSeparator": "mathematical-space",
        "negativeSign": "mathematical-minus",
        "parenthesesForNegative": false,
        "minorDigits": [
          1,
          2
        ],
        "moreThanTwoMinorDigits": "round-to-two",
        "majorMaxCharactersExcludingGroupSeparators": 13,
        "zeroFormats": [
          "0",
          "0,00"
        ],
        "unknownValue": {
          "useAmount": false,
          "replacement": "—",
          "replacementType": "separate-text-element"
        }
      }
    },
    {
      "area": "api",
      "topic": "valueDomainPolicy",
      "body": {
        "allowed": [
          "money",
          "balance"
        ],
        "points": "separate-pattern",
        "percentagesAllowed": false,
        "arbitraryUnitsAllowed": false
      }
    },
    {
      "area": "api",
      "topic": "currencyPolicy",
      "body": {
        "allowedTypes": "all-component-types",
        "customPurpose": "Код валюты или символ, отсутствующий среди штатных Type."
      }
    },
    {
      "area": "api",
      "topic": "contextPolicies",
      "body": {
        "table": {
          "alignment": "right",
          "primaryWeight": "Medium",
          "secondaryWeight": "Regular",
          "hideCurrencyWhenDeclaredInHeader": true,
          "currencyRuleSeverity": "error"
        },
        "TableBulkActions": {
          "operationVisible": false,
          "positiveColorAllowed": false
        },
        "steps": {
          "recommendedWeight": "Regular",
          "ruleSeverity": "warning"
        },
        "sidePanel": {
          "format": "match-source-page",
          "required": true
        }
      }
    },
