          "Headline 30/36",
          "Headline 40/48",
          "Headline 48/52",
          "Headline 16/20",
          "Headline 20/28",
          "Headline 26/32",
          "Headline 34/40"
        ],
        "Operation.variant.Negative": [
          "True",
          "False"
        ]
      }
    },
    {
      "area": "usage",
      "topic": "semanticOwnership",
      "body": [
        {
          "leafLayer": "Minus",
          "semanticOwner": "AmountParagraph / Operation",
          "meaning": "operation sign"
        },
        {
          "leafLayer": "Major",
          "semanticOwner": "AmountParagraph / Amount",
          "meaning": "major amount part"
        },
        {
          "leafLayer": "Minor",
          "semanticOwner": "AmountParagraph / Amount",
          "meaning": "minor amount part"
        },
        {
          "leafLayer": "Currency",
          "semanticOwner": "AmountParagraph / Amount",
          "meaning": "currency part"
        }
      ]
    },
