{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/widget-plate",
  "version": "80.10.0",
  "component": "WidgetPlate",
  "description": "Компонент виджет-плейт",
  "exports": [
    "WidgetPlate"
  ],
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Содержимое виджета"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "containerClassName",
      "type": "string",
      "description": "Дополнительный класс на обертку"
    },
    {
      "name": "contentClassName",
      "type": "string",
      "description": "Дополнительный класс на контейнера для контента"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для автотестов"
    },
    {
      "name": "footer",
      "type": "ReactNode",
      "description": "Футер"
    },
    {
      "name": "rightAddon",
      "type": "ReactNode",
      "description": "Аддон справа"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "description": "Показать скелетон"
    },
    {
      "name": "skeletonProps",
      "type": "SkeletonProps",
      "description": "Пропы для скелетона"
    },
    {
      "name": "title",
      "type": "ReactNode",
      "required": true,
      "description": "Заголовок виджета"
    },
    {
      "name": "titleAddon",
      "type": "ReactNode",
      "description": "Аддон для заголовка"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
