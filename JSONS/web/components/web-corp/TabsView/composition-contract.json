{
  "schemaVersion": 1,
  "documentType": "composition-contract",
  "componentKey": "web-corp.tabs-view",
  "status": "ready",
  "applicability": {
    "channels": [
      "b2b"
    ],
    "platforms": [
      "desktop",
      "mobile-web"
    ],
    "source": "path-policy",
    "updatedAt": "2026-07-15"
  },
  "component": {
    "name": "TabsView",
    "library": "Web _ Corp Components"
  },
  "wraps": [
    {
      "path": "TabsPrimary",
      "componentName": "TabsPrimary",
      "library": "Web _ Core",
      "role": "internal-instance"
    },
    {
      "path": "[D] TabsSecondary",
      "componentName": "[D] TabsSecondary",
      "library": "Web _ Corp Components",
      "role": "internal-instance"
    },
    {
      "path": "[M] TabsSecondary",
      "componentName": "[M] TabsSecondary",
      "library": "Web _ Corp Components",
      "role": "internal-instance"
    },
    {
      "path": "TabPrimary",
      "componentName": "TabPrimary",
      "library": "Web _ Core",
      "role": "repeated-internal-instance"
    },
    {
      "path": "[D] Tag / [M] Tag",
      "componentName": "Tag",
      "library": "Web _ Core / Web _ Corp Components",
      "role": "repeated-internal-instance"
    }
  ],
  "ownershipModel": {
    "defaultNestedDiffPolicy": "compare-against-tabs-view-effective-baseline",
    "wrapperOwnedOverridePolicy": "Не показывай изменения, заданные обёрткой, как кастомизации, когда фактическое значение совпадает с effective baseline TabsView. Если значение отличается, показывай effective baseline → фактическое значение."
  },
  "compositionPolicy": {
    "primaryRequired": true,
    "secondaryRequired": false,
    "minimumVisiblePrimaryTabs": 2,
    "minimumVisibleSecondaryTabsWhenShown": 2,
    "maximumVisibleTabs": "not-regulated",
    "activePrimaryCount": 1,
    "activeSecondaryCountWhenShown": 1,
    "labelLines": 1,
    "labelMaximumCharacters": 10,
    "labelOverflowBehavior": "increase-tab-width",
    "duplicateLabelsWithinLevelAllowed": false,
    "primaryAddonAllowed": true,
    "primaryAddonSwapAllowed": true,
    "primaryAddonAllowedTypes": [
      "icon",
      "counter",
      "status"
    ],
    "individualDisabledStateAllowed": true,
    "activeTabCanBeDisabled": false,
    "disabledTabsCountTowardMinimumVisible": true,
    "minimumEnabledActiveTabsPerVisibleLevel": 1,
    "rootSkeletonScope": "whole TabsView",
    "rootSkeletonPresentation": "single common skeleton",
    "individualTabReloadAllowed": true,
    "individualReloadAllowedFor": "all tabs",
    "activeTabRemainsActiveWhileReloading": true,
    "navigationAvailableWhileTabReloading": true,
    "designerCanAddHideAndReorderTabs": true,
    "secondarySetDependsOnSelectedPrimary": true,
    "secondaryMayBeAbsentForSelectedPrimary": true,
    "onPrimarySelection": "activate-first-enabled-secondary",
    "restorePreviousSecondarySelection": false,
    "activeTabRepeatedClick": "no-op",
    "maximumTabLevels": 2,
    "thirdLevelAllowed": false,
    "contentBindingWhenSecondaryExists": "active Secondary",
    "directPrimaryContentWhenSecondaryExists": false,
    "unavailableTabBehavior": "disabled-not-hidden",
    "onActiveTabBecomesUnavailable": "activate-first-enabled-tab",
    "navigationModes": [
      "switch-content-in-current-page",
      "navigate-to-page-or-url"
    ],
    "secondaryFixedProperties": {
      "Size": "40",
      "View": "Filled",
      "Shape": "Rounded",
      "SingleIcon": "False"
    },
    "secondaryEditableProperties": [
      "Indicator"
    ],
    "secondaryIndicatorValues": [
      "Hidden",
      "Collapsed",
      "Digit"
    ],
    "secondaryIndicatorSemantics": {
      "Collapsed": "dot",
      "Digit": "numeric counter, maximum 99+"
    },
    "primaryAddonVisibility": "active-enabled-primary-only",
    "primaryToSecondarySpacing": 24,
    "lastVisibleTabLevelToContentSpacing": 24,
    "desktopMobileWebParity": [
      "labels",
      "order",
      "tabCount"
    ],
    "manualVisualOverridesAllowed": false,
    "desktopOverflow": "automatic Slider only",
    "mobileWebOverflow": "horizontal swipe; Slider forbidden"
  },
  "allowedOverrides": [
    {
      "targetPathPattern": "TabsPrimary",
      "property": "layout.itemSpacing",
      "expectedOverride": 32,
      "scope": "layout",
      "reason": "TabsView управляет spacing между primary tabs и skeleton tabs."
    },
    {
      "targetPathPattern": "TabsPrimary / Items",
      "property": "layout.itemSpacing",
      "expectedOverride": 32,
      "scope": "layout",
      "reason": "TabsView управляет spacing между primary tab items."
    },
    {
      "targetPathPattern": "TabsPrimary / Items / TabPrimary",
      "property": "layout.itemSpacing",
      "expectedOverride": 16,
      "scope": "layout",
      "reason": "TabsView управляет spacing внутри каждого primary tab item."
    },
    {
      "targetPathPattern": "TabsPrimary / Items / TabPrimary / Content / Label",
      "property": "styles.text",
      "expectedOverride": "Action/18–24 Primary Large",
      "scope": "text-style",
      "reason": "TabsView применяет action typography к nested primary tab labels."
    },
    {
      "targetPathPattern": "[D] TabsSecondary / Items",
      "property": "layout.itemSpacing",
      "expectedOverride": 8,
      "scope": "layout",
      "reason": "TabsView управляет secondary tag spacing."
    },
    {
      "targetPathPattern": "[M] TabsSecondary",
      "property": "layout.itemSpacing",
      "expectedOverride": 8,
      "scope": "layout",
      "reason": "TabsView управляет mobile secondary tag spacing."
    }
  ],
  "suppressedWhenEqualToEffectiveBaseline": [
    "TabsPrimary.layout.itemSpacing",
    "TabsPrimary/Items.layout.itemSpacing",
    "TabsPrimary/Items/TabPrimary.layout.itemSpacing",
    "TabsPrimary/Items/TabPrimary/Content/Label.styles.text",
    "TabsSecondary.layout.itemSpacing"
  ]
}
