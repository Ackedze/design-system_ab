    {
      "area": "usage",
      "topic": "compositionModel",
      "body": {
        "ownsNestedOverrides": true,
        "effectiveBaselineRequired": true,
        "wrappedComponents": [
          "TabsPrimary",
          "[D] TabsSecondary",
          "[M] TabsSecondary",
          "TabPrimary",
          "Tag"
        ],
        "suppressWhenEqualToEffectiveBaseline": [
          "TabsPrimary.layout.itemSpacing",
          "TabsPrimary/Items.layout.itemSpacing",
          "TabsPrimary/Items/TabPrimary.layout.itemSpacing",
          "TabsPrimary/Items/TabPrimary/Content/Label.styles.text",
          "TabsSecondary.layout.itemSpacing"
        ]
      }
    },
    {
      "area": "usage",
      "topic": "componentPolicy",
      "body": {
        "primaryRequired": true,
        "secondaryRequired": false,
        "minimumVisibleTabs": {
          "primary": 2,
          "secondaryWhenVisible": 2
        },
        "maximumVisibleTabs": "Пока не регламентировано.",
        "activeState": "Одновременно активен только один Primary и, если второй уровень показан, только один Secondary. Disabled-табы учитываются в минимуме видимых, но на каждом уровне должен оставаться хотя бы один доступный активный таб.",
        "labels": "Текст можно менять. Label остаётся в одну строку, содержит до 10 символов и не дублирует соседние табы одного уровня. При необходимости увеличивается ширина таба.",
        "primaryAddon": "Можно включать и заменять через instance swap. Допустимы иконки, счётчики и статусы, но только у активного и доступного Primary.",
        "disabledState": "Отдельные табы можно отключать.",
        "loading": "TabsView.Skeleton=true показывает один общий skeleton. Любой таб может перезагружаться отдельно; активный остаётся выбранным, а переключение на другие табы доступно.",
        "tabCollection": "Дизайнер может добавлять, скрывать и менять порядок Primary и Secondary, сохраняя минимум два видимых таба на каждом показанном уровне.",
        "secondaryContext": "У каждого Primary может быть собственный набор Secondary. Для отдельных Primary второй уровень может отсутствовать. При выборе Primary активируется первый доступный Secondary; предыдущий выбор не восстанавливается.",
        "secondaryProperties": "Size=40, View=Filled, Shape=Rounded и SingleIcon=False обязательны. Indicator=Collapsed показывает точку, Indicator=Digit — числовой счётчик до 99+, Hidden скрывает индикатор.",
        "visualBaseline": "Ручные изменения отступов, паддингов, divider, типографики, заливок, обводок, скруглений и opacity запрещены.",
        "overflow": "На desktop Slider появляется автоматически только при переполнении; вручную включать его нельзя. На mobile-web Slider запрещён, используется горизонтальный свайп.",
        "spacing": "Между Primary и Secondary — 24 px. Между последним видимым уровнем табов и контентом — 24 px. Менять эти отступы вручную нельзя.",
        "adaptiveParity": "Desktop и mobile-web версии должны иметь одинаковые названия, порядок и количество табов.",
        "interaction": "Повторное нажатие на уже активный таб ничего не делает. Таб может переключать контент текущей страницы или вести на другую страницу/URL.",
        "contentBinding": "Допустимы только два уровня: Primary и Secondary. Если Secondary показан, контент принадлежит активному Secondary; прямого контента Primary в этом состоянии нет.",
        "availability": "Недоступные из-за прав, сегмента или данных табы не скрываются, а переводятся в Disabled. Если активный таб становится недоступным, активируется первый доступный таб уровня."
      }
    },
