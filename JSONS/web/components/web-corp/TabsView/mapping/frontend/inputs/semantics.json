{
  "$schema": "hub/facet.semantics@1",
  "summary": "TabsView — wrapper/composite component вокруг primary и secondary tabs. Apollo должен использовать TabsView effective baseline для nested TabsPrimary/TabsSecondary differences и подавлять wrapper-owned overrides, когда actual совпадает с effective baseline.",
  "includes": [
    "[D] TabsView",
    "[M] TabsView"
  ],
  "components": [
    {
      "figmaName": "[D] TabsView",
      "figmaKey": "44f1398a704dba217a9da9694913ec61b5bb15bf",
      "purpose": "Desktop-композиция вкладок для переключения разделов или представлений с обязательным Primary и опциональным Secondary уровнем.",
      "useWhen": [
        "На desktop нужно переключать связанный контент между двумя и более равноправными разделами."
      ],
      "doNotUseWhen": [
        "Нужна основная навигация приложения или больше двух уровней вложенности."
      ],
      "relationship": "Публичный desktop-wrapper над TabsPrimary и TabsSecondary; управляет overflow и effective baseline вложенных табов.",
      "status": "approved"
    },
    {
      "figmaName": "[M] TabsView",
      "figmaKey": "7e5a6fc084855cf77309a75abe8da46f09893aa0",
      "purpose": "Mobile-web композиция вкладок для переключения разделов или представлений с обязательным Primary и опциональным Secondary уровнем.",
      "useWhen": [
        "В mobile-web нужно переключать связанный контент между двумя и более равноправными разделами."
      ],
      "doNotUseWhen": [
        "Нужна основная навигация приложения или больше двух уровней вложенности."
      ],
      "relationship": "Публичный mobile-web wrapper над TabsPrimary и TabsSecondary; переполнение обрабатывается горизонтальным свайпом.",
      "status": "approved"
    }
  ],
  "publicApi": {
    "variantProperties": {
      "Skeleton": {
        "kind": "component-property",
        "values": [
          "false",
