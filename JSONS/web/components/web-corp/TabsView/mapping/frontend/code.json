{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/tabs-view",
  "version": "80.10.0",
  "component": "TabsView",
  "exports": [
    "TabsView"
  ],
  "props": [
    {
      "name": "activePrimaryTab",
      "type": "SelectedId",
      "description": "Позволяет управлять активным главным табом"
    },
    {
      "name": "additionalMainTabsWrapperProps",
      "type": "TabsWrapperProps",
      "description": "Дополнительные пропсы для компонента обертки главных табов"
    },
    {
      "name": "additionalSecondaryTabsWrapperProps",
      "type": "TabsWrapperProps",
      "description": "Дополнительные пропсы для компонента обертки второстепенных табов"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "onMainTabChange",
      "type": "(event: MouseEvent<Element, MouseEvent>, payload: HandleChangeTabPayload) => void",
      "description": "Обработчик изменения активного главного таба"
    },
    {
      "name": "onSecondaryTabChange",
      "type": "(event: MouseEvent<Element, MouseEvent>, payload: HandleChangeTabPayload) => void",
      "description": "Обработчик изменения активного второстепенного таба"
    },
    {
      "name": "tabs",
      "type": "TabsState[]",
      "required": true,
      "description": "Массив табов для отображения"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
