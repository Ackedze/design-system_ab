{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/card-swiper-mobile",
  "version": "80.10.0",
  "component": "CardSwiperMobile",
  "exports": [
    "CardSwiperMobile"
  ],
  "props": [
    {
      "name": "cards",
      "type": "CardImageProps[]",
      "default": "[]",
      "description": "Массив карт для отображения в свайпере"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "customSlide",
      "type": "FC<{ card: CardImageProps; }>",
      "default": "null",
      "description": "Кастомный слайд"
    },
    {
      "name": "customSlideAdditionalProps",
      "type": "object",
      "default": "{}",
      "description": "Дополнительные пропсы для кастомного слайда"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "initialSlideIndex",
      "type": "number",
      "default": "0",
      "description": "Индекс начального слайда"
    },
    {
      "name": "onCardSelect",
      "type": "(card: CardImageProps) => void",
      "description": "Колбэк, вызываемый при выборе карты (клик)"
    },
    {
      "name": "onChange",
      "type": "(card: CardImageProps) => void",
      "description": "Колбэк, вызываемый при перелистывании карты (свайп)"
    },
    {
      "name": "swiperConfig",
      "type": "SwiperOptions",
      "default": "{}",
      "description": "Конфигурация для слайдера"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
