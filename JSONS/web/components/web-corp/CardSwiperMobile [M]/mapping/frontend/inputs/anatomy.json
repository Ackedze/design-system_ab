{
  "$schema": "hub/facet.anatomy@1",
  "uses": [
    {
      "entity": "helper.spacing-component",
      "figmaName": "↕ SpacingVertical",
      "roles": [
        "internal-instance"
      ],
      "inHosts": [
        "CardSwiperMobile"
      ],
      "occurrences": 2
    },
    {
      "entity": "corp.card-image",
      "figmaName": "CardImage",
      "roles": [
        "internal-instance"
      ],
      "inHosts": [
        "CardSwiperMobile"
      ],
      "occurrences": 3
    }
  ],
  "constraints": [
    {
      "id": "card-swiper-mobile.card-window",
      "select": {
        "figmaNames": [
          "CardImage"
        ],
        "visibility": "all"
      },
      "checks": [
        {
          "id": "card-count",
          "op": "countBetween",
          "min": 3,
          "max": 3,
          "message": "CardSwiperMobile сохраняет три штатные позиции CardImage: previous, current и next; крайние позиции скрываются root properties, но не удаляются из композиции"
        },
        {
          "id": "card-size-order",
          "op": "propertySequence",
          "property": "Size",
          "values": [
            "212x132",
            "264x164",
            "212x132"
          ],
          "message": "CardSwiperMobile использует CardImage Size=212x132 для previous/next и Size=264x164 для current"
        },
        {
          "id": "card-stack-order",
          "op": "propertySequence",
          "property": "Stack",
          "values": [
            "false",
            "false",
            "false"
          ],
          "message": "Все CardImage внутри CardSwiperMobile используют Stack=false"
        }
      ]
    },
    {
      "id": "card-swiper-mobile.vertical-spacing",
      "select": {
        "figmaNames": [
          "↕ SpacingVertical"
        ],
        "visibility": "all"
      },
      "checks": [
        {
          "id": "spacing-count",
          "op": "countBetween",
          "min": 2,
          "max": 2,
          "message": "CardSwiperMobile содержит верхний и нижний SpacingVertical"
        },
        {
          "id": "spacing-size-order",
          "op": "propertySequence",
          "property": "Size",
          "values": [
            "24",
            "32"
          ],
          "message": "CardSwiperMobile использует верхний spacing 24 px и нижний spacing 32 px для обоих Screen Size"
        }
      ]
    }
  ]
}
