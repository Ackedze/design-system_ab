{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/date-range-picker",
  "version": "80.10.0",
  "component": "DateRangePicker",
  "exports": [
    "DateRangePicker",
    "DateRangePickerDesktop",
    "DateRangePickerMobile",
    "getPeriodType",
    "rangeState"
  ],
  "props": [
    {
      "name": "allowFuture",
      "type": "boolean",
      "description": "Позволять ли выбирать даты в будущем"
    },
    {
      "name": "applyOnClose",
      "type": "boolean",
      "description": "Применять ли изменения при закрытии поповера"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "clearButtonLabel",
      "type": "string",
      "description": "Текст кнопки сброса (применяется при условии заданного `initialDate`)"
    },
    {
      "name": "controlComponentProps",
      "type": "FormControlProps",
      "description": "Пропсы для PeriodSlider"
    },
    {
      "name": "CustomControlComponent",
      "type": "FC<{ className?: string; rightAddons?: ReactElement<unknown, string | JSXElementConstructor<any>>; onClick?(): void; dataTestId?: string; } & Partial<FormControlProps>>",
      "description": "Возможность заменить PeriodSlider иным компонентом"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "dateFrom",
      "type": "number",
      "description": "Значение начала периода"
    },
    {
      "name": "dateTo",
      "type": "number",
      "description": "Значение конца периода"
    },
    {
      "name": "defaultMonth",
      "type": "number",
      "description": "Месяц в календаре по умолчанию"
    },
    {
      "name": "defaultMonthPosition",
      "type": "\"right\" | \"left\"",
      "values": [
        "right",
        "left"
      ],
      "description": "calendarPosition = static\nОтображать начальный месяц слева или справа (влияет только на начальный рендер)"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Состояние блокировки компонента"
    },
    {
      "name": "headerCustomSlot",
      "type": "ReactNode",
      "description": "Дополнительный слот в шапке компонента"
    },
    {
      "name": "initialDate",
      "type": "{ from: number; to: number; }",
      "description": "Предустановленные значения полей"
    },
    {
      "name": "isAdaptiveMobile",
      "type": "boolean",
      "description": "Мобильная версия - адаптив, а не mobileWeb"
    },
    {
      "name": "isBlockSubmitOnDateError",
      "type": "boolean",
      "description": "Блокировать кнопку submit при наличии ошибок в дате"
    },
    {
      "name": "maxDate",
      "type": "number",
      "description": "Максимальная дата, доступная для выбора (timestamp)"
    },
    {
      "name": "minDate",
      "type": "number",
      "description": "Минимальная дата, доступная для выбора (timestamp)"
    },
    {
      "name": "modalMobileProps",
      "type": "Omit<ModalMobileProps, \"open\">",
      "description": "Пропсы для мобильного Popover"
    },
    {
      "name": "offDays",
      "type": "(number | Date)[]",
      "description": "Список выходных"
    },
    {
      "name": "onArrowClick",
      "type": "(direction: \"next\" | \"prev\") => void",
      "description": "Позволяет вешать метрики на клик по стрелкам"
    },
    {
      "name": "onChange",
      "type": "(dateFrom: number, dateTo: number, periodType?: PeriodType) => void",
      "description": "Обработчик изменения"
    },
    {
      "name": "onDateFromChange",
      "type": "(payload: { date: number; value: string; }) => void",
      "description": "Обработчик изменения даты от"
    },
    {
      "name": "onDateToChange",
      "type": "(payload: { date: number; value: string; }) => void",
      "description": "Обработчик изменения даты до"
    },
    {
      "name": "onOutsideClick",
      "type": "(isOutsideClick: boolean) => void",
      "description": "Обработчик клика при открытом popover"
    },
    {
      "name": "onRangeShortcutChange",
      "type": "(shortcut: RangeShortcut) => void",
      "description": "Обработчик клика по shortcut"
    },
    {
      "name": "popoverProps",
      "type": "Omit<PopoverProps, \"open\" | \"anchorElement\">",
      "description": "Пропсы для Popover"
    },
    {
      "name": "rangeShortcuts",
      "type": "RangeShortcut[]",
      "description": "Набор алиасов"
    },
    {
      "name": "rangeShortcutsTagProps",
      "type": "TagDesktopProps",
      "description": "Пропсы, которые будут прокинуты в ярлыки периодов"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "description": "Показать скелетон"
    },
    {
      "name": "skeletonProps",
      "type": "SkeletonProps",
      "description": "Пропы для скелетона"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
