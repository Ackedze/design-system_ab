        "allowedComposition": {
          "multipleActions": true,
          "placement": "RightAddon in corresponding data columns"
        },
        "ruleText": "Если в строке несколько колонок данных, в ней может быть несколько действий — через RightAddon соответствующих колонок."
      },
      {
        "ruleId": "component:web-corp.table-view.vertical-has-one-data-column",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.composition",
        "checkType": "llm",
        "matchKind": "exact_component_rule",
        "conditions": {
          "component": "TableView :: Vertical"
        },
        "requiredComposition": {
          "dataColumns": 1
        },
        "ruleText": "TableView :: Vertical всегда содержит одну колонку данных.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 1
        }
      },
      {
        "ruleId": "component:web-corp.table-view.horizontal-sidepanel-is-single-column-compact",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.composition|layout.itemSpacing",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "conditions": {
          "component": "[D] TableView :: Horizontal SidePanel"
        },
        "requiredComposition": {
          "dataColumns": 1,
          "compact": true,
          "rowSpacing": 12
        },
        "ruleText": "[D] TableView :: Horizontal SidePanel использует одну колонку данных и компактные отступы Row 12 px.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 1
        }
      },
      {
        "ruleId": "component:web-corp.table-view.horizontal-multi-column-header-required",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.composition",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "conditions": {
          "component": "[D] TableView :: Horizontal",
          "compact": false
        },
        "requiredComposition": {
          "rowPresetHeader": true
        },
        "ruleText": "В Horizontal TableView с Compact=False обязательна строка Row с Presets=Header.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 2
        },
        "predicateContour": {
          "schemaVersion": "apollo.contour-definition.v1",
          "kind": "fact-domain",
          "select": {
            "from": "selection-root",
            "traverse": "self-and-descendants",
            "where": [
              {
                "predicate": "equals",
                "actual": {
                  "fact": "type"
                },
                "expected": {
                  "literal": "INSTANCE"
                }
              },
              {
                "predicate": "equals",
                "actual": {
                  "fact": "component.identity"
                },
                "expected": {
                  "literal": "web-corp.table-view"
                }
              },
              {
                "predicate": "equals",
                "actual": {
                  "fact": "component.family"
                },
                "expected": {
                  "literal": "table-view-horizontal"
                }
              },
              {
                "predicate": "equals",
                "actual": {
                  "fact": "component.properties.Compact"
                },
                "expected": {
                  "literal": "False"
                }
              }
            ]
          },
          "actual": {
            "fact": "composition.visibleHeaderRowCount"
          },
          "allowedValues": [
            1
          ],
          "scope": {
            "platform": [
              "desktop",
              "mobile-web"
            ]
          },
          "unknownPolicy": "not-evaluable",
          "presentation": {
            "schemaVersion": "apollo.predicate-presentation.v1",
            "title": "В Horizontal TableView отсутствует обязательный Header Row",
            "observed": "При Compact=False найдено строк Header: {{actual}}.",
            "expectation": "Horizontal TableView с Compact=False должен содержать ровно один Row с Presets=Header.",
            "action": "Добавить или восстановить один Header Row в составе TableView."
          }
        }
      },
      {
        "ruleId": "component:web-corp.table-view.show-more-allowed-in-all-public-roots",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "component.composition",
