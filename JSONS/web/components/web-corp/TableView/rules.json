          "Icon20": "контекстное действие"
        },
        "ruleText": "Выбирай Type у RightAddon по действию: Info — пояснение, Copy — копирование значения, Edit — запуск редактирования, Icon20 — контекстное действие."
      },
      {
        "ruleId": "component:web-corp.table-view.additional-header-is-optional",
        "severity": "info",
        "source": "component-contract",
