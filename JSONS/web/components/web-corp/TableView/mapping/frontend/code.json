{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/table-view",
  "version": "80.10.0",
  "component": "TableView",
  "exports": [
    "TableView"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Уникальный идентификатор для систем автоматического тестирования"
    },
    {
      "name": "direction",
      "type": "Direction",
      "values": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal",
      "description": "Направление"
    },
    {
      "name": "hasDividerInLastRows",
      "type": "boolean",
      "default": "false",
      "description": "Добавляет разделительную полосу для последней строчки, работает только с view = 'common'"
    },
    {
      "name": "headerCells",
      "type": "Pick<TableViewCell, \"id\" | \"titleAddon\" | \"titleContent\">[]",
      "default": "[]",
      "description": "Ячейки для header"
    },
    {
      "name": "headerRowClassName",
      "type": "string",
      "description": "Дополнительный класс header-строки"
    },
    {
      "name": "headerRowContentClassName",
      "type": "string",
      "description": "Дополнительнный класс контента header-строки"
    },
    {
      "name": "isFirstColumnCaption",
      "type": "boolean",
      "default": "false",
      "description": "Флаг, который помечает первый столбец как заголовок"
    },
    {
      "name": "lastColumnAlign",
      "type": "\"right\" | \"left\"",
      "values": [
        "right",
        "left"
      ],
      "default": "left",
      "description": "Выравнивание последней колонки"
    },
    {
      "name": "rows",
      "type": "TableViewRow[]",
      "default": "[]",
      "description": "Строки"
    },
    {
      "name": "view",
      "type": "View",
      "values": [
        "compact",
        "common"
      ],
      "default": "common",
      "description": "Варианты отображения"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
