{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/filter-bar",
  "version": "80.10.0",
  "component": "FilterBar",
  "exports": [
    "FilterBar",
    "FilterBarDesktop",
    "FilterBarDesktopWithMetric",
    "FilterBarMobile",
    "FilterBarWithMetric"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный className"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "filterBarMobileFilterChecked",
      "type": "boolean",
      "description": "Позволяет отобразить выбранное состояние у тега MobileFilter"
    },
    {
      "name": "filterBarMobileFilterLoading",
      "type": "boolean",
      "description": "Позволяет отобразить состояние загрузки у тега MobileFilter"
    },
    {
      "name": "filters",
      "type": "FilterBarFilterConfig[]",
      "required": true,
      "description": "Набор фильтров"
    },
    {
      "name": "filtersOrder",
      "type": "string[]",
      "description": "Порядок фильтров, стоит использовать только если нужно передать измененные фильтры, например для сохранения состояния между сессиями"
    },
    {
      "name": "filtersState",
      "type": "Record<string, FilterBarFiltersValue>",
      "required": true,
      "description": "Состояние отображения фильтров"
    },
    {
      "name": "loading",
      "type": "boolean",
      "description": "Отображение загрузки"
    },
    {
      "name": "loadingConfig",
      "type": "Record<string, boolean>",
      "description": "Позволяет точечно показать статус загрузки для каждого отдельного фильтра"
    },
    {
      "name": "modalMobileContent",
      "type": "ReactNode",
      "description": "Контент отображаемый в модалке которая открывается по клику MobileFilter"
    },
    {
      "name": "onFilterChange",
      "type": "(id: string, value: FilterBarFiltersValue) => void",
      "required": true,
      "description": "Обработчик для измененения состояния выбора фильтров"
    },
    {
      "name": "onFiltersOrderChange",
      "type": "(payload: string | string[]) => void",
      "description": "Позволяет управлять состоянием порядком фильтров извне"
    },
    {
      "name": "onMobileApply",
      "type": "() => void",
      "description": "Обработчик на кнопку \"Применить\" в модалке"
    },
    {
      "name": "onResetAll",
      "type": "() => void",
      "description": "Обработчик для сброса состояния фильтров"
    },
    {
      "name": "onSearchChange",
      "type": "(value: string) => void",
      "description": "Обработчик изменения состояния поиска"
    },
    {
      "name": "onVisibleFiltersChange",
      "type": "(payload: string, value: boolean) => void",
      "description": "Позволяет управлять состоянием видимых фильтров извне"
    },
    {
      "name": "search",
      "type": "string",
      "description": "Состояние поиска"
    },
    {
      "name": "searchProps",
      "type": "Omit<FilterBarSearchProps, \"value\" | \"onChange\">",
      "description": "Пропсы для поиска"
    },
    {
      "name": "showConfigure",
      "type": "boolean",
      "description": "Показывать кнопку «Настройки фильтров». По умолчанию `true`."
    },
    {
      "name": "showResetAll",
      "type": "boolean",
      "description": "Показывать кнопку сброса выбранных фильтров"
    },
    {
      "name": "view",
      "type": "\"filled\" | \"muted\"",
      "values": [
        "filled",
        "muted"
      ],
      "description": "Оформление контролов под разный фон"
    },
    {
      "name": "visibleFilters",
      "type": "string[]",
      "description": "Видимые фильтров, стоит использовать только если нужно передать видимые фильтры, например для сохранения состояния между сессиями"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
