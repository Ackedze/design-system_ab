{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/chat",
  "version": "80.10.0",
  "component": "Chat",
  "exports": [
    "Chat"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный className"
    },
    {
      "name": "data",
      "type": "Message[]",
      "required": true,
      "description": "Массив сообщений"
    },
    {
      "name": "onRetry",
      "type": "(message: Message) => void",
      "description": "Обработчик повторной отправки сообщения при ошибке"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
