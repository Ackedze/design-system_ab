    {
      "area": "api",
      "topic": "purpose",
      "body": "Мобильный контрол ввода суммы для платёжных и переводных сценариев. Закрепляется у нижнего края viewport и при фокусе располагается непосредственно над системной цифровой клавиатурой."
    },
    {
      "area": "api",
      "topic": "platforms",
      "body": [
        "mobile-web"
      ]
    },
    {
      "area": "api",
      "topic": "layout",
      "body": {
        "position": "fixed-bottom",
        "scrollsWithContent": false,
        "width": "fill-viewport",
        "focusedKeyboardRelation": "directly-above-system-numeric-keyboard"
      }
    },
    {
      "area": "api",
      "topic": "requiredParts",
      "body": [
        "[M] Amount",
        "[M] Hint"
      ]
    },
    {
      "area": "api",
      "topic": "stateMachine",
      "body": {
        "transitions": [
          {
            "event": "focus-empty",
            "to": "Active"
          },
          {
            "event": "focus-filled",
            "to": "ActiveFilled"
          },
          {
            "event": "blur-filled",
            "to": "Filled"
          },
          {
            "event": "disable-empty",
            "to": "DisabledEmpty"
          },
          {
            "event": "disable-filled",
            "to": "DisabledFilled"
          },
          {
            "event": "invalid-filled",
            "to": "ErrorFilled"
          },
          {
            "event": "correct-invalid-value-while-focused",
            "to": "ActiveFilled"
          }
        ],
        "errorFilled": {
          "keepsFocus": true,
          "keepsKeyboardOpen": true
        }
      }
    },
    {
      "area": "api",
      "topic": "amount",
      "body": {
