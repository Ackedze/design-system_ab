{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/corporate-topbar",
  "version": "80.10.0",
  "component": "CorporateTopbar",
  "exports": [
    "CorporateTopbar",
    "CorporateTopbarDesktop",
    "CorporateTopbarMobile"
  ],
  "props": [
    {
      "name": "additionalBulkActions",
      "type": "ReactNode",
      "description": "Дополнительные элементы в шапке таблицы в левой части"
    },
    {
      "name": "additionalComponent",
      "type": "ReactNode",
      "description": "Дополнительный компонент в тулбаре (левее настроек страницы)"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "count",
      "type": "number",
      "description": "Количество найденных элементов"
    },
    {
      "name": "countModeText",
      "type": "string",
      "description": "Текст панели отображения найденных элементов"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования\nИдентификатор для систем автоматического тестирования"
    },
    {
      "name": "groupingOptions",
      "type": "(OptionShape | GroupShape)[]",
      "description": "Опции для группировки"
    },
    {
      "name": "isBulkActions",
      "type": "boolean",
      "description": "Флаг для включения режима групповых действий"
    },
    {
      "name": "isCountMode",
      "type": "boolean",
      "description": "Флаг для включения панели отображения найденных элементов"
    },
    {
      "name": "isToolbarAdaptiveView",
      "type": "boolean",
      "description": "Флаг для включения адаптива отображения кнопки \"Настройки таблицы\" (на 1280px)"
    },
    {
      "name": "onboardings",
      "type": "ToolbarOnboardings & { settingsButton?: ReactNode; }",
      "description": "Онбординги"
    },
    {
      "name": "onClosePopover",
      "type": "() => void",
      "description": "Закрыть popover"
    },
    {
      "name": "onGroupingOptionsChange",
      "type": "(payload: BaseSelectChangePayload) => void",
      "description": "Обработчик для выбора опций группировки"
    },
    {
      "name": "onReset",
      "type": "() => void",
      "description": "Сбросить все настройки"
    },
    {
      "name": "onSelectAll",
      "type": "(event: MouseEvent<HTMLAnchorElement, MouseEvent>) => void",
      "description": "Обработчик выбора всех элементов"
    },
    {
      "name": "onSelectOptionsChange",
      "type": "(payload: BaseSelectChangePayload) => void",
      "description": "Обработчик выбора опций для элементов"
    },
    {
      "name": "onToolbarPopoverChange",
      "type": "(open?: boolean) => void",
      "description": "Обработчик открытия/закрытия Toolbar popover'а"
    },
    {
      "name": "popoverProps",
      "type": "Partial<TooltipResponsiveProps>",
      "description": "Дополнительные пропсы для выпадашки"
    },
    {
      "name": "selectedGroupingOption",
      "type": "string | OptionShape | (string | OptionShape)[]",
      "description": "Выбранная опция"
    },
    {
      "name": "selectLabelText",
      "type": "string",
      "description": "Текст кнопки выбора всех элементов"
    },
    {
      "name": "selectOptions",
      "type": "((OptionShape | GroupShape) & { icon?: ComponentType<SVGProps<SVGSVGElement>>; })[]",
      "description": "Опции для выбора элементов"
    },
    {
      "name": "shouldShowToolbar",
      "type": "boolean",
      "description": "Принудительная установка состояния тулбара (закрыто / открыто)"
    },
    {
      "name": "toolbar",
      "type": "boolean",
      "description": "Флаг для включения компонента настройки таблицы"
    },
    {
      "name": "toolbarBlocks",
      "type": "ToolbarBlockProps[]",
      "description": "Дополнительные опции"
    },
    {
      "name": "toolbarClassName",
      "type": "string",
      "description": "Дополнительный класс Toolbar"
    },
    {
      "name": "toolbarComponent",
      "type": "FC<ToolbarProps>",
      "description": "Компонент для настройки таблицы"
    },
    {
      "name": "withWideTable",
      "type": "boolean",
      "description": "Указывает что используется вместе с таблицой КИБ.\n(Нужно для правильного поведения шторки настроеек таблицы)"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
