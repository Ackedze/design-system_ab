{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/corporate-content",
  "version": "80.10.0",
  "component": "CorporateContent",
  "exports": [
    "CorporateContent"
  ],
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Дочерние элементы"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "disableVerticalInlinePaddings",
      "type": "boolean",
      "default": "false",
      "description": "Отключить инлайновые вертикальные паддинги"
    },
    {
      "name": "id",
      "type": "string",
      "description": "Уникальный идентификатор блока"
    },
    {
      "name": "tableMode",
      "type": "boolean",
      "description": "Флаг для обертки экспериментального режима таблицы\n@deprecated Пропс оставлен для обратной совместимости"
    },
    {
      "name": "theme",
      "type": "ThemeType",
      "values": [
        "alfa-on-color",
        "alfa-on-white",
        "grey"
      ],
      "description": "Тема компонента. `alfa-on-color` deprecated тема"
    },
    {
      "name": "verticalPaddings",
      "type": "Partial<Record<\"mobile\" | \"desktop\", VerticalPaddingsValue>>",
      "description": "Вертикальные отступы"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
