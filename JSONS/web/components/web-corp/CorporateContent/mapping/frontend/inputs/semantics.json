{
  "$schema": "hub/facet.semantics@1",
  "summary": "CorporateContent — обязательная контентная область продуктовой страницы. Используй [D] CorporateContent для desktop и [M] CorporateContent для mobile-web.",
  "components": [
    {
      "figmaName": "[D] CorporateContent",
      "figmaKey": "a8d13cb6e1ae67a7296709f669238f41971c7197",
      "purpose": "Основная desktop-контентная область корпоративной продуктовой страницы с системной сеткой, фоном и адаптивными отступами.",
      "useWhen": [
        "Собирается содержимое корпоративной страницы на ширине 768 px и выше."
      ],
      "doNotUseWhen": [
        "Нужен вложенный контейнер внутри другого CorporateContent."
      ],
      "relationship": "Единственный корневой контентный контейнер CorporatePage на desktop; принимает произвольную композицию в Body.",
      "status": "approved"
    },
    {
      "figmaName": "[M] CorporateContent",
      "figmaKey": "11ae074b596a6b3dfb6696f51531439723c0225b",
      "purpose": "Основная mobile-web контентная область корпоративной продуктовой страницы с системным фоном и мобильными отступами.",
      "useWhen": [
        "Собирается содержимое корпоративной страницы ниже 768 px."
      ],
      "doNotUseWhen": [
        "Макет использует desktop breakpoint 768 px или выше."
      ],
      "relationship": "Mobile-web версия корневого CorporateContent; принимает произвольную композицию в Body.",
      "status": "approved"
    },
    {
      "figmaName": "[D] Section",
      "figmaKey": "2bbced82d96c1347fea71a3922cd11cf4c25ad6a",
      "purpose": "Вспомогательная горизонтальная композиция для размещения основного контента и опционального Isle по колонкам системной сетки.",
      "useWhen": [
        "Внутри CorporateContent нужно собрать горизонтальную секцию из Content и Isle."
      ],
      "doNotUseWhen": [
        "Для композиции достаточно Body или произвольного горизонтального контейнера без Section."
      ],
      "relationship": "Необязательная часть комплекта CorporateContent; управляет колонками и Gutter между Content и Isle.",
      "status": "approved"
    }
  ],
  "guidance": [
    {
      "area": "usage",
      "topic": "lifecyclePolicy",
      "body": {
        "allowed": [
          "[D] CorporateContent",
          "[M] CorporateContent"
        ],
        "prohibited": [
          "[T] CorporateContent",
          "🔄 [T] CorporateContent"
        ]
      }
    },
    {
