          "component": "[D] CorporateContent",
          "gridAndColsMode": "768"
        }
      }
    },
    {
      "area": "usage",
      "topic": "bodySlotPolicy",
      "body": {
        "arbitraryContentAllowed": true,
        "arbitraryCompositionAllowed": true,
        "multipleChildrenAllowed": true,
        "instanceSwapAllowed": true,
        "directionAndItemSpacing": "Определяются вложенной композицией.",
        "gutterRule": "Gutter не обязателен для Body; его можно использовать в любой вложенной горизонтальной композиции, Section не обязателен.",
        "nestedCorporateContentAllowed": false,
        "swapMeMustBeReplaced": true
      }
    },
    {
      "area": "usage",
      "topic": "rootConfiguration",
      "body": {
        "background": "Выбирается через mode коллекции BackgroundPlate Color для всего фрейма; default — base-bg-alt (grey), разрешены base-bg-alt (grey) и base-bg (white), modal-bg-* запрещены; выбор page mode будет определён отдельным паттерном; ручной fill запрещён.",
        "gridStyle": "Системный grid style нельзя менять вручную.",
        "spacing": "Определяется mode коллекции [D] Grid & Cols или [M] Grid & Cols; ручные padding запрещены.",
        "sizing": {
          "width": "Fill container",
          "height": "Hug contents"
        },
        "prohibitedManualOverrides": [
          "radius",
          "stroke",
          "effects.*",
          "opacity",
          "clipsContent"
        ],
        "clickable": false,
        "detachAllowed": false,
        "bodyDetachAllowed": false,
        "layoutDirection": "VERTICAL",
        "itemSpacing": 0,
        "clipsContent": false,
        "mobileWebRequiredMargins": {
          "TopMargin": "24",
          "BottomMargin": "24"
        }
      }
    },
    {
      "area": "usage",
      "topic": "agentInstructions",
      "body": [
        "Не считай произвольный контент или несколько дочерних элементов внутри Body нарушением сами по себе.",
        "Проверяй содержимое Body по собственным компонентным контрактам и паттернам.",
        "Считай использование переходного [T] CorporateContent явным нарушением.",
        "Не рекомендуй ручную правку fill, grid style или padding корня CorporateContent; рекомендуй правильный mode переменных.",
        "Не требуй наличия родительского компонента CorporatePage в Figma: такого компонента нет, самостоятельное использование CorporateContent допустимо.",
        "Не применяй Gutter как обязательный itemSpacing внутри Body; он допустим в любой горизонтальной композиции без обязательного Section.",
        "На ширине 768 требуй [D] CorporateContent и mode 768 коллекции [D] Grid & Cols.",
        "Не придумывай условия выбора между base-bg-alt и base-bg до появления отдельного паттерна; default — base-bg-alt (grey).",
        "Не разрешай кликабельность корня или detach CorporateContent и Body.",
        "Не разрешай вкладывать CorporateContent внутрь CorporateContent и не оставляй SwapMe после добавления реального содержимого.",
        "Требуй Header или HeaderMenu непосредственно над CorporateContent в общем вертикальном контейнере с gap 0.",
        "Не разрешай менять вертикальное направление, itemSpacing=0 или clipsContent=false корня CorporateContent."
      ]
    },
