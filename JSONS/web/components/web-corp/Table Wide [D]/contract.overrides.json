  "assemblyPolicy": {
    "workflow": "detached-rows-with-library-cells",
    "headerRow": "[D] HeadRow :: Universal",
    "bodyRow": "[D] BodyRow :: Wide",
    "designerSteps": [
      "Добавить [D] HeadRow :: Universal и [D] BodyRow :: Wide.",
      "Детачить строки.",
      "Добавить нужные библиотечные ячейки из [D] HeadCells :: Universal и [D] BodyCells :: Wide.",
      "Подобрать ширину каждой ячейки в detached-композиции."
    ],
    "requiredSurroundingComponents": [
      "CorporateTopbar",
      "HeaderRow",
      "BodyRow",
      "Pagination",
      "[D] BackgroundPlateSlot"
    ],
    "unrelatedComponents": [
      "TableView"
    ]
  },
  "usagePolicy": {
    "cellTextSlots": 1,
    "supportsHorizontalScroll": true,
    "supportsManyColumns": true,
    "supportsGrouping": true,
    "maxGroupingLevels": 1
  },
  "geometryPolicy": {
    "rowHeight": "effective-baseline-only",
    "columnWidth": {
      "designerEditable": true,
      "userEditable": true,
      "headAndBodyMustMatch": true
    },
    "fixedWidthCells": [
      "[D] BodyControlCell :: Wide",
      "[D] BodyActionCell :: Wide",
      "[D] HeadActionCell",
      "[D] HeadControlCell"
    ]
  },
  "statePolicy": {
    "sorting": {
      "enabledByContext": true,
      "maxActiveColumns": 1,
      "initialState": "product-defined"
    },
    "skeleton": {
      "defaultScope": "whole-table",
      "partialRowOrCellLoadingAllowed": true
    }
  },
  "interactionPolicy": {
    "wholeRowClickable": true,
    "selectAllScope": "current-page",
    "headControlRequiredWhenSelectable": true
  },
  "columnControlPolicy": {
    "required": true,
    "interactiveColumnMinWidth": 160,
    "pinningAllowed": true,
    "pinningAllColumnsEqualsNoPinning": true,
    "sortingActionsVisibleOnlyForSortableColumns": true
  },
  "bottomBlockPolicy": {
    "component": "Pagination",
    "alwaysPresent": true,
    "singlePagePreset": "None",
    "selectedRowsPreset": "BulkActions",
    "stickyOnVerticalOverflow": true,
    "lastBodyRowDivider": false,
    "bulkActions": {
      "standaloneTableBulkActionsAllowed": false,
      "maxActionButtons": 4,
      "actions": "context-dependent for selected rows"
    }
  },
  "actionCellPolicy": {
    "allowedContent": [
      "one Button",
      "PickerButton",
      "Presets=None"
    ],
    "arbitraryInstanceSwap": false
  },
  "contentPolicy": {
    "arbitraryInstanceSwap": false,
    "contentSelection": "component-supported presets only",
    "supportedPresetsAllowed": true,
    "emptyOrErrorState": {
      "component": "CorporateSystemMessage",
      "replaces": "BodyRow only",
      "preserves": [
        "CorporateTopbar",
        "[D] HeadRow :: Universal",
        "Pagination"
      ]
    }
  },
  "allowedLayerOverrides": [
    "characters",
    "alignment in HeadCell and BodyCell",
    "width of ordinary HeadCell and matching BodyCell"
  ],
  "forbiddenLayerOverrides": [
    "typography",
    "fill",
    "stroke",
    "opacity",
    "padding",
    "spacing",
    "radius",
    "row height",
    "width of ControlCell and ActionCell"
  ],
  "visualStatePolicy": {
    "hover": "effective-baseline",
    "selected": "effective-baseline",
    "disabled": "effective-baseline"
  },
  "paginationPolicy": {
    "rowsPerPageUserEditable": true,
    "allowedRowsPerPage": [
      10,
      25,
      50,
      100
    ]
  },
  "linkedPatterns": [
    "ptrn:tables.data-formatting",
    "ptrn:controls.buttons-and-button-groups"
  ],
  "internalComponents": [
    "ActionButton",
    "BorderLine",
    "Chevron",
    "ColumnControl",
    "ColumnControl :: OptionList",
    "ControlAddon",
    "GroupBorderLine",
    "HeadDivider",
    "HeaderAddon",
    "LeftAddon",
    "RightAddon",
    "Sorting",
    "Text"
  ],
  "anatomySemantics": {
    "root": {
      "path": "<variant root>",
      "scope": "component-root",
      "designerEditable": false
    },
    "rows": {
      "path": "*Row*",
      "scope": "table-row",
      "designerEditable": "component-properties-and-content"
    },
    "cells": {
      "path": "*Cell*",
      "scope": "table-cell",
      "designerEditable": "component-properties-and-content"
    },
    "addOns": {
      "path": "*Addon*",
      "scope": "cell-addon",
      "designerEditable": "component-properties-through-instance"
    }
  },
  "resetModel": {
    "componentProperties": [
      "variant.*"
    ],
    "layerProperties": [
      "fills",
      "strokes",
      "strokeWeight",
      "cornerRadius",
      "opacity",
      "layout.padding",
      "layout.itemSpacing",
      "styles.text",
      "typography"
    ],
    "contentProperties": [
      "characters"
    ],
    "dependencyPolicy": "Nested diffs семейства таблиц должны использовать effective baseline выбранного table component перед fallback к standalone baselines вложенных компонентов."
  }
