    {
      "area": "usage",
      "topic": "agentGuidance",
      "body": [
        "Используй exact pattern или component-contract rule до повышения критичности.",
        "Считай Table Wide detached-композицией из [D] HeadRow :: Universal, [D] BodyRow :: Wide и соответствующих библиотечных ячеек.",
        "Проверяй, что [D] TopBar и [D] BackgroundPlateSlot являются соседями в общем Level-0 контейнере: TopBar не входит в Slot плейта. Внутри плейта находятся только табличные части.",
        "Проверяй наличие [D] HeadRow :: Universal, [D] BodyRow :: Wide и [D] StickyPagination внутри [D] BackgroundPlateSlot; обычный Pagination и TableView к этой сборке не относятся.",
        "Для одного столбца ширины HeadCell и BodyCell должны совпадать; control/action-ячейки и высота строк сохраняют effective baseline.",
        "У узкой HeadCell с управляющими элементами Title получает width=Fill, height=Hug и end truncation; изменение width не должно переводить высоту Title в Fixed.",
        "Для Table Wide padding плейта равен top=Spacing/0 и right/bottom/left=Spacing/16. Не добавляй повторные inset в table, row или cell.",
        "Если сценарий задаёт row action, покажи отдельное entry-state: active menu/popover, открытый от ActionButton и содержащий названное действие. Bare ellipsis без раскрытого действия не считается точкой входа.",
        "Post-action state обязан отражать подтверждённое изменение данных или явный системный результат. Он не может быть визуальной копией entry-state с прежними значениями и статусами.",
        "Допускай только один уровень группировки через [D] BodyGroupRow :: Wide.",
        "Служебные элементы таблицы нельзя рекомендовать для отдельного использования.",
        "Для вложенных слоёв используй effective baseline семейства Table Wide."
      ]
    },
    {
      "area": "api",
      "topic": "appliesTo",
      "body": {
        "generatedContract": "contract.generated.json",
        "rawCatalog": "Web _ Corp Components -- Table _ _ Wide [D].json"
      }
    },
    {
      "area": "api",
      "topic": "assemblyPolicy",
      "body": {
        "workflow": "detached-rows-with-library-cells",
        "headerRow": "[D] HeadRow :: Universal",
        "bodyRow": "[D] BodyRow :: Wide",
        "designerSteps": [
          "Добавить [D] HeadRow :: Universal и [D] BodyRow :: Wide.",
          "Детачить строки.",
          "Добавить нужные библиотечные ячейки из [D] HeadCells :: Universal и [D] BodyCells :: Wide.",
          "Подобрать ширину каждой ячейки в detached-композиции."
        ],
        "requiredSurroundingComponents": [
          "[D] TopBar (sibling Level-0)",
          "HeaderRow",
          "BodyRow",
          "[D] StickyPagination",
          "[D] BackgroundPlateSlot"
        ],
        "unrelatedComponents": [
          "TableView"
        ],
        "placementPolicy": {
          "topBarAndPlate": "siblings-in-common-level-0-parent",
          "topBarInsideBackgroundPlateSlot": false,
          "tablePartsInsidePlateSlot": [
            "[D] HeadRow :: Universal",
            "[D] BodyRow :: Wide",
            "[D] StickyPagination"
          ]
        }
      }
    },
    {
      "area": "api",
      "topic": "usagePolicy",
      "body": {
        "cellTextSlots": 1,
        "supportsHorizontalScroll": true,
        "supportsManyColumns": true,
        "supportsGrouping": true,
        "maxGroupingLevels": 1
      }
    },
    {
      "area": "api",
      "topic": "geometryPolicy",
      "body": {
        "rowHeight": "effective-baseline-only",
        "columnWidth": {
          "designerEditable": true,
          "userEditable": true,
          "headAndBodyMustMatch": true
        },
        "headCellTitle": {
          "whenColumnHasInteractiveControls": {
            "width": "FILL",
            "height": "HUG",
            "textTruncation": "ENDING"
          },
          "fixedHeightAfterWidthChange": false
        },
        "fixedWidthCells": [
          "[D] BodyControlCell :: Wide",
          "[D] BodyActionCell :: Wide",
          "[D] HeadActionCell",
          "[D] HeadControlCell"
        ]
      }
    },
    {
      "area": "api",
      "topic": "statePolicy",
      "body": {
        "sorting": {
          "enabledByContext": true,
          "maxActiveColumns": 1,
          "initialState": "product-defined"
        },
        "skeleton": {
          "defaultScope": "whole-table",
          "partialRowOrCellLoadingAllowed": true
        }
      }
    },
    {
      "area": "api",
      "topic": "interactionPolicy",
      "body": {
        "wholeRowClickable": true,
        "selectAllScope": "current-page",
        "headControlRequiredWhenSelectable": true,
        "rowActionFlow": {
          "requiresVisibleEntryState": true,
          "entryState": "active menu or popover anchored to the row ActionButton and listing the named action",
          "bareActionButtonIsInsufficient": true,
          "requiredStates": [
            "entry-action-menu",
            "confirmation",
            "post-action-result"
          ],
          "postActionState": "must visibly reflect the completed mutation or a system result; a duplicate of the entry state is invalid",
          "componentPolicy": "Use an active library menu/popover discovered from agent-context; do not hand-draw the action menu."
        }
      }
    },
    {
      "area": "api",
      "topic": "columnControlPolicy",
      "body": {
        "required": true,
        "interactiveColumnMinWidth": 160,
        "pinningAllowed": true,
        "pinningAllColumnsEqualsNoPinning": true,
        "sortingActionsVisibleOnlyForSortableColumns": true
      }
    },
    {
      "area": "api",
      "topic": "bottomBlockPolicy",
      "body": {
        "component": "[D] StickyPagination",
        "alwaysPresent": true,
        "singlePagePreset": "None",
        "selectedRowsPreset": "BulkActions",
        "stickyOnVerticalOverflow": true,
        "lastBodyRowDivider": false,
        "bulkActions": {
          "standaloneTableBulkActionsAllowed": false,
          "maxActionButtons": 4,
          "actions": "context-dependent for selected rows"
        }
      }
    },
    {
      "area": "api",
      "topic": "actionCellPolicy",
      "body": {
        "allowedContent": [
          "one Button",
          "PickerButton",
          "Presets=None"
        ],
        "arbitraryInstanceSwap": false
      }
    },
    {
      "area": "api",
      "topic": "contentPolicy",
      "body": {
        "arbitraryInstanceSwap": false,
        "contentSelection": "component-supported presets only",
        "supportedPresetsAllowed": true,
        "emptyOrErrorState": {
          "component": "CorporateSystemMessage",
          "replaces": "BodyRow only",
          "preserves": [
            "[D] TopBar",
            "[D] HeadRow :: Universal",
            "[D] StickyPagination"
          ]
        }
      }
    },
