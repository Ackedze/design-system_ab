{
  "$schema": "hub/facet.semantics@1",
  "summary": "Table Wide [D] — семейство для таблиц с одним текстовым слотом в ячейке, большим количеством столбцов, группировкой и горизонтальным скроллом.",
  "components": [
    {
      "figmaName": "[D] HeadRow :: Universal",
      "figmaKey": "50fd36cfcba2755a48aec59144cbb3bbd6aa4380",
      "purpose": "Универсальная строка заголовков desktop-таблицы, задающая структуру и ширины колонок.",
      "useWhen": [
        "Собирается заголовок Table Basic или Table Wide."
      ],
      "doNotUseWhen": [
        "Нужно показать строку данных, а не названия колонок."
      ],
      "relationship": "Общий header-row для табличных семейств; структура должна совпадать с body-строками.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyRow :: Wide",
      "figmaKey": "4ebc8002c21ea12d0e149fb782cdf0b219769a8a",
      "purpose": "Строка данных для desktop-таблицы с большим количеством столбцов и горизонтальным скроллом.",
      "useWhen": [
        "Таблица содержит много колонок или требует закрепления и горизонтального скролла."
      ],
      "doNotUseWhen": [
        "Достаточно простой таблицы до пяти столбцов без горизонтального скролла."
      ],
      "relationship": "Основная строка Table Wide; наполняется Wide-ячейками с ширинами, согласованными с HeadRow.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyGroupRow :: Wide",
      "figmaKey": "ecd3eaf818ad2287192606a5911450f836e83d31",
      "purpose": "Группирующая строка Table Wide для одного поддерживаемого уровня группировки данных.",
      "useWhen": [
        "Строки Wide-таблицы нужно объединить в раскрываемую или обозначенную группу первого уровня."
      ],
      "doNotUseWhen": [
        "Нужна многоуровневая иерархия групп."
      ],
      "relationship": "Опциональная групповая строка Table Wide; семейство поддерживает только один уровень группировки.",
      "status": "approved"
    },
    {
      "figmaName": "[D] HeadCell",
      "figmaKey": "6968c89343b210b7e5071d4d6ac6e7bd29576dc6",
      "purpose": "Обычная ячейка заголовка таблицы для названия колонки и предусмотренного состояния сортировки.",
      "useWhen": [
        "В HeadRow нужна колонка с текстовым заголовком."
      ],
      "doNotUseWhen": [
        "Колонка предназначена только для выбора строк или действий."
      ],
      "relationship": "Контентная ячейка внутри [D] HeadRow :: Universal; её ширина согласуется с BodyCell.",
      "status": "approved"
    },
    {
      "figmaName": "[D] HeadControlCell",
      "figmaKey": "2c22a72d9783d35f3d682e28cbc61c9d4376505d",
      "purpose": "Фиксированная ячейка заголовка таблицы для массового выбора или другого предусмотренного контролла.",
      "useWhen": [
        "У таблицы есть control-колонка для выбора строк."
      ],
      "doNotUseWhen": [
        "Колонка содержит обычный заголовок данных или действия."
      ],
      "relationship": "Control-ячейка [D] HeadRow :: Universal, парная BodyControlCell.",
      "status": "approved"
    },
    {
      "figmaName": "[D] HeadActionCell",
      "figmaKey": "7b19337a73c797add443b6cee14337437a4c82f4",
      "purpose": "Фиксированная ячейка заголовка для колонки действий над отдельной строкой.",
      "useWhen": [
        "В body-строках есть отдельная action-колонка."
      ],
      "doNotUseWhen": [
        "Действия относятся ко всей таблице и должны находиться в CorporateTopbar."
      ],
      "relationship": "Header-пара для BodyActionCell в [D] HeadRow :: Universal.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyCell :: Wide",
      "figmaKey": "da8f6b4841c28ace944c4071abb9502cfaf9ed8c",
      "purpose": "Обычная ячейка Table Wide для одного смыслового значения, статуса, ссылки, суммы или аккаунта.",
      "useWhen": [
        "В строке Wide нужно показать значение одной колонки."
      ],
      "doNotUseWhen": [
        "Колонка предназначена только для выбора строки или действия."
      ],
      "relationship": "Контентная ячейка внутри [D] BodyRow :: Wide; соответствует HeadCell той же колонки.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyControlCell :: Wide",
      "figmaKey": "77958a2a05ac45ffda72746179f5fdfabab0a720",
      "purpose": "Фиксированная ячейка строки Table Wide для выбора строки или другого предусмотренного контролла.",
      "useWhen": [
        "Wide-таблице нужен control-столбец."
      ],
      "doNotUseWhen": [
        "В колонке отображаются данные или действия над строкой."
      ],
      "relationship": "Body-пара HeadControlCell; ширина контролируется таблицей и не меняется вручную.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyActionCell :: Wide",
      "figmaKey": "7652b5e6dac3680a7279abd9007082164107c321",
      "purpose": "Фиксированная ячейка строки Table Wide для предусмотренного действия над объектом.",
      "useWhen": [
        "У каждой строки Wide-таблицы должно быть действие в отдельной колонке."
      ],
      "doNotUseWhen": [
        "Действие относится ко всей таблице или является обычным значением."
      ],
      "relationship": "Body-пара HeadActionCell внутри [D] BodyRow :: Wide.",
      "status": "approved"
    }
  ],
