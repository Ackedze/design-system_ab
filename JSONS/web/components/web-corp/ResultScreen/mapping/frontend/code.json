{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/result-screen",
  "version": "80.10.0",
  "component": "ResultScreenBase",
  "exports": [
    "ResultScreenBase",
    "ResultScreenModal"
  ],
  "props": [
    {
      "name": "backgroundPlateProps",
      "type": "Omit<BackgroundPlateProps, \"children\">",
      "description": "Дополнительные пропсы для BackgroundPlate"
    },
    {
      "name": "bottomAddon",
      "type": "ReactNode",
      "description": "Слот для дополнительного контента под основным контентом"
    },
    {
      "name": "buttonGrow",
      "type": "boolean",
      "description": "Позволяет растянуть кнопки на всю доступную ширину"
    },
    {
      "name": "buttonsDirection",
      "type": "\"row\" | \"column\"",
      "values": [
        "row",
        "column"
      ],
      "description": "Расположение кнопок в линию или в колонку"
    },
    {
      "name": "caption",
      "type": "string",
      "description": "Текст для подпись"
    },
    {
      "name": "captionAdditionalClassname",
      "type": "string",
      "description": "Дополнительный classname для caption"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный classname для компонента"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "fullHeight",
      "type": "boolean",
      "description": "Позволяет контенту занять всю высоту"
    },
    {
      "name": "primaryButtonProps",
      "type": "BottomAddonButton",
      "description": "Дополнительные пропсы для primary кнопки"
    },
    {
      "name": "secondaryButtonProps",
      "type": "BottomAddonButton",
      "description": "Дополнительные пропсы для secondary кнопки"
    },
    {
      "name": "size",
      "type": "\"small\" | \"large\"",
      "values": [
        "small",
        "large"
      ],
      "description": "Размер компонента, при size=\"small\" отображаются только title и кнопки"
    },
    {
      "name": "spinnerProps",
      "type": "SpinnerProps",
      "description": "Дополнительные пропсы для спиннера"
    },
    {
      "name": "state",
      "type": "ResultScreenBaseState",
      "values": [
        "error",
        "success",
        "warning"
      ],
      "default": "success"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Текст для подзаголовка"
    },
    {
      "name": "subtitleAdditionalClassname",
      "type": "string",
      "description": "Дополнительный classname для subtitle"
    },
    {
      "name": "timerProps",
      "type": "CircularProgressBarProps",
      "description": "Дополнительные пропсы для таймера"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Текст для заголовка"
    },
    {
      "name": "useBackgroundPlate",
      "type": "boolean",
      "description": "Использовать ли компонент BackgroundPlate"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
