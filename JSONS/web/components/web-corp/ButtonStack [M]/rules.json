      {
        "ruleId": "component:web-corp.button-stack.figma-only-bottom-action-preset",
        "severity": "info",
        "source": "owner-confirmed",
        "appliesTo": "component.identity|component.usage",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "target": {
          "component": "web-corp.button-stack",
          "layers": [
            "🔒 [M] ButtonStack",
            "[M] ButtonStack",
            "ButtonStack [M]"
          ]
        },
        "classification": {
          "figmaOnly": true,
          "lifecycle": "active",
          "codeExportExpected": false,
          "reportAsCustomization": false
        },
        "ruleText": "ButtonStack — активный Figma-only пресет нижней зоны действий mobile-web. Не требуй отдельный runtime-компонент или Code Connect mapping для корня."
      },
      {
        "ruleId": "component:web-corp.button-stack.must-be-bottom-anchored",
        "severity": "error",
        "source": "owner-confirmed",
        "appliesTo": "layout.position|screen.composition",
        "checkType": "llm",
        "matchKind": "composition_rule",
        "conditions": {
          "position": "absolute",
          "bottom": 0,
          "scrollsWithContent": false
        },
        "classification": {
          "treatAsViolation": true,
          "designSeverity": "error"
        },
        "remediation": "Переместите ButtonStack в абсолютную нижнюю зону экрана и установите bottom=0.",
        "ruleText": "ButtonStack должен быть абсолютно расположен у нижнего края экрана с bottom=0 и не должен прокручиваться вместе с контентом. Размещение внутри обычного document flow является ошибкой."
      },
      {
        "ruleId": "component:web-corp.button-stack.page-reserves-space",
        "severity": "error",
        "source": "owner-confirmed",
        "appliesTo": "screen.content|layout.overlap",
        "checkType": "llm",
        "matchKind": "composition_rule",
        "conditions": {
          "hostMustReserveButtonStackSpace": true
        },
        "classification": {
          "treatAsViolation": true,
          "designSeverity": "error"
        },
        "remediation": "Добавьте нижний резерв контента, равный фактической высоте ButtonStack в текущем состоянии.",
        "ruleText": "Контент страницы обязан резервировать место под абсолютный ButtonStack. Нижний контент не должен скрываться или перекрываться зоной действий."
      },
      {
        "ruleId": "component:web-corp.button-stack.preset-composition-is-fixed",
        "severity": "error",
        "source": "owner-confirmed",
        "appliesTo": "variant.Presets|component.composition",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "requiredComposition": {
          "Primary": [
            "Primary button"
          ],
          "Secondary": [
            "Secondary button"
          ],
          "Group Horizontal": [
            "Secondary button left",
            "Primary button right"
          ],
          "Group Vertical": [
            "Primary button top",
            "Secondary button bottom"
          ],
          "Primary + Icon": [
            "Primary button left",
            "icon-only button right"
          ]
        },
        "classification": {
          "treatAsViolation": true,
          "designSeverity": "error",
          "resetSurface": "parameters"
        },
        "remediation": "Верните точное число, порядок, View и тип кнопок выбранного Presets.",
        "ruleText": "Каждый Presets имеет фиксированное число, порядок и иерархию действий. Нельзя добавлять третью кнопку, удалять кнопку из группы, менять порядок Primary/Secondary или заменять icon-only действие обычной кнопкой."
      },
      {
