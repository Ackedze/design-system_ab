{
  "schemaVersion": 1,
  "documentType": "component-rules",
  "componentKey": "web-corp.background-plate",
  "status": "ready",
  "applicability": {
    "channels": [
      "b2b"
    ],
    "platforms": [
      "desktop",
      "mobile-web"
    ],
    "source": "path-policy",
    "updatedAt": "2026-07-10"
  },
  "rules": [
    {
      "ruleId": "component:web-corp.background-plate.component-properties-are-first-class",
      "severity": "info",
      "source": "component-contract",
      "appliesTo": "variant.*",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlate",
          "[D] BackgroundPlateSlot",
          "[D] Style Level 1",
          "[D] Style Level 2",
          "[D][Promo] BackgroundPlate",
          "[D][Promo] Style Level 1",
          "[D][Promo] Style Level 2",
          "[M] BackgroundPlate",
          "[M] BackgroundPlateSlot",
          "[M] Style Level 1",
          "[M] Style Level 2",
          "[M][Promo] BackgroundPlate",
          "[M][Promo] Style Level 1",
          "[M][Promo] Style Level 2"
        ]
      },
      "ruleText": "Изменения variant/property в компонентах семейства BackgroundPlate являются component-property customizations. Показывай их отдельно от производных визуальных изменений layer."
    },
    {
      "ruleId": "component:web-corp.background-plate.background-plate-view-is-alias",
      "severity": "info",
      "source": "component-contract",
      "appliesTo": "component.identity|codeExport.*",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "codeExports": [
          "BackgroundPlateView"
        ],
        "mapsTo": [
          "[D] BackgroundPlate",
          "[M] BackgroundPlate",
          "[D][Promo] BackgroundPlate",
          "[M][Promo] BackgroundPlate"
        ]
      },
      "classification": {
        "reportAsCustomization": false,
        "doNotTreatAsViolationByDefault": true,
        "useComponentKey": "web-corp.background-plate"
      },
      "ruleText": "BackgroundPlateView — code/private alias семейства BackgroundPlate. Не создавай отдельную рекомендацию “неизвестный компонент”; применяй правила BackgroundPlate, включая effective baseline, reset model, radius и composition rules."
    },
    {
      "ruleId": "component:web-corp.background-plate.layer-properties-use-effective-baseline",
      "severity": "warning",
      "source": "component-contract",
      "appliesTo": "layout.*|styles.text|styles.fill|styles.stroke|fill|stroke|opacity",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlate",
          "[D] BackgroundPlateSlot",
          "[D] Style Level 1",
          "[D] Style Level 2",
          "[D][Promo] BackgroundPlate",
          "[D][Promo] Style Level 1",
          "[D][Promo] Style Level 2",
          "[M] BackgroundPlate",
          "[M] BackgroundPlateSlot",
          "[M] Style Level 1",
          "[M] Style Level 2",
          "[M][Promo] BackgroundPlate",
          "[M][Promo] Style Level 1",
          "[M][Promo] Style Level 2"
        ]
      },
      "ruleText": "Изменения layer/style внутри компонентов семейства BackgroundPlate нужно сравнивать с effective baseline текущего component variant и nested owner context. Изменения layout.padding.* у BackgroundPlateSlot являются допустимыми дизайнерскими кастомизациями, если они нужны композиции и заданы через токены Spacing. Это правило не разрешает изменение radius: скругления BackgroundPlate и Style Level фиксируются компонентным baseline и не должны изменяться вручную."
    },
    {
      "ruleId": "component:web-corp.background-plate.radius-is-fixed-by-component-baseline",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "component-contract",
      "appliesTo": "radius|layout.radius|cornerRadius|cornerRadius.*",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlate",
          "[M] BackgroundPlate",
          "[D][Promo] BackgroundPlate",
          "[M][Promo] BackgroundPlate",
          "BackgroundPlate / absolute back",
          "[D] Style Level 1",
          "[D] Style Level 2",
          "[D][Promo] Style Level 1",
          "[D][Promo] Style Level 2",
          "[M] Style Level 1",
          "[M] Style Level 2",
          "[M][Promo] Style Level 1",
          "[M][Promo] Style Level 2",
          "Position=Level 1 (outer)",
          "Position=Level 2 (inner)"
        ]
      },
      "classification": {
        "reportAsCustomization": true,
        "treatAsViolation": true,
        "designSeverity": "error",
        "resetSurface": "layer",
        "useEffectiveBaseline": true
      },
      "remediation": "Сбросьте radius к effective baseline выбранного варианта BackgroundPlate. Не задавайте скругления BackgroundPlate и Style Level вручную.",
      "ruleText": "Скругления BackgroundPlate, BackgroundPlateSlot и вложенных Style Level задаются компонентом и его effective baseline. Дизайнер не должен вручную изменять radius/cornerRadius у root-layer BackgroundPlate, BackgroundPlateSlot или Style Level. Любое отличие radius от effective baseline является нарушением, а не допустимой композиционной настройкой."
    },
    {
      "ruleId": "component:web-corp.background-plate.padding-is-designer-controlled",
      "severity": "info",
      "source": "component-contract",
      "appliesTo": "layout.padding.*",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlateSlot",
          "[M] BackgroundPlateSlot"
        ]
      },
      "classification": {
        "reportAsCustomization": true,
        "doNotTreatAsViolationByDefault": true,
        "doNotRecommendResetToStandalonePadding": true,
        "requireSpacingTokenRuleCheck": "component:web-corp.background-plate.padding-uses-spacing-tokens"
      },
      "recommendedDefaults": {
        "Level-1 (outer)": "Spacing/32",
        "Level-2 (inner)": "Spacing/24"
      },
      "ruleText": "Рекомендуемый стартовый padding BackgroundPlateSlot: Spacing/32 для Level-1 (outer) и Spacing/24 для Level-2 (inner). Дизайнер может свободно изменить padding под контекст композиции или применимый паттерн. Само отличие от рекомендуемого значения не является нарушением и не требует сброса. Показывай изменение как layer customization и проверяй только обязательную привязку каждого layout.padding.* к токену Spacing."
    },
    {
      "ruleId": "component:web-corp.background-plate.slot-auto-layout-is-context-controlled",
      "severity": "info",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.slot-auto-layout-by-context",
      "appliesTo": "layout.axis|layout.itemSpacing|layout.primaryAxisAlignItems|layout.counterAxisAlignItems",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlateSlot / Slot",
          "[M] BackgroundPlateSlot / Slot"
        ]
      },
      "classification": {
        "reportAsCustomization": true,
        "doNotTreatAsViolationByDefault": true,
        "doNotRecommendResetToStandaloneLayout": true,
        "keepPaddingTokenCheckSeparate": true
      },
      "ruleText": "Axis, gap/itemSpacing и alignment внутри Slot полностью определяются контекстом композиции и вложенным контентом. Отличие этих свойств от standalone baseline не является нарушением и не требует рекомендации сбросить auto-layout. Padding проверяется отдельно на соответствие Spacing tokens."
    },
    {
      "ruleId": "component:web-corp.background-plate.slot-clipping-is-context-controlled",
      "severity": "info",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.slot-clipping-by-context",
      "appliesTo": "clipsContent|layout.clipsContent|overflow",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlateSlot / Slot",
          "[M] BackgroundPlateSlot / Slot"
        ]
      },
      "classification": {
        "reportAsCustomization": true,
        "doNotTreatAsViolationByDefault": true,
        "doNotRecommendResetToStandaloneClipping": true
      },
      "ruleText": "Clip content у BackgroundPlateSlot не является обязательным. Значения clipsContent=true и clipsContent=false допустимы и выбираются по контексту и поведению вложенного контента. Само отличие от standalone baseline не является нарушением."
    },
    {
      "ruleId": "component:web-corp.background-plate.slot-sizing-fill-width-hug-height",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.slot-sizing",
      "appliesTo": "layout.sizing.horizontal|layout.sizing.vertical|layoutSizingHorizontal|layoutSizingVertical",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.background-plate",
        "layers": [
          "[D] BackgroundPlateSlot / Slot",
          "[M] BackgroundPlateSlot / Slot"
        ]
      },
      "requiredValues": {
        "layout.sizing.horizontal": "FILL",
        "layout.sizing.vertical": "HUG",
        "layoutSizingHorizontal": "FILL",
        "layoutSizingVertical": "HUG"
      },
      "classification": {
        "reportAsCustomization": true,
        "treatAsViolation": true,
        "designSeverity": "error",
        "resetSurface": "layer"
      },
      "remediation": "Установите для Slot ширину Fill и высоту Hug.",
      "ruleText": "Slot BackgroundPlateSlot должен растягиваться по ширине родителя в режиме Fill и рассчитывать высоту по вложенному контенту в режиме Hug. Fixed или Hug по ширине и Fixed или Fill по высоте являются нарушением sizing-контракта."
    },
    {
      "ruleId": "component:web-corp.background-plate.level-2-requires-level-1",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.level-2-over-level-1",
      "appliesTo": "component.composition",
      "checkType": "llm",
      "matchKind": "composition_rule",
      "conditions": {
        "components": [
          "[D] BackgroundPlate",
          "[M] BackgroundPlate",
          "[D][Promo] BackgroundPlate",
          "[M][Promo] BackgroundPlate"
        ],
        "variant": {
          "Position": "Level 2 (inner)"
        }
      },
      "requiredComposition": {
        "requiredParent": {
          "component": "BackgroundPlate",
          "variant": {
            "Position": "Level 1 (outer)"
          }
        },
        "directParentRequired": true,
        "allowStandalone": false,
        "allowContractExceptions": false
      },
      "remediation": "Переместите Level-2 непосредственно внутрь BackgroundPlate Level-1 либо измените самостоятельную поверхность на Level-1.",
      "ruleText": "BackgroundPlate с Position=Level 2 (inner) всегда должен располагаться поверх BackgroundPlate Level 1. Самостоятельный Level 2 запрещён без исключений."
    },
    {
      "ruleId": "component:web-corp.background-plate.slot-content-levels",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.slot-content-levels",
      "appliesTo": "component.composition|slot.children",
      "checkType": "llm",
      "matchKind": "composition_rule",
      "conditions": {
        "components": [
          "[D] BackgroundPlateSlot",
          "[M] BackgroundPlateSlot"
        ],
        "slot": "Slot"
      },
      "allowedComposition": {
        "directContent": "any",
        "nestedLevel2Required": false,
        "allowedNestedBackgroundPlateLevels": [
          "Level-2 (inner)"
        ],
        "level2RequiredHostLevel": "Level-1 (outer)",
        "directParentRequired": true
      },
      "disallowedNestedBackgroundPlateLevels": [
        "Level-0 (base)",
        "Level-1 (outer)"
      ],
      "remediation": "Оставьте обычный контент непосредственно в Slot либо замените вложенный BackgroundPlate Level-0/Level-1 на Level-2, если действительно нужна дополнительная поверхность.",
      "ruleText": "В Slot BackgroundPlateSlot можно размещать любой обычный контент напрямую; обязательная обёртка Level-2 не требуется. Из BackgroundPlate-уровней внутри Slot допустим только Level-2 (inner). Вложенные Level-0 (base) и Level-1 (outer) запрещены."
    },
    {
      "ruleId": "component:web-corp.background-plate.root-surface-requires-level-0",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.root-surface-level-0",
      "appliesTo": "screen.composition|variables.BackgroundPlate Level",
      "checkType": "llm",
      "matchKind": "composition_rule",
      "conditions": {
        "components": [
          "[D] BackgroundPlateSlot",
          "[M] BackgroundPlateSlot"
        ],
        "requiredAncestorVariableMode": {
          "collection": "BackgroundPlate Level",
          "value": "Level-0 (base)",
          "target": "root-surface"
        }
      },
      "classification": {
        "reportAsCustomization": false,
        "treatAsViolation": true,
        "designSeverity": "error"
      },
      "remediation": "Назначьте mode Level-0 (base) коллекции BackgroundPlate Level главной поверхности страницы или модальной сущности. Не назначайте Level-0 непосредственно экземпляру BackgroundPlate.",
      "ruleText": "Level-0 (base) должен быть назначен главной поверхности, на которой располагается BackgroundPlateSlot. Он задаёт исходный variable context, благодаря которому первый вложенный BackgroundPlate автоматически получает Level-1 (outer). Отсутствие Level-0 на главной поверхности нарушает вычисление уровней. Самому экземпляру BackgroundPlate Level-0 не назначается."
    },
    {
      "ruleId": "component:web-corp.background-plate.background-color-by-surface-context",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.background-color-by-page",
      "appliesTo": "screen.composition",
      "checkType": "deterministic",
      "matchKind": "composition_rule",
      "conditions": {
        "components": [
          "[D] BackgroundPlate",
          "[M] BackgroundPlate",
          "[D] Style Level 1",
          "[M] Style Level 1",
          "[D] Style Level 2",
          "[M] Style Level 2"
        ]
      },
      "requiredMapping": {
        "pageSurface": {
          "gray": "base-bg-alt (gray)",
          "white": "base-bg (white)"
        },
        "modalSurface": {
          "gray": "modal-bg-alt (gray)",
          "white": "modal-bg (white)"
        }
      },
      "remediation": "Выберите BackgroundColor, соответствующий контексту и тону родительской поверхности: base-bg* для страницы или modal-bg* для модальной сущности.",
      "ruleText": "BackgroundColor выбирается по контексту поверхности. Для страниц используй base-bg-alt (gray) на серой поверхности и base-bg (white) на белой поверхности. Для модальных сущностей используй modal-bg-alt (gray) на серой поверхности и modal-bg (white) на белой поверхности. Часть имени до скобок соответствует цветовому токену поверхности; значение в скобках уточняет визуальный фон gray/white."
    },
    {
      "ruleId": "component:web-corp.background-plate.single-background-color-per-page",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.single-background-color-per-page",
      "appliesTo": "screen.composition",
      "checkType": "deterministic",
      "matchKind": "composition_rule",
      "conditions": {
        "components": [
          "[D] BackgroundPlate",
          "[M] BackgroundPlate",
          "[D][Promo] BackgroundPlate",
          "[M][Promo] BackgroundPlate"
        ],
        "scope": "same-page-background-context"
      },
      "requiredComposition": {
        "sameBackgroundColorAcrossScope": true
      },
      "remediation": "Приведите BackgroundColor всех BackgroundPlate в одном surface context к единому значению, соответствующему родительскому фону.",
      "ruleText": "Значение BackgroundColor определяется один раз для всех BackgroundPlate на странице. Если фон основной страницы один и тот же, все подложки должны использовать один BackgroundColor."
    },
    {
      "ruleId": "component:web-corp.background-plate.no-secondary-for-level-2",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.no-secondary-for-level-2",
      "appliesTo": "variant.Type",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "components": [
          "[D] BackgroundPlate",
          "[M] BackgroundPlate",
          "[D] Style Level 2",
          "[M] Style Level 2",
          "[D][Promo] BackgroundPlate",
          "[M][Promo] BackgroundPlate",
          "[D][Promo] Style Level 2",
          "[M][Promo] Style Level 2"
        ],
        "variant": {
          "Position": "Level 2 (inner)"
        }
      },
      "disallowedVariant": {
        "Type": "Secondary"
      },
      "remediation": "Замените Type=Secondary у Level-2 на Primary, Colored или Border в зависимости от требуемого визуального сценария.",
      "ruleText": "Для BackgroundPlate Level 2 не существует стиля Secondary. Используй Type=Primary, Type=Colored или Type=Border."
    },
    {
      "ruleId": "component:web-corp.background-plate.colored-and-border-use-color-tokens",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "component-contract",
      "appliesTo": "fill|stroke|variant.BackgroundColor",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "components": [
          "[D] Style Level 1",
          "[D] Style Level 2",
          "[D][Promo] Style Level 1",
          "[D][Promo] Style Level 2",
          "[M] Style Level 1",
          "[M] Style Level 2",
          "[M][Promo] Style Level 1",
          "[M][Promo] Style Level 2"
        ],
        "variant": {
          "Type": [
            "Colored",
            "Border"
          ]
        }
      },
      "requiredTokenBinding": {
        "byType": {
          "Colored": {
            "properties": [
              "fill"
            ],
            "tokenType": "color"
          },
          "Border": {
            "properties": [
              "stroke"
            ],
            "tokenType": "color"
          }
        }
      },
      "classification": {
        "reportAsCustomization": true,
        "doNotTreatRequiredTokenizedPaintAsViolation": true,
        "treatRawRequiredPaintAsViolation": true,
        "requiredPaintByType": {
          "Colored": "fill",
          "Border": "stroke"
        },
        "borderFillRuleId": "component:web-corp.background-plate.border-has-no-visible-fill"
      },
      "remediation": "Для Colored привяжите fill к цветовому токену. Для Border удалите fill и привяжите stroke к цветовому токену.",
      "ruleText": "Для Type=Colored цвет заливки должен быть задан через цветовой токен дизайн-системы. Для Type=Border через цветовой токен задаётся цвет обводки, а видимая заливка запрещена отдельным правилом. Конкретный цвет может отличаться по смыслу поверхности, но raw fill или raw stroke без требуемого token binding являются нарушением."
    },
    {
      "ruleId": "component:web-corp.background-plate.border-has-no-visible-fill",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.border-no-fill",
      "appliesTo": "fill|styles.fill",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "web-corp.background-plate",
        "variant": {
          "Type": "Border"
        }
      },
      "requiredPaintState": {
        "fill": "none-or-not-visible"
      },
      "classification": {
        "reportAsCustomization": true,
        "treatAsViolation": true,
        "designSeverity": "error",
        "resetSurface": "layer",
        "tokenizedFillIsAlsoViolation": true
      },
      "remediation": "Удалите заливку у Type=Border и оставьте только токенизированную обводку.",
      "ruleText": "Type=Border всегда используется без видимой заливки. Любая заливка, включая привязанную к цветовому токену, нарушает контракт. Визуальная поверхность Border формируется только обводкой."
    },
    {
      "ruleId": "component:web-corp.background-plate.colored-uses-fill-without-stroke",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.colored-fill-only",
      "appliesTo": "fill|styles.fill|stroke|styles.stroke",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "web-corp.background-plate",
        "variant": {
          "Type": "Colored"
        }
      },
      "requiredPaintState": {
        "fill": "visible-and-tokenized",
        "stroke": "none-or-not-visible"
      },
      "classification": {
        "reportAsCustomization": true,
        "treatAsViolation": true,
        "designSeverity": "error",
        "resetSurface": "layer",
        "tokenizedStrokeIsAlsoViolation": true
      },
      "remediation": "Удалите обводку и оставьте для Type=Colored только заливку, привязанную к цветовому токену.",
      "ruleText": "Type=Colored формируется только видимой токенизированной заливкой. Любая видимая обводка, включая привязанную к цветовому токену, нарушает контракт."
    },
    {
      "ruleId": "component:web-corp.background-plate.primary-secondary-paint-is-fixed",
      "severity": "error",
      "ruleKind": "design-rule",
      "severityScope": "design",
      "source": "pattern-link",
      "patternRuleId": "rule:components.background-plate.primary-secondary-paint-fixed",
      "appliesTo": "fill|styles.fill|stroke|styles.stroke",
      "checkType": "deterministic",
