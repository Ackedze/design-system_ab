{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/background-plate",
  "version": "80.10.0",
  "component": "BackgroundPlate",
  "exports": [
    "BackgroundPlate"
  ],
  "props": [
    {
      "name": "backgroundColor",
      "type": "\"base-bg-alt\" | \"base-bg\"",
      "values": [
        "base-bg-alt",
        "base-bg"
      ],
      "description": "Цвет фона у страницы"
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Содержимое"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс для основной подложки"
    },
    {
      "name": "coloredViewValue",
      "type": "string",
      "description": "Цвет фона у `view=colored`"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "dropzoneProps",
      "type": "DropzoneProps",
      "description": "Пропсы для коровского Dropzone (в случае, если используем view Dropzone или DropzoneSecondary)"
    },
    {
      "name": "hasHover",
      "type": "boolean",
      "description": "Реагирует ли компонент при наведении"
    },
    {
      "name": "level",
      "type": "\"outer\" | \"inner\"",
      "values": [
        "outer",
        "inner"
      ],
      "description": "Уровень отображения компонента"
    },
    {
      "name": "paddings",
      "type": "BackgroundPlatePaddings",
      "values": [
        16,
        20,
        24,
        32
      ],
      "description": "Отступы"
    },
    {
      "name": "promo",
      "type": "boolean",
      "description": "Режим Promo"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "description": "Показать скелетон"
    },
    {
      "name": "skeletonProps",
      "type": "SkeletonProps",
      "description": "Пропы для скелетона"
    },
    {
      "name": "view",
      "type": "BackgroundPlateView",
      "values": [
        "primary",
        "secondary",
        "colored",
        "drop-zone",
        "border"
      ],
      "description": "Вид подложки"
    },
    {
      "name": "withBorder",
      "type": "boolean",
      "description": "Добавить border у компонента"
    },
    {
      "name": "withoutBorder",
      "type": "boolean",
      "description": "Убрать border у компонента"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
