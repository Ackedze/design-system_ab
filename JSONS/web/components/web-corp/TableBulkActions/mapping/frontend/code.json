{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/corporate-table-bulk-actions",
  "version": "80.10.0",
  "component": "CorporateTableBulkActions",
  "exports": [
    "CorporateTableBulkActions"
  ],
  "props": [
    {
      "name": "actions",
      "type": "Action[]",
      "description": "Слот для контролов"
    },
    {
      "name": "amounts",
      "type": "SelectedAmounts[]",
      "description": "Суммы выбранных элементов"
    },
    {
      "name": "amountTitle",
      "type": "string",
      "description": "Заголовок для компонента суммы"
    },
    {
      "name": "buttonWrap",
      "type": "boolean",
      "description": "Отображать кнопки на новой строке"
    },
    {
      "name": "checkboxProps",
      "type": "CheckboxProps",
      "required": true,
      "description": "Пропсы для чекбокса"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "containerPaddings",
      "type": "PaddingType",
      "description": "Паддинги для контейнера"
    },
    {
      "name": "count",
      "type": "number",
      "required": true,
      "description": "Количество выбранных элементов"
    },
    {
      "name": "customGrouped",
      "type": "CustomAmounts[]",
      "description": "Кастомная группировка сумм"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "labelText",
      "type": "string",
      "description": "Текст"
    },
    {
      "name": "minorUnits",
      "type": "number",
      "description": "Количество минорных единиц в валюте"
    },
    {
      "name": "open",
      "type": "boolean",
      "description": "Открыт ли элемент"
    },
    {
      "name": "showCheckbox",
      "type": "boolean",
      "description": "Показывать чекбокс"
    },
    {
      "name": "showLabel",
      "type": "boolean",
      "description": "Показывать лейбл"
    },
    {
      "name": "showSelectedBlock",
      "type": "boolean",
      "description": "Показывать блок с выбором"
    },
    {
      "name": "withAiHelper",
      "type": "boolean",
      "default": "false",
      "description": "Наличие AiHelper"
    },
    {
      "name": "codeFormat",
      "type": "\"letter\" | \"symbolic\"",
      "values": [
        "letter",
        "symbolic"
      ],
      "description": "Формат отображения кода валюты",
      "from": "@alfalab/core-components-amount"
    },
    {
      "name": "showPlus",
      "type": "boolean",
      "description": "Показывать значок + для положительных значений",
      "from": "@alfalab/core-components-amount"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
