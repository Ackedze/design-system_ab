{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/file-upload",
  "version": "80.10.0",
  "component": "FileUpload",
  "description": "Компонент для прикрепления файлов",
  "exports": [
    "FileUpload"
  ],
  "props": [
    {
      "name": "accept",
      "type": "string",
      "description": "Допускаемые форматы файлов"
    },
    {
      "name": "attachButtonText",
      "type": "string",
      "description": "Название кнопки \"Прикрепить файл\""
    },
    {
      "name": "attachHint",
      "type": "string | string[]",
      "description": "Подсказка к кнопке \"Прикрепить файл\""
    },
    {
      "name": "block",
      "type": "boolean",
      "description": "Растягивает компонент на ширину контейнера"
    },
    {
      "name": "breakpoint",
      "type": "number",
      "default": "1024",
      "description": "Контрольная точка, с нее начинается desktop версия"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс для основной подложки"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "description",
      "type": "ReactNode",
      "description": "Описание"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Состояние блокированности компонента"
    },
    {
      "name": "dropzoneError",
      "type": "boolean",
      "description": "Отобразить ошибку на dropzone (красный border)"
    },
    {
      "name": "error",
      "type": "string",
      "description": "Текст с ошибкой"
    },
    {
      "name": "fileUploadItems",
      "type": "FileUploadItemWithoutColoredProp[]",
      "required": true,
      "description": "Список файлов"
    },
    {
      "name": "hints",
      "type": "string[]",
      "description": "Массив с подсказками"
    },
    {
      "name": "imgPath",
      "type": "string",
      "description": "Путь к иллюстрации"
    },
    {
      "name": "maxFilesAmount",
      "type": "number",
      "description": "Максимальное количество загружаемых файлов"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "description": "Возможность добавления нескольких файлов"
    },
    {
      "name": "onFileDelete",
      "type": "(id: string, event?: MouseEvent<HTMLElement, MouseEvent>) => void",
      "description": "Обработчик удаления файла"
    },
    {
      "name": "onFileRestore",
      "type": "(id: string) => void",
      "description": "Обработчик восстановления файла"
    },
    {
      "name": "onFileUpload",
      "type": "(files: File[]) => void",
      "description": "Обработчик добавления файла"
    },
    {
      "name": "showAttachButton",
      "type": "boolean",
      "description": "Показывать кнопку \"Прикрепить файл\""
    },
    {
      "name": "showFileCount",
      "type": "boolean",
      "description": "Показывать счетчик файлов"
    },
    {
      "name": "titleViewProps",
      "type": "{ heading: string; } & Pick<TitleViewProps, \"subtitle\">",
      "description": "Пропсы для компонента titleView"
    },
    {
      "name": "view",
      "type": "\"primary\" | \"secondary\"",
      "values": [
        "primary",
        "secondary"
      ],
      "description": "Вид компонента"
    },
    {
      "name": "withBorder",
      "type": "boolean",
      "description": "Показывать бордер у BackgroundPlate. Работает только когда загруженно максимальное количество файлов"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
