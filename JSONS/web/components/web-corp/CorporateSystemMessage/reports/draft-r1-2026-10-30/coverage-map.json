esolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.error-type-by-cause","sourceNorm":"Выбирай Error Type по причине: Internal Server Error — техническая или серверная ошибка; Not Found — страницы нет; Forbidden — недостаточно прав; Not Internet Connection — нет интернета.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.empty-type-by-state","sourceNorm":"Используй Nothing Found для пустого результата поиска, фильтров или периода. Nothing Found Yet — когда объектов ещё не было или они удалены.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.progress-type-by-timing","sourceNorm":"В Progress используй Icon для статичного ожидания без активной операции; Spinner — когда операция выполняется прямо сейчас, но её продолжительность неизвестна; Timer — только когда время известно.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.graphic-override-base-only","sourceNorm":"Менять Graphic можно только в View=Base. В Error, Empty, Progress и No adaptive графика определяется состоянием.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.title-override-by-view","sourceNorm":"Title можно менять только в Base и Progress. В специализированных Error, Empty и No adaptive используй штатный заголовок состояния.","source":"rules.json","implementedScope":[{"targetId":"target.title","targetScope":"self","conditions":{"variants":{"View":["Error","Empty","No adaptive"]},"modes":"all","platforms":["desktop","mobile-web"],"scopeStatus":"confirmed","conditionSubject":"component-root"}}],"route":"authored","manualRuleIds":["component:web-corp.corporate-system-message.title-state-text-fixed"],"compiledRuleIds":["component:web-corp.corporate-system-message.title-state-text-fixed.1.1"]},{"sourceRuleId":"component:web-corp.corporate-system-message.description-override-by-state","sourceNorm":"Description можно менять только в Base, Empty с Type=Nothing Found Yet и Progress.","source":"rules.json","implementedScope":[{"targetId":"target.description","targetScope":"self","conditions":{"variants":{"View":["Error","No adaptive"],"Size":["Large"]},"modes":"all","platforms":["desktop","mobile-web"],"scopeStatus":"confirmed","conditionSubject":"component-root"}}],"route":"authored","manualRuleIds":["component:web-corp.corporate-system-message.description-state-text-fixed"],"compiledRuleIds":["component:web-corp.corporate-system-message.description-state-text-fixed.1.1"]},{"sourceRuleId":"component:web-corp.corporate-system-message.buttons-count-and-views","sourceNorm":"В Large и Small допускается не более двух кнопок: одна Primary и одна Secondary.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.buttons-axis-large-only","sourceNorm":"Axis группы кнопок можно менять только для Size=Large. Для Size=Small сохраняй штатный Axis.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.buttons-optional-combinations","sourceNorm":"Кнопки необязательны. Допустимы четыре комбинации: без кнопок, только Primary, только Secondary или Primary вместе с Secondary.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.large-vertical-axis-by-fit","sourceNorm":"Для Size=Large используй Vertical Axis только когда две кнопки не помещаются в одну горизонталь по ширине контейнера.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.subtitle-is-description","sourceNorm":"Слой Subtitle является Description системного сообщения и подчиняется правилам редактирования Description.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.caption-optional-all-views","sourceNorm":"Caption можно использовать в любом View как опциональное дополнительное описание сообщения.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.effective-baseline-protected","sourceNorm":"Геометрию и визуальные стили корня и внутренних слоёв нельзя менять вручную. Используй effective baseline выбранных View, Size и BG plate.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.placement-by-context","sourceNorm":"Large после формы в 8 колонок занимает 8 колонок; на странице с таблицей — 12 колонок или 100% ширины. Ширина Small определяется родительским контейнером.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.root-fill-hug","sourceNorm":"Корень CorporateSystemMessage использует Fill по ширине и Hug по высоте; отдельных min/max height нет.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.center-alignment-protected","sourceNorm":"Содержимое CorporateSystemMessage всегда центрируется. Alignment нельзя менять вручную.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.structure-protected","sourceNorm":"Нельзя detach-ить корень или внутренние компоненты, менять внутренние View через instance swap и добавлять произвольные слои. Используй штатные параметры и разрешённые overrides.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.platform-breakpoint","sourceNorm":"На ширине 768 и выше используй [D] CorporateSystemMessage. Ниже 768, в mobile-web и адаптиве используй [M] CorporateSystemMessage.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.root-interaction-prohibited","sourceNorm":"Вся поверхность CorporateSystemMessage не может быть кликабельной или реагировать на hover. Интерактивность разрешена только кнопкам.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.built-in-background-plate-protected","sourceNorm":"У встроенного BackgroundPlate нельзя вручную менять Type, Level, цвет, stroke или radius. Эти параметры определяются компонентом поверхности.","source":"rules.json","implementedScope":[],"route":"unresolved-component-binding","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.external-background-plate-slot-allowed","sourceNorm":"CorporateSystemMessage с BG plate=False можно оборачивать во внешний BackgroundPlateSlot, если этого требует композиция.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.modal-usage-allowed","sourceNorm":"CorporateSystemMessage можно использовать в Modal, UniversalModal и PopUpSheet. В модальном контексте допустимы оба размера: Large и Small.","source":"rules.json","implementedScope":[],"route":"context-or-interaction","manualRuleIds":[],"compiledRuleIds":[]},{"sourceRuleId":"component:web-corp.corporate-system-message.no-adaptive-fixed-content","sourceNorm":"В No adaptive нельзя менять Graphic, Title и Description (Subtitle). Caption можно добавить для уточнения альтернативного способа выполнить действие.","source":"rules.json","implementedScope":[{"targetId":"target.title","targetScope":"self","conditions":{"variants":{"View":["Error","Empty","No adaptive"]},"modes":"all","platforms":["desktop","mobile-web"],"scopeStatus":"confirmed","conditionSubject":"component-root"}},{"targetId":"target.description","targetScope":"self","conditions":{"variants":{"View":["Error","No adaptive"],"Size":["Large"]},"modes":"all","platforms":["desktop","mobile-web"],"scopeStatus":"confirmed","conditionSubject":"component-root"}}],"route":"authored","manualRuleIds":["component:web-corp.corporate-system-message.title-state-text-fixed","component:web-corp.corporate-system-message.description-state-text-fixed"],"compiledRuleIds":["component:web-corp.corporate-system-message.description-state-text-fixed.1.1","component:web-corp.corporate-system-message.title-state-text-fixed.1.1"]}],"gaps":[{"id":"USER_NATIVE_ACCEPTANCE","status":"NOT_RUN_USER_ONLY","detail":"Новые целевые привязки и нормы должны пройти проверку владельцем через Apollo."},{"id":"DEPENDENCY_BINDING_AND_OWNERSHIP","status":"NOT_EXECUTED","detail":"Публичные дети доступны по реестру, но транзитивные service parts и точные fixed-nested bindings этой партии ещё не приняты н