{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/button-group",
  "version": "80.10.0",
  "component": "ButtonGroup",
  "exports": [
    "ButtonGroup",
    "isPickerElement"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "elements",
      "type": "(ButtonElementProps | PickerElementProps)[]",
      "required": true,
      "description": "Элементы кнопок"
    },
    {
      "name": "mapElementToPickerOption",
      "type": "MapElementToOption",
      "description": "Функция для кастомной трансформации скрытых кнопок в опции выпадающего списка"
    },
    {
      "name": "maxVisibleButtons",
      "type": "number",
      "default": "4",
      "description": "Максимальное количество отображаемых кнопок"
    },
    {
      "name": "pickerButtonProps",
      "type": "Omit<PickerButtonResponsiveProps, \"view\" | \"className\" | \"size\" | \"options\" | \"optionClassName\" | \"preventFlip\" | \"variant\">",
      "description": "Свойства для компонента PickerButton, который появляется при схлопывании кнопок"
    },
    {
      "name": "primaryFirst",
      "type": "boolean",
      "default": "false",
      "description": "Первая кнопка primary"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "default": "false",
      "description": "Показать скелетон"
    },
    {
      "name": "size",
      "type": "Size",
      "values": [
        32,
        40,
        48,
        56
      ],
      "default": "56",
      "description": "Размер"
    },
    {
      "name": "tooltipProps",
      "type": "TooltipResponsiveProps",
      "description": "Свойства для тултипа"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
