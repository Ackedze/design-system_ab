{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/content-card-wrapper",
  "version": "80.10.0",
  "component": "ContentCardWrapper",
  "exports": [
    "ContentCardWrapper",
    "ContentCardWrapperDesktop",
    "ContentCardWrapperDesktopComponent",
    "ContentCardWrapperMobile",
    "ContentCardWrapperMobileComponent"
  ],
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Контент карточки"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "emptyStateText",
      "type": "string",
      "description": "Текст для пустого состояния"
    },
    {
      "name": "errorText",
      "type": "string",
      "description": "Текст ошибки"
    },
    {
      "name": "leftControl",
      "type": "ReactNode",
      "description": "Контрол слева (по дизайну предполагается Checkbox/Radio/Switch)"
    },
    {
      "name": "onClick",
      "type": "() => void",
      "description": "Обработчик клика на карточку"
    },
    {
      "name": "pickerButtonProps",
      "type": "PickerButtonResponsiveProps",
      "description": "Пропсы для PickerButton, который появится если будет больше 2 иконок"
    },
    {
      "name": "rightAddons",
      "type": "ReactElement<unknown, string | JSXElementConstructor<any>>[]",
      "description": "Иконки справа от основного контента (если иконок больше 2 - прячутся в дропдаун)"
    },
    {
      "name": "shouldUsePickerButton",
      "type": "boolean",
      "description": "Если заранее известно, что иконок больше 2"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "description": "Показать скелетон"
    },
    {
      "name": "skeletonProps",
      "type": "SkeletonProps",
      "description": "Пропы для скелетона"
    },
    {
      "name": "state",
      "type": "\"disabled\" | \"error\" | \"normal\" | \"empty\"",
      "values": [
        "disabled",
        "error",
        "normal",
        "empty"
      ],
      "required": true,
      "description": "Состояние компонента"
    },
    {
      "name": "statusProps",
      "type": "StatusProps",
      "description": "Пропсы для компонента статус (будет отображен в самом верху)"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
