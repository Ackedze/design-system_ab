          "Connected=False": "Визуальная связь точками отсутствует."
        },
        "disallowedComposition": {
          "moreThanFourContentPresets": true,
          "manualExtensionBeyondCapacity": true
        },
        "ruleText": "MiddleContentSlot содержит от одного до четырёх ContentPresets. Capacity задаёт их точное количество, Connected управляет визуальной связью точками. Добавлять больше четырёх элементов через swap или ручную композицию запрещено.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 1
        }
