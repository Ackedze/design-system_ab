            "Skeleton": "True"
          },
          {
            "State": "Error",
            "Skeleton": "True"
          }
        ],
        "implementationGap": {
          "rawCatalogContainsSkeletonTrueOnlyFor": "Active",
          "missingGeneratedCombinations": [
            "Disabled + True",
            "Empty + True",
            "Error + True"
          ],
          "policy": "Не считать отсутствующие в raw комбинации запрещёнными: владелец подтвердил независимость Skeleton от State; каталог Figma требует обновления."
        },
        "ruleText": "Skeleton является независимым признаком загрузки и может использоваться с любым State: Active, Disabled, Empty или Error. Текущий raw экспорт содержит Skeleton=True только для Active; это разрыв каталога, а не запрет остальных комбинаций."
      },
      {
        "ruleId": "component:web-corp.content-card-wrapper.skeleton-full-card",
