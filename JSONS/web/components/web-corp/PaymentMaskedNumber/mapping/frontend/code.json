{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/payment-masked-number",
  "version": "80.10.0",
  "component": "PaymentMaskedNumber",
  "exports": [
    "PaymentMaskedNumber"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный className"
    },
    {
      "name": "hideNumber",
      "type": "boolean",
      "description": "Скрытие основной части"
    },
    {
      "name": "number",
      "type": "string",
      "required": true,
      "description": "Номер для маскирования"
    },
    {
      "name": "rightAddon",
      "type": "ReactNode",
      "description": "Слот справа от номера"
    },
    {
      "name": "rightAddonClassName",
      "type": "string",
      "description": "Дополнительный className для rightAddon"
    },
    {
      "name": "type",
      "type": "\"card\" | \"account\"",
      "values": [
        "card",
        "account"
      ],
      "required": true,
      "description": "Тип номера"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
