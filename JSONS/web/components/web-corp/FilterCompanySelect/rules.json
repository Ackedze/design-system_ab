        "ruleId": "component:web-corp.filter-company-select.visuals-follow-effective-baseline",
        "severity": "error",
        "source": "owner-confirmed",
        "appliesTo": "fill|stroke|styles.text|radius|effects.*|layout.height|layout.padding|layout.gap",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "ruleText": "Сравнивай визуальные и внутренние layout-параметры с effective baseline выбранного root, View и nested state. Ручные цвета, типографика, радиусы, тени, высота, padding и gap запрещены; подтверждённая ручная ширина остаётся разрешённым исключением.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 1
        }
      },
      {
        "ruleId": "component:web-corp.filter-company-select.root-visuals-follow-effective-baseline",
        "severity": "error",
        "source": "owner-confirmed",
        "appliesTo": "fill|stroke|radius|opacity|layout.height|layout.padding|layout.gap",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "ruleText": "Высота, внутренние отступы, gap и оформление корня FilterCompanySelect должны совпадать с effective baseline. Ручная ширина корня остаётся разрешённой.",
        "ruleKind": "design-rule",
        "authority": {
          "status": "active",
          "provenance": "design-system-author",
          "revision": 1
        },
        "predicateContour": {
          "schemaVersion": "apollo.contour-definition.v1",
          "kind": "baseline-set",
          "select": {
            "from": "selection-root",
            "traverse": "self-and-descendants",
            "where": [
              { "predicate": "equals", "actual": { "fact": "type" }, "expected": { "literal": "INSTANCE" } },
              { "predicate": "equals", "actual": { "fact": "component.identity" }, "expected": { "literal": "web-corp.filter-company-select" } },
              { "predicate": "one-of", "actual": { "fact": "component.family" }, "expected": { "literal": ["filter-company-select-multi", "filter-company-select-single"] } },
              { "predicate": "equals", "actual": { "fact": "ownership.contour.isRoot" }, "expected": { "literal": true } }
            ]
          },
          "paths": [
            { "suffix": "height", "label": "Высота", "actualFact": "height", "baselineFact": "baseline.effective.height" },
            { "suffix": "padding-top", "label": "Верхний padding", "actualFact": "layout.padding.top", "baselineFact": "baseline.effective.layout.padding.top" },
            { "suffix": "padding-right", "label": "Правый padding", "actualFact": "layout.padding.right", "baselineFact": "baseline.effective.layout.padding.right" },
            { "suffix": "padding-bottom", "label": "Нижний padding", "actualFact": "layout.padding.bottom", "baselineFact": "baseline.effective.layout.padding.bottom" },
            { "suffix": "padding-left", "label": "Левый padding", "actualFact": "layout.padding.left", "baselineFact": "baseline.effective.layout.padding.left" },
            { "suffix": "item-spacing", "label": "Расстояние между элементами", "actualFact": "layout.itemSpacing", "baselineFact": "baseline.effective.layout.itemSpacing" },
            { "suffix": "fill", "label": "Заливка", "actualFact": "appearance.fill.value", "baselineFact": "baseline.effective.appearance.fill.value" },
            { "suffix": "stroke", "label": "Обводка", "actualFact": "appearance.stroke.value", "baselineFact": "baseline.effective.appearance.stroke.value" },
            { "suffix": "radius", "label": "Скругление", "actualFact": "appearance.radius", "baselineFact": "baseline.effective.appearance.radius" },
            { "suffix": "opacity", "label": "Прозрачность", "actualFact": "appearance.opacity", "baselineFact": "baseline.effective.appearance.opacity" }
          ],
          "presentation": {
            "schemaVersion": "apollo.predicate-presentation.v1",
            "title": "Изменено свойство корня FilterCompanySelect: {{property}}",
            "observed": "Свойство «{{property}}» изменено с {{expected}} на {{actual}}.",
            "expectation": "Свойство «{{property}}» корня должно совпадать с effective baseline выбранного View и state.",
            "action": "Сбросить свойство «{{property}}» к effective baseline FilterCompanySelect."
          },
          "scope": { "platform": ["desktop"] },
          "unknownPolicy": "not-evaluable"
        }
      },
      {
