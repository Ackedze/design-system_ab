{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/banner-wrapper-mobile",
  "version": "80.10.0",
  "component": "BannerWrapperMobile",
  "exports": [
    "BannerWrapperMobile"
  ],
  "props": [
    {
      "name": "bottomButtonDisabled",
      "type": "boolean",
      "default": "false",
      "description": "Отключает возможность клика для нижней кнопки"
    },
    {
      "name": "bottomButtonLabel",
      "type": "string",
      "default": "Label",
      "description": "Надпись для нижней кнопки"
    },
    {
      "name": "bottomButtonLoading",
      "type": "boolean",
      "default": "false",
      "description": "Состояние загрузки для нижней кнопки"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "mainIcon",
      "type": "ReactNode",
      "description": "Главная иконка"
    },
    {
      "name": "onBottomButtonClick",
      "type": "() => void",
      "description": "Обработчик клика для нижней кнопки"
    },
    {
      "name": "rightIconElement",
      "type": "ReactNode",
      "description": "Элемент для правого верхнего слота"
    },
    {
      "name": "showBottomButton",
      "type": "boolean",
      "default": "true",
      "description": "Показывать ли нижнюю кнопку"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
