    {
      "area": "api",
      "topic": "publicBoundary",
      "body": {
        "publicComponents": [
          {
            "name": "[D] AccountOptionListContent ",
            "platform": "desktop"
          },
          {
            "name": "[M] AccountOptionListContent ",
            "platform": "mobile-web"
          }
        ],
        "otherFamilyComponents": "internal-only",
        "standaloneUseOfInternalComponentsAllowed": false
      }
    },
    {
      "area": "api",
      "topic": "selectionPolicy",
      "body": {
        "SelectType": {
          "Single": "Выбор только одного счёта.",
          "Multi": "Выбор нескольких счетов через Checkbox без ограничения количества."
        }
      }
    },
    {
      "area": "api",
      "topic": "groupingPolicy",
      "body": {
        "GroupedFalse": "Плоский список счетов.",
        "GroupedTrue": "Счета объединяются по критерию, выбранному продуктовой командой.",
        "defaultCriterion": "Принадлежность к компании.",
        "customCriterionAllowed": true,
        "groupsCollapsible": true,
        "defaultExpandedState": "all-expanded",
        "defaultHeaderText": "Название компании.",
        "customHeaderTextAllowed": true,
        "groupOrderChangeAllowed": false
      }
    },
    {
      "area": "api",
      "topic": "selectionControlPolicy",
      "body": {
        "Single": {
          "control": "checkmark",
          "position": "right",
          "hideAllowed": false,
          "replaceAllowed": false
        },
        "Multi": {
          "control": "checkbox",
          "position": "left",
          "hideAllowed": false,
          "replaceAllowed": false
        }
      }
    },
    {
      "area": "api",
      "topic": "disabledAccountPolicy",
      "body": {
        "interactive": false,
        "hoverTooltip": {
          "required": true,
          "view": "hint",
          "content": "Короткая причина недоступности счёта."
        },
        "Multi": {
          "Checkbox.DisabledState": true,
          "Amount.color": "text/tertiary",
          "PaymentMaskedNumber.color": "text/tertiary",
          "AccountInfo.color": "text/tertiary"
        },
        "Single": {
          "Amount.color": "text/tertiary",
          "PaymentMaskedNumber.color": "text/tertiary",
          "AccountInfo.color": "text/tertiary"
        }
      }
    },
    {
      "area": "api",
      "topic": "mediaPolicy",
      "body": {
        "default": "none",
        "modes": [
          "none",
          "IconView",
          "CardImage"
        ],
        "mutuallyExclusive": true,
        "uniformWithinList": true,
        "IconView": {
          "usedByDefault": false,
          "allowedWhen": "Нужно показать иконку типа счёта."
        },
        "CardImage": {
          "allowedWhen": "Выбор карточного счёта."
        }
      }
    },
    {
      "area": "api",
      "topic": "statusBadgePolicy",
      "body": {
        "usage": "contextual",
        "semanticsDefined": false
      }
    },
    {
      "area": "api",
      "topic": "selectionCommitPolicy",
      "body": {
        "Single": "После выбора счёта список закрывается сразу.",
        "Multi": "Выбор подтверждается отдельной кнопкой «Применить»."
      }
    },
    {
      "area": "api",
      "topic": "selectedStatePolicy",
      "body": {
        "Single": "Checkmark.SelectedState=true.",
        "Multi": "Checkbox принимает checked-состояние.",
        "disabledAccountCanBeSelected": false
      }
    },
    {
      "area": "api",
      "topic": "itemOrderPolicy",
      "body": {
        "designerReorderAllowed": false,
        "sortingPrinciple": "Определяется контекстом: алфавитный порядок, возрастание или убывание значений."
      }
    },
    {
      "area": "api",
      "topic": "listViewportPolicy",
      "body": {
        "desktop": {
          "height": "5.5 two-line OptionListItem",
          "multiSelectionButtonBlockIncluded": false,
          "overflow": "vertical-scroll"
        },
        "mobile-web": {
          "heightLimit": "none"
        }
      }
    },
    {
      "area": "api",
      "topic": "statePolicy",
      "body": {
        "loading": "not-defined",
        "empty": {
          "desktop": "[D] OptionListEmptyState without buttons",
          "mobile-web": "[M] OptionListEmptyState without buttons"
        },
        "noResults": {
          "desktop": "[D] OptionListEmptyState without buttons",
          "mobile-web": "[M] OptionListEmptyState without buttons"
        },
        "emptyStateTextEditable": false
      }
    },
    {
      "area": "api",
      "topic": "searchPolicy",
      "body": {
        "recommendedFromAccountCount": 10,
        "components": {
          "desktop": "[D] OptionListHeader",
          "mobile-web": "[M] OptionListHeader"
        },
        "Preset": "Search",
        "selectionModes": [
          "Single",
          "Multi"
        ],
        "searchScope": "Определяется продуктовой командой.",
        "placeholderMustDescribeSearchScope": true,
        "requirement": "recommendation"
      }
    },
    {
      "area": "api",
      "topic": "multiFooterPolicy",
      "body": {
        "desktopComponent": "[D] OptionListFooter",
        "mobileComponent": "[M] BottomSheetFooter",
        "Primary": {
          "label": "Применить",
          "required": true,
          "alwaysEnabled": true,
          "zeroExplicitSelectionMeaning": "all available accounts"
        },
        "Secondary": {
          "label": "Сбросить",
          "visibleWhen": "Выбор уже был сделан.",
          "action": "Очистить выбор до нулевого состояния.",
          "hideAfterReset": true
        },
        "otherButtonsAllowed": false
      }
    },
    {
      "area": "api",
      "topic": "listConsistencyPolicy",
      "body": {
        "uniformAccountItemType": true,
        "uniformAccountInfoPreset": true
      }
    },
    {
      "area": "api",
      "topic": "selectAllPolicy",
      "body": {
        "components": {
          "desktop": "[D] OptionListHeader",
          "mobile-web": "[M] OptionListHeader"
        },
        "Preset": "Select All",
        "scope": "all-list",
        "requiredForMultiFromItemCount": 10,
        "disabledAccountsIncluded": false,
        "labelMutable": false,
        "states": {
          "noneSelected": {
            "IndeterminateState": false,
            "SelectedState": false,
            "clickAction": "select all available accounts"
          },
          "partiallySelected": {
            "IndeterminateState": true,
            "SelectedState": false,
            "clickAction": "select all available accounts"
          },
          "allAvailableSelected": {
            "IndeterminateState": false,
            "SelectedState": true,
            "clickAction": "clear all selection"
          }
        }
      }
    },
    {
      "area": "api",
      "topic": "headerStackPolicy",
      "body": {
        "whenSearchAndSelectAllArePresent": [
          "Search",
          "Select All"
        ],
        "direction": "vertical"
      }
    },
    {
      "area": "api",
      "topic": "platformContainerPolicy",
      "body": {
        "desktop": "OptionList",
        "mobile-web": "BottomSheet"
      }
    },
    {
      "area": "api",
      "topic": "visualBaselinePolicy",
      "body": {
        "manualGeometryChangesAllowed": false,
        "manualVisualStyleChangesAllowed": false,
        "properties": [
          "height",
          "padding",
          "gap",
          "radius",
          "fill",
          "hover",
          "selected"
        ],
        "baseline": "effective baseline"
      }
    },
    {
      "area": "api",
      "topic": "textOverflowPolicy",
      "body": {
        "source": "OptionListCell",
        "localRulesDefined": false
      }
    },
    {
      "area": "api",
      "topic": "accountItemPolicy",
      "body": {
        "Type": {
          "SwapMe": {
            "status": "placeholder",
            "allowedInFinalDesign": false,
            "description": "Значение по умолчанию, которое требует выбрать осмысленную композицию."
          },
          "Sum": {
            "status": "allowed",
            "description": "Баланс счёта занимает главную позицию; название и короткий номер отображаются в подстрочнике.",
            "contentComponent": "AccountInfo / Sum"
          },
          "Number": {
            "status": "allowed",
            "description": "Полный номер счёта занимает главную позицию; название отображается в подстрочнике.",
            "contentComponent": "AccountInfo / Number"
          },
          "❌ Number": {
            "status": "legacy",
            "allowedInFinalDesign": false,
            "description": "Устаревший запрещённый вариант."
          }
        }
      }
    },
    {
      "area": "api",
      "topic": "accountInfoPolicy",
      "body": {
        "AccountInfo / Number": {
          "usedWith": "AccountItem.Type=Number",
          "presets": {
            "name": [
              "название счёта"
            ],
            "name + sum": [
              "название счёта",
              "баланс"
            ]
          }
        },
        "AccountInfo / Sum": {
          "usedWith": "AccountItem.Type=Sum",
          "presets": {
            "name": [
              "название счёта"
            ],
            "number": [
              "полный номер счёта"
            ],
            "name + maskedNumber": [
              "название счёта",
              "короткий номер счёта"
            ],
            "name + number": [
              "название счёта",
              "полный номер счёта"
            ]
          }
        },
        "presetSelection": "Preset выбирается по контексту и требуемому составу данных.",
        "manualValueHidingAllowed": false
      }
    },
    {
      "area": "api",
      "topic": "forbiddenUsage",
      "body": [
        "standalone AccountOptionCell",
        "standalone AccountOptionCells",
        "standalone GroupedAccountOptionCell",
        "standalone AccountInfo",
        "standalone AccountItem",
        "AccountItem.Type=SwapMe in final design",
        "AccountItem.Type=❌ Number",
        "changing group order",
        "hiding or replacing selection controls",
        "manually hiding values defined by AccountInfo preset",
        "clickable disabled account",
        "disabled account without reason tooltip",
        "mixing IconView and CardImage in one list",
        "different media modes within one list",
        "selected disabled account",
        "manual item reorder",
        "manual row geometry or visual style changes",
        "mixed AccountItem.Type within one list",
        "mixed AccountInfo preset within one list",
        "mobile AccountSelect outside BottomSheet",
        "desktop AccountSelect outside OptionList"
      ]
    },
