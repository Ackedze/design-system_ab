{
  "$schema": "hub/facet.semantics@1",
  "summary": "AccountSelect — семейство компонентов для одиночного или множественного выбора счетов. Публичными точками использования являются только [D] AccountOptionListContent и [M] AccountOptionListContent; остальные компоненты семейства являются служебными.",
  "guidance": [
    {
      "area": "usage",
      "topic": "componentPolicy",
      "body": {
        "publicRoots": [
          "[D] AccountOptionListContent ",
          "[M] AccountOptionListContent "
        ],
        "selection": "Single выбирает один счёт; Multi позволяет выбрать несколько счетов без ограничения количества.",
        "grouping": "Grouped=True группирует счета по контекстному критерию. По умолчанию — по принадлежности к компании. Все группы раскрыты, пользователь может сворачивать их по отдельности. Заголовок по умолчанию содержит название компании; порядок групп менять нельзя.",
        "selectionControls": "В Single checkmark всегда расположен справа, в Multi Checkbox всегда расположен слева. Скрывать, заменять и переносить эти контролы нельзя.",
        "disabledAccount": "Недоступный счёт не кликабелен. При наведении показывается Tooltip View=Hint с короткой причиной. Amount, PaymentMaskedNumber и AccountInfo используют text/tertiary; в Multi Checkbox принимает DisabledState.",
        "media": "CardImage используется для выбора карточного счёта, IconView — для иконки типа счёта. В одном списке используется только один единый режим: CardImage, IconView или без медиа-аддона.",
        "selectionCommit": "В Single список закрывается сразу после выбора. В Multi выбор подтверждается кнопкой «Применить».",
        "selectedState": "В Single выбранный счёт использует Checkmark.SelectedState=true, в Multi — checked-состояние Checkbox. Недоступный счёт не может быть выбран.",
        "itemOrder": "Дизайнер не меняет порядок счетов вручную. Принцип сортировки определяется контекстом: алфавитный порядок, возрастание или убывание значений.",
        "listViewport": "На desktop высота списка равна 5.5 двухстрочных OptionListItem; блок кнопок Multi не входит в эту высоту, переполнение прокручивается вертикально. На Mobile Web ограничения высоты нет.",
        "states": "Loading-state пока не определён. Для пустого списка и отсутствия результатов используется OptionListEmptyState без кнопок: [D] на desktop и [M] на Mobile Web. Текст empty-state фиксирован и не редактируется.",
        "search": "Для списка из 10 и более счетов рекомендуется поиск в Single и Multi через OptionListHeader Preset=Search: [D] на desktop и [M] на Mobile Web. Контекст поиска определяет команда; placeholder обязан отражать доступные критерии поиска.",
        "multiFooter": "Для Multi на desktop используется [D] OptionListFooter, на Mobile Web — [M] BottomSheetFooter. Primary «Применить» всегда отображается и активна; нулевой явный выбор означает применение ко всем доступным счетам. Secondary «Сбросить» появляется после сделанного выбора, очищает выбор до нуля и скрывается. Других кнопок нет.",
        "listConsistency": "Все строки одного списка используют одинаковые AccountItem.Type и AccountInfo preset.",
        "selectAll": "В Multi с 10 и более элементами Select All обязателен. Используется OptionListHeader Preset=Select All: [D] на desktop и [M] на Mobile Web. Текст фиксирован. При нулевом выборе Checkbox: IndeterminateState=false, SelectedState=false; клик выбирает все доступные счета. При частичном выборе: IndeterminateState=true, SelectedState=false; клик выбирает все доступные. Когда выбраны все доступные: IndeterminateState=false, SelectedState=true; клик сбрасывает весь выбор. Disabled-счета пропускаются.",
        "headerStack": "Если одновременно нужны Search и Select All, Header располагаются вертикально: сначала Search, затем Select All.",
        "platformContainers": "[D] AccountSelect открывается в OptionList, [M] AccountSelect — в BottomSheet.",
        "visualBaseline": "Высота, padding, gap, radius, fill, hover, selected и другие геометрические или визуальные параметры строк нельзя менять вручную; они следуют effective baseline.",
        "statusBadge": "Применение пока не регламентировано и определяется контекстом.",
        "textOverflow": "Ограничения длинного текста определяются общими правилами OptionListCell.",
        "accountItemTypes": {
          "SwapMe": "Placeholder, который нужно заменить.",
          "Sum": "Баланс занимает главную позицию; название и короткий номер находятся в подстрочнике.",
          "Number": "Полный номер счёта занимает главную позицию; название находится в подстрочнике.",
          "❌ Number": "Legacy-вариант, использовать запрещено."
        },
        "accountInfoBinding": {
          "Sum": "AccountInfo / Sum",
          "Number": "AccountInfo / Number"
        },
        "presets": {
          "AccountInfo / Sum": {
            "name": "только название счёта",
            "number": "только полный номер счёта",
            "name + maskedNumber": "название и короткий номер счёта",
            "name + number": "название и полный номер счёта"
          },
          "AccountInfo / Number": {
            "name": "только название счёта",
            "name + sum": "название счёта и баланс"
          },
          "manualValueHidingAllowed": false
        }
      }
    },
