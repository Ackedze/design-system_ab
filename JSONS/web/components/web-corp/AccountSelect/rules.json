  "manual": {
    "rules": [
      {
        "ruleId": "component:web-corp.account-select.lifecycle-context-is-informational",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "component.status",
        "checkType": "manual",
        "ruleText": "Lifecycle status компонента является контекстом для агента. Не считай его дизайн-нарушением, если не найден отдельный pattern или exact design rule."
      },
      {
        "ruleId": "component:web-corp.account-select.public-roots-only",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.composition",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "allowedRoots": [
          "[D] AccountOptionListContent ",
          "[M] AccountOptionListContent "
        ],
        "ruleText": "Дизайнер должен использовать только [D] AccountOptionListContent или [M] AccountOptionListContent. Остальные компоненты семейства AccountSelect являются служебными и не используются отдельно."
      },
      {
        "ruleId": "component:web-corp.account-select.selection-type-semantics",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "variant.SelectType",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "semantics": {
          "Single": "Выбор одного счёта.",
          "Multi": "Выбор нескольких счетов через Checkbox."
        },
        "ruleText": "SelectType=Single используется для выбора одного счёта. SelectType=Multi используется для множественного выбора через Checkbox."
      },
      {
        "ruleId": "component:web-corp.account-select.multi-selection-has-no-limit",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "variant.SelectType|component.interaction",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "ruleText": "Для SelectType=Multi компонент не задаёт максимальное количество выбранных счетов."
      },
      {
        "ruleId": "component:web-corp.account-select.grouping-criterion-is-contextual",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "variant.Grouped|component.composition",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "defaultCriterion": "company ownership",
        "ruleText": "Grouped=True объединяет счета по критерию продуктовой команды. По умолчанию используется принадлежность к компании, но допустим другой контекстный критерий."
      },
      {
        "ruleId": "component:web-corp.account-select.swap-me-must-be-replaced",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "variant.Type",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "forbiddenState": {
          "AccountItem.Type": "SwapMe"
        },
        "ruleText": "AccountItem.Type=SwapMe является placeholder и должен быть заменён на Sum или Number до завершения макета."
      },
      {
        "ruleId": "component:web-corp.account-select.legacy-number-forbidden",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "variant.Type",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "forbiddenState": {
          "AccountItem.Type": "❌ Number"
        },
        "ruleText": "AccountItem.Type=❌ Number является legacy-вариантом и запрещён к использованию."
      },
      {
        "ruleId": "component:web-corp.account-select.account-info-follows-item-type",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "variant.Type|variant.Presets|component.composition",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "requiredBinding": {
          "Sum": "AccountInfo / Sum",
          "Number": "AccountInfo / Number"
        },
        "ruleText": "AccountItem.Type=Sum должен использовать AccountInfo / Sum, а AccountItem.Type=Number — AccountInfo / Number. Preset внутри соответствующего AccountInfo выбирается по контексту и доступным данным."
      },
      {
        "ruleId": "component:web-corp.account-select.grouped-list-defaults-expanded",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "variant.Grouped|component.interaction",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "ruleText": "При Grouped=True пользователь может сворачивать отдельные группы. По умолчанию все группы раскрыты."
      },
      {
        "ruleId": "component:web-corp.account-select.group-header-follows-criterion",
        "severity": "info",
        "source": "component-contract",
        "appliesTo": "variant.Grouped|text.groupHeader",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "ruleText": "По умолчанию заголовок группы содержит название компании. При другом критерии группировки допустим соответствующий ему текст."
      },
      {
        "ruleId": "component:web-corp.account-select.group-order-is-fixed",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.order",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "ruleText": "Порядок групп в AccountSelect менять нельзя."
      },
      {
        "ruleId": "component:web-corp.account-select.selection-controls-are-fixed",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "component.composition|component.visibility",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "requiredControls": {
          "Single": {
            "control": "checkmark",
            "position": "right"
          },
          "Multi": {
            "control": "checkbox",
            "position": "left"
          }
        },
        "ruleText": "В Single checkmark всегда расположен справа, а в Multi Checkbox всегда расположен слева. Эти контролы нельзя скрывать, заменять или переносить."
      },
      {
        "ruleId": "component:web-corp.account-select.card-image-only-for-card-account",
        "severity": "warning",
        "source": "component-contract",
        "appliesTo": "component.media",
        "checkType": "manual",
        "matchKind": "exact_component_rule",
        "ruleText": "CardImage используется только при выборе карточного счёта. По умолчанию AccountSelect не использует IconView."
      },
      {
        "ruleId": "component:web-corp.account-select.account-info-preset-defines-visible-values",
        "severity": "error",
        "source": "component-contract",
        "appliesTo": "variant.Presets|component.visibility",
        "checkType": "deterministic",
        "matchKind": "exact_component_rule",
        "presetValues": {
          "AccountInfo / Sum": {
            "name": [
              "название счёта"
            ],
            "number": [
              "полный номер счёта"
            ],
            "name + maskedNumber": [
              "название счёта",
              "короткий номер счёта"
            ],
            "name + number": [
              "название счёта",
              "полный номер счёта"
            ]
          },
          "AccountInfo / Number": {
            "name": [
              "название счёта"
            ],
            "name + sum": [
              "название счёта",
              "баланс"
            ]
          }
        },
        "ruleText": "Состав отображаемых значений определяется preset компонента AccountInfo. Значения, предусмотренные выбранным preset, нельзя скрывать вручную."
      }
    ]
  }
