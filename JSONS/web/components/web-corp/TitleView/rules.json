{
  "schemaVersion": 1,
  "documentType": "component-rules",
  "componentKey": "web-corp.title-view",
  "status": "draft",
  "rules": [
    {
      "id": "component:web-corp.title-view.component-properties",
      "title": "TitleView component properties must be audited as component parameters",
      "matchKind": "exact_rule",
      "severity": "medium",
      "selector": {
        "componentNames": [
          "[D] RightAddon",
          "[D] RightAddonXL",
          "[D] TitleAddon",
          "[D] TitleAddonXL",
          "[D] TitleStatus",
          "[D] TitleView",
          "[M] RightAddon",
          "[M] RightAddonXL",
          "[M] TitleAddon",
          "[M] TitleAddonXL",
          "[M] TitleStatus",
          "[M] TitleView"
        ],
        "propertyPrefix": "variant."
      },
      "rule": "Variant/property changes on the component instance are component-property customizations. Do not convert them into unrelated paint or layout findings."
    },
    {
      "id": "component:web-corp.title-view.layer-properties",
      "title": "TitleView layer properties must use effective baseline",
      "matchKind": "exact_rule",
      "severity": "medium",
      "selector": {
        "componentNames": [
          "[D] RightAddon",
          "[D] RightAddonXL",
          "[D] TitleAddon",
          "[D] TitleAddonXL",
          "[D] TitleStatus",
          "[D] TitleView",
          "[M] RightAddon",
          "[M] RightAddonXL",
          "[M] TitleAddon",
          "[M] TitleAddonXL",
          "[M] TitleStatus",
          "[M] TitleView"
        ],
        "properties": [
          "layout.itemSpacing",
          "layout.padding.*",
          "styles.text",
          "styles.fill",
          "styles.stroke",
          "fill",
          "stroke",
          "radius",
          "opacity"
        ]
      },
      "rule": "Layer/style changes must be compared against the effective baseline for the current component variant and nested owner context."
    }
  ]
}
