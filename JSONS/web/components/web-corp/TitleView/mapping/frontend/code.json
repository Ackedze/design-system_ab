{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/title-view",
  "version": "80.10.0",
  "component": "TitleView",
  "exports": [
    "TitleView"
  ],
  "props": [
    {
      "name": "buttonsGroup",
      "type": "ReactElement<unknown, string | JSXElementConstructor<any>>[]",
      "description": "Группа кнопок"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "color",
      "type": "\"link\" | \"disabled\" | \"primary\" | \"secondary\" | \"tertiary\" | \"accent\" | \"attention\" | \"positive\" | \"tertiary-inverted\" | \"primary-inverted\" | \"secondary-inverted\" | \"negative\" | ... 7 more ... | \"static-positive\"",
      "values": [
        "link",
        "disabled",
        "primary",
        "secondary",
        "tertiary",
        "accent",
        "attention",
        "positive",
        "tertiary-inverted",
        "primary-inverted",
        "secondary-inverted",
        "negative",
        "static-primary-light",
        "static-secondary-light",
        "static-tertiary-light",
        "static-primary-dark",
        "static-secondary-dark",
        "static-tertiary-dark",
        "static-accent",
        "static-positive"
      ],
      "description": "Цвет текста"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования\nId компонента для тестов"
    },
    {
      "name": "defaultMargins",
      "type": "boolean",
      "description": "Добавляет отступы"
    },
    {
      "name": "defaultMatchMediaValue",
      "type": "boolean | (() => boolean)",
      "description": "Значение по-умолчанию для хука useMatchMedia"
    },
    {
      "name": "filterCompanySelectProps",
      "type": "FilterCompanySelectProps",
      "description": "Свойства компонента FilterCompanySelect"
    },
    {
      "name": "maxVisibleButtons",
      "type": "number",
      "description": "Максимальное количество отображаемых кнопок"
    },
    {
      "name": "pickerButtonProps",
      "type": "Omit<PickerButtonResponsiveProps, \"view\" | \"className\" | \"size\" | \"options\" | \"optionClassName\" | \"preventFlip\" | \"variant\">",
      "description": "Свойства для компонента PickerButton, который появляется при схлопывании Buttons"
    },
    {
      "name": "rightAddon",
      "type": "ReactNode",
      "description": "Слот для правого аддона"
    },
    {
      "name": "rowLimit",
      "type": "2 | 1 | 3",
      "values": [
        2,
        1,
        3
      ],
      "description": "Количество строк"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "description": "Флаг отображения скелетона во всех слотах"
    },
    {
      "name": "skeletonConfig",
      "type": "Partial<Record<\"title\" | \"status\" | \"subtitle\" | \"buttonsGroup\" | \"filterCompanySelect\" | \"titleStatus\", boolean>>",
      "description": "Точечное управление скелетонами отдельных слотов.\nЗначение слота имеет приоритет над showSkeleton"
    },
    {
      "name": "skeletonProps",
      "type": "TextSkeletonProps",
      "description": "Пропы для скелетона"
    },
    {
      "name": "statusProps",
      "type": "StatusProps",
      "description": "Свойства статуса"
    },
    {
      "name": "subtitle",
      "type": "ReactNode",
      "description": "Подзаголовок"
    },
    {
      "name": "tag",
      "type": "\"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\" | \"div\"",
      "values": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "div"
      ],
      "required": true,
      "description": "HTML тег"
    },
    {
      "name": "titleAddon",
      "type": "ReactNode",
      "description": "Слот для аддона в заголовке"
    },
    {
      "name": "titleComponentClassName",
      "type": "string",
      "description": "Дополнительный класс для заголовка"
    },
    {
      "name": "titleStatusProps",
      "type": "TitleStatusProps",
      "description": "Свойства статуса"
    },
    {
      "name": "titleWrapperClassName",
      "type": "string",
      "description": "Дополнительный класс для обертки заголовка"
    },
    {
      "name": "view",
      "type": "VIEWS",
      "values": [
        "xlarge",
        "large",
        "medium",
        "small"
      ],
      "required": true,
      "description": "Варианты отображения"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
