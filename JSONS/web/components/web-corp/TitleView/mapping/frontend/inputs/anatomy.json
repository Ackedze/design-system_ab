          "rule": "corp.title-view#button-size-mobile",
          "op": "propertyDomain",
          "property": "Size",
          "values": [
            "48"
          ],
          "message": "Button внутри [M] TitleView должен использовать Size=48",
          "expectation": "Кнопки внутри [M] TitleView должны использовать Size=48.",
          "action": "Установить кнопке Size=48."
        }
      ]
    }
