{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/card-image",
  "version": "80.10.0",
  "component": "CardImage",
  "exports": [
    "CardImage"
  ],
  "props": [
    {
      "name": "accountNumber",
      "type": "string | number",
      "description": "Номер счета"
    },
    {
      "name": "baseUrl",
      "type": "string",
      "default": "https://online.alfabank.ru/cards-images/cards/",
      "description": "Базовый URL сервиса с изображениями"
    },
    {
      "name": "cardholderName",
      "type": "string | number",
      "description": "Имя владельца банковской карты"
    },
    {
      "name": "cardId",
      "type": "string",
      "description": "Идентификатор карты\n(например: ER, GQ, SU)"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "id",
      "type": "string",
      "description": "Уникальный идентификатор блока"
    },
    {
      "name": "layers",
      "type": "string",
      "default": "BACKGROUND,CARD_NUMBER,CARD_HOLDER,PAY_PASS,CHIP,LOGO,PAYMENT_SYSTEM,RESERVED_1,RESERVED_2,VALID_DATE",
      "description": "Какие слои показывать, через запятую без пробелов\n(полный набор: BACKGROUND,CARD_NUMBER,CARD_HOLDER,PAY_PASS,CHIP,LOGO,PAYMENT_SYSTEM,RESERVED_1,RESERVED_2,VALID_DATE)"
    },
    {
      "name": "mode",
      "type": "Mode",
      "values": [
        "default",
        "status"
      ],
      "default": "default",
      "description": "Свойсто для переключения режимов компонента"
    },
    {
      "name": "modeIcon",
      "type": "ReactNode",
      "description": "Иконка при режиме компонента status"
    },
    {
      "name": "onClick",
      "type": "(() => void) & MouseEventHandler<HTMLImageElement>",
      "description": "Обработчик события клика"
    },
    {
      "name": "onLoad",
      "type": "(() => void) & ReactEventHandler<HTMLImageElement>",
      "description": "Колбек, вызываемый при загрузке изображения"
    },
    {
      "name": "shadow",
      "type": "boolean",
      "default": "true",
      "description": "Добавляет свойство box-shadow для компонента"
    },
    {
      "name": "showGradientLine",
      "type": "boolean",
      "default": "false",
      "description": "Показать полоску"
    },
    {
      "name": "size",
      "type": "Size",
      "values": [
        24,
        "xxl",
        "xl",
        "l",
        "m",
        "s",
        "xs",
        44,
        68,
        212,
        264,
        300
      ],
      "default": "STRING_SIZE_TO_NUMBER.xl",
      "description": "Размер\n@description xxl, xl, l, m, s, xs deprecated, используйте вместо них 24, 44, 68, 212, 264, 300 соответственно"
    },
    {
      "name": "stacked",
      "type": "boolean",
      "default": "false",
      "description": "Свойство, которое включает колоду карт"
    },
    {
      "name": "stackText",
      "type": "string",
      "description": "Текст для колоды карт"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
