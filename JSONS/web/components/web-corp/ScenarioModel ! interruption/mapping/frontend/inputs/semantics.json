  "patternRefs": [
    "interruption-scenario"
  ],
  "guidance": [
    {
      "area": "usage",
      "topic": "implementation",
      "body": {
        "figmaOnly": true,
        "codeImplementation": "none",
        "codeConnect": "not-applicable"
      }
    },
    {
      "area": "usage",
      "topic": "textRecipe",
      "body": {
        "recipeId": "recipe:web-corp.scenario-model-interruption.texts",
        "Default": {
          "title": "Выйти без сохранения?",
          "consequenceTemplates": [
            "Придётся [создавать] [сущность] заново",
            "Придётся [вносить изменения] заново"
          ],
          "actions": [
            "Выйти",
            "Остаться"
          ]
        },
        "SaveAs": {
          "title": "Сохранить [сущность]?",
