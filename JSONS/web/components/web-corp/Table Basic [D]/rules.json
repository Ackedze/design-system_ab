{
  "schemaVersion": 1,
  "documentType": "component-rules",
  "componentKey": "web-corp.table-basic-d",
  "status": "draft",
  "applicability": {
    "channels": [
      "b2b"
    ],
    "platforms": [
      "desktop",
      "mobile-web"
    ],
    "source": "path-policy",
    "updatedAt": "2026-07-13"
  },
  "rules": [
    {
      "ruleId": "component:web-corp.table-basic-d.component-properties-are-first-class",
      "severity": "info",
      "source": "component-contract",
      "appliesTo": "variant.*",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.table-basic-d",
        "layers": [
          "[D] BodyActionCell",
          "[D] BodyActionCell :: Basic",
          "[D] BodyCell",
          "[D] BodyCell :: Basic",
          "[D] BodyControlCell",
          "[D] BodyControlCell :: Basic",
          "[D] BodyRow",
          "[D] BodyRow :: Basic",
          "[D] BodyRow :: Core",
          "[D] GroupDivider",
          "[D] GroupDivider :: Basic",
          "[D] HeadActionCell",
          "[D] HeadCell",
          "[D] HeadControlCell",
          "[D] HeadRow",
          "[D] HeadRow :: Core",
          "[D] ListHeaderRow",
          "[D] ListHeaderRow :: Core",
          "🔄 [D] BodyActionCell",
          "🔄 [D] BodyCell",
          "🔄 [D] BodyControlCell",
          "🔄 [D] BodyRow :: Core",
          "🔄 [D] HeadActionCell",
          "🔄 [D] HeadCell",
          "🔄 [D] HeadControlCell",
          "🔄 [D] HeadRow :: Core",
          "🔄 [D] ListHeaderRow :: Core",
          "🔄 Chevron",
          "🔄 HeadControl",
          "🔄 Sorting",
          "🔒 [D] BodyCell",
          "Chevron",
          "Control",
          "Graphics",
          "GraphicsSkeleton",
          "HeadControl",
          "LeftAddon",
          "RightAddon",
          "Sorting",
          "Text"
        ]
      },
      "ruleText": "Изменения variant/property в компонентах семейства таблиц являются component-property customizations. Показывай их отдельно от производных визуальных изменений layer."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.layer-properties-use-effective-baseline",
      "severity": "warning",
      "source": "composition-contract",
      "appliesTo": "layout.*|styles.text|fill|stroke|radius|opacity",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "target": {
        "component": "web-corp.table-basic-d",
        "layers": [
          "[D] BodyActionCell",
          "[D] BodyActionCell :: Basic",
          "[D] BodyCell",
          "[D] BodyCell :: Basic",
          "[D] BodyControlCell",
          "[D] BodyControlCell :: Basic",
          "[D] BodyRow",
          "[D] BodyRow :: Basic",
          "[D] BodyRow :: Core",
          "[D] GroupDivider",
          "[D] GroupDivider :: Basic",
          "[D] HeadActionCell",
          "[D] HeadCell",
          "[D] HeadControlCell",
          "[D] HeadRow",
          "[D] HeadRow :: Core",
          "[D] ListHeaderRow",
          "[D] ListHeaderRow :: Core",
          "🔄 [D] BodyActionCell",
          "🔄 [D] BodyCell",
          "🔄 [D] BodyControlCell",
          "🔄 [D] BodyRow :: Core",
          "🔄 [D] HeadActionCell",
          "🔄 [D] HeadCell",
          "🔄 [D] HeadControlCell",
          "🔄 [D] HeadRow :: Core",
          "🔄 [D] ListHeaderRow :: Core",
          "🔄 Chevron",
          "🔄 HeadControl",
          "🔄 Sorting",
          "🔒 [D] BodyCell",
          "Chevron",
          "Control",
          "Graphics",
          "GraphicsSkeleton",
          "HeadControl",
          "LeftAddon",
          "RightAddon",
          "Sorting",
          "Text"
        ]
      },
      "ruleText": "Изменения layer/style внутри компонентов семейства таблиц нужно сравнивать с effective baseline текущего table variant и nested owner context."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.scheduled-parts-are-legacy",
      "severity": "warning",
      "source": "component-contract",
      "appliesTo": "component.status",
      "checkType": "manual",
      "ruleText": "Компоненты таблиц с префиксом 🔄 относятся к старой версии. Крайне не рекомендуется использовать их в новых макетах; для новой сборки выбирай актуальные компоненты без префикса 🔄."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.background-plate-wrapper-in-content",
      "severity": "error",
      "source": "composition-contract",
      "appliesTo": "screen.composition",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "placement": "CorporateContent body"
      },
      "requiredComposition": {
        "containerComponent": "[D] BackgroundPlateSlot",
        "requiredSiblings": [
          "CorporateTopbar",
          "[D] HeadRow :: Universal",
          "[D] BodyRow :: Basic",
          "Pagination"
        ]
      },
      "ruleText": "Table Basic [D] должна размещаться внутри [D] BackgroundPlateSlot. Обязательная сборка включает CorporateTopbar, [D] HeadRow :: Universal, строки [D] BodyRow :: Basic и Pagination. TableView не является контейнером этой таблицы."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.use-basic-for-simple-table",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.use-basic-for-simple-table",
      "appliesTo": "component.selection",
      "checkType": "llm",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "mode": "basic"
      },
      "requiredUsage": {
        "maxColumns": 5,
        "requiresHorizontalScroll": false,
        "requiresColumnPinning": false
      },
      "ruleText": "Table Basic [D] предназначен для более воздушных таблиц и поддерживает не более 5 столбцов. Если столбцов больше пяти, нужен горизонтальный скролл или группировка, используй Table Wide [D]."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.no-horizontal-scroll",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.no-horizontal-scroll",
      "appliesTo": "component.layout",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]"
      },
      "forbidden": {
        "horizontalScroll": true,
        "paginationScrollbar": true,
        "scrollbarPresetEnabled": true
      },
      "ruleText": "В Table Basic [D] не бывает горизонтального скролла. Не включай Scrollbar в блоке пагинации базовой таблицы."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.no-column-pinning",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.no-column-pinning",
      "appliesTo": "component.behavior",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "area": "column menu"
      },
      "forbidden": {
        "pinColumnAction": true,
        "menuItem": "Закрепить столбец",
        "menuItemEn": "Pin column"
      },
      "ruleText": "В Table Basic [D] недоступна функция закрепления столбца. В меню колонки не должно быть действия Закрепить столбец / Pin column."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.no-column-grouping",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.no-column-grouping",
      "appliesTo": "component.behavior",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "area": "table settings"
      },
      "forbidden": {
        "columnGrouping": true,
        "groupByColumnControl": true,
        "settingsItem": "Группировать"
      },
      "ruleText": "В Table Basic [D] не реализован функционал группировки по столбцам. Не показывай управление Группировать для столбцов в настройках базовой таблицы."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.group-rows-with-groupbar",
      "severity": "warning",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.group-rows-with-groupbar",
      "appliesTo": "component.composition",
      "checkType": "llm",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "rowGrouping": true
      },
      "requiredComposition": {
        "groupComponent": "[D] GroupDivider :: Basic",
        "alias": "GroupBar"
      },
      "requiredContent": {
        "dateDivider": "day and month",
        "companyDivider": "company or counterparty name"
      },
      "ruleText": "Для группировки строк в Table Basic [D] используй GroupBar / [D] GroupDivider :: Basic. Для даты пиши день и месяц, для компании - название компании или контрагента."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.column-settings-chevron-visible",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.column-settings-chevron-visible",
      "appliesTo": "component.visibility",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "cell": "[D] HeadCell",
        "requiredLayer": "Chevron"
      },
      "requiredState": {
        "visible": true,
        "opacity": 1,
        "removed": false
      },
      "forbidden": {
        "hiddenChevron": true,
        "detachedChevron": true,
        "zeroOpacityChevron": true
      },
      "ruleText": "В каждом столбце Table Basic [D] должен быть видимый шеврон настроек. Шеврон нельзя скрывать, удалять или делать прозрачным."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.keep-control-and-action-cells",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.keep-control-and-action-cells",
      "appliesTo": "component.composition",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "rows": [
          "[D] HeadRow",
          "[D] BodyRow :: Basic"
        ]
      },
      "requiredLayers": [
        "[D] HeadControlCell",
        "[D] HeadActionCell",
        "[D] BodyControlCell :: Basic",
        "[D] BodyActionCell :: Basic"
      ],
      "allowedDisabledState": {
        "headControlCellPreset": "None",
        "headActionCellPreset": "None",
        "bodyControlCellPreset": "None",
        "bodyActionCellPreset": "None"
      },
      "forbidden": {
        "removedControlCell": true,
        "removedActionCell": true,
        "deletedEdgeCellsInsteadOfPresetNone": true
      },
      "ruleText": "Не удаляй ControlCell и ActionCell из шапки и строк Table Basic [D]. Если чекбоксы или действия не нужны, выбирай preset None в соответствующих Head/Body ControlCell и ActionCell."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.reset-all-restores-baseline",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.reset-all-restores-baseline",
      "appliesTo": "component.behavior",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "action": "Сбросить все настройки"
      },
      "requiredBehavior": {
        "restoreVisibility": true,
        "restoreOrder": true,
        "restoreColumnWidths": true,
        "targetState": "baseline"
      },
      "ruleText": "Кнопка Сбросить все настройки должна возвращать Table Basic [D] к базовым значениям видимости, порядка и ширины колонок."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.sorting-menu-by-column-capability",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.sorting-only-for-sortable-columns",
      "appliesTo": "component.behavior",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "cell": "[D] HeadCell",
        "control": "Chevron"
      },
      "requiredBehavior": {
        "sortableColumnMenuItems": [
          "Сортировать по возрастанию",
          "Сортировать по убыванию",
          "Сбросить ширину столбца",
          "Сбросить ширину всех столбцов"
        ],
        "nonSortableColumnMenuItems": [
          "Сбросить ширину столбца",
          "Сбросить ширину всех столбцов"
        ],
        "defaultSortingPreset": "Not selected",
        "allowedPresetOverride": "product-defined initial sorting"
      },
      "forbidden": {
        "sortActionsInNonSortableColumn": true,
        "pinColumnAction": true
      },
      "ruleText": "Пункты сортировки в меню Chevron показываются только у сортируемых колонок Table Basic [D]. У несортируемой колонки меню не должно содержать сортировку. Действие закрепления в Basic запрещено."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.column-width-reset-actions",
      "severity": "warning",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.column-width-reset",
      "appliesTo": "component.behavior",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "manualColumnResize": true
      },
      "requiredMenuItems": [
        "Сбросить ширину столбца",
        "Сбросить ширину всех столбцов"
      ],
      "requiredBehavior": {
        "resizeControl": "divider between columns in table header",
        "neighborColumnEffect": "decreasing one column increases right neighbor width",
        "resetColumnWidth": "restore current column baseline width",
        "resetAllColumnWidths": "restore all baseline widths"
      },
      "ruleText": "Если в Table Basic [D] доступно ручное изменение ширины колонок, меню колонки должно давать сброс ширины текущей колонки и сброс ширины всех колонок."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.pagination-by-row-count",
      "severity": "warning",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.pagination-by-row-count",
      "appliesTo": "component.state",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "area": "pagination"
      },
      "requiredState": {
        "rowsLessOrEqualTen": {
          "paginationPreset": "None",
          "singlePageBlockRequired": false
        },
        "rowsMoreThanTen": {
          "paginationPreset": "Pagination"
        },
        "lastRowBottomDivider": false,
        "scrollbarEnabled": false
      },
      "ruleText": "Если в Table Basic [D] 10 строк или меньше, блок с одной страницей можно отключить через preset None. Если строк больше 10 и появляется вторая страница, используй preset Pagination. Scrollbar в пагинации Basic не включается."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.sticky-plate-when-overflow",
      "severity": "warning",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.sticky-plate-when-overflow",
      "appliesTo": "component.layout",
      "checkType": "llm",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "tableHeightExceedsViewport": true,
        "hasBottomControlBlock": true
      },
      "requiredBehavior": {
        "bottomBlock": "sticky plate",
        "position": "bottom of visible table container",
        "rowsScrollUnderBlock": true
      },
      "ruleText": "Если Table Basic [D] не помещается во viewport по высоте, нижний блок Pagination или BulkActions должен работать как sticky plate у нижнего края видимой области таблицы."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.bulk-actions-use-pagination-preset",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.bulk-actions-use-pagination-preset",
      "appliesTo": "component.state",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "hasCheckboxes": true,
        "selectedRowsCountGreaterThan": 0
      },
      "requiredState": {
        "paginationBlockPreset": "BulkActions",
        "bulkActionsPaginationMode": "per-page"
      },
      "forbidden": {
        "component": "TableBulkActions",
        "separateBulkActionsComponent": true
      },
      "ruleText": "При выборе строк в Table Basic [D] нижний блок переключается в preset BulkActions. В новой сборке таблиц не используй отдельный компонент TableBulkActions; групповые действия должны быть состоянием пагинационного блока."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.keep-one-visible-column",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.keep-one-visible-column",
      "appliesTo": "component.visibility",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "area": "column visibility settings"
      },
      "requiredState": {
        "minVisibleColumns": 1
      },
      "forbidden": {
        "hideLastVisibleColumn": true,
        "visibleColumnCount": 0
      },
      "ruleText": "В настройках Table Basic [D] можно скрывать любые колонки, кроме последней видимой. Таблица не должна оставаться без видимых колонок."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.column-order-follows-settings",
      "severity": "warning",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.column-order-drag-and-drop",
      "appliesTo": "component.composition",
      "checkType": "llm",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "area": "column order settings"
      },
      "requiredBehavior": {
        "control": "drag-and-drop in settings column list",
        "tableColumnOrder": "matches settings list order"
      },
      "ruleText": "Порядок колонок Table Basic [D] изменяется drag-and-drop в списке настроек. После изменения порядок колонок в таблице должен совпадать с порядком в списке."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.detach-only-rows",
      "severity": "error",
      "source": "pattern-link",
      "patternId": "ptrn:components.table-basic-d",
      "patternRuleId": "rule:components.table-basic-d.detach-only-rows",
      "appliesTo": "component.instance",
      "checkType": "manual",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "designerWorkflow": "local row composition"
      },
      "allowedDetach": [
        "HeaderRow",
        "BodyRow",
        "Local :: HeaderRow",
        "Local :: BodyRow"
      ],
      "forbiddenDetach": [
        "Pagination",
        "HeadCell",
        "BodyCell",
        "ControlCell",
        "ActionCell",
        "Sorting",
        "Chevron",
        "Text",
        "Graphics",
        "Addons"
      ],
      "ruleText": "Для настройки состава и ширины колонок дизайнер детачит [D] HeadRow :: Universal и [D] BodyRow :: Basic, а затем добавляет в строки нужные библиотечные ячейки из [D] HeadCells :: Universal и [D] BodyCells :: Basic. Остальные компоненты таблицы детачить нельзя."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.supports-two-text-slots",
      "severity": "info",
      "source": "component-contract",
      "appliesTo": "component.composition",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "conditions": {
        "component": "Table Basic [D]",
        "cell": "[D] BodyCell :: Basic"
      },
      "allowedComposition": {
        "maxTextSlotsPerCell": 2,
        "secondTextSlotRequired": false,
        "secondTextSlotContent": "context-dependent",
        "slots": [
          "Text 1",
          "Text 2"
        ]
      },
      "ruleText": "Ячейка Table Basic [D] может содержать два текстовых слота: Text 1 и опциональный Text 2. Содержимое Text 2 определяется контекстом. Это ключевое отличие Basic от Wide."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.internal-parts-not-standalone",
      "severity": "error",
      "source": "component-contract",
      "appliesTo": "component.placement",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "forbiddenStandaloneComponents": [
        "ActionButton",
        "Control",
        "Graphics",
        "GraphicsSkeleton",
        "LeftAddon",
        "RightAddon",
        "Text",
        "🔄 Chevron",
        "🔄 HeadControl",
        "🔄 Sorting"
      ],
      "ruleText": "Служебные компоненты Table Basic предназначены только для внутренней сборки строк и ячеек. Их запрещено использовать как самостоятельные элементы интерфейса."
    },
    {
      "ruleId": "component:web-corp.table-basic-d.edge-cell-widths-are-fixed",
      "severity": "error",
      "source": "component-contract",
      "appliesTo": "layout.width",
      "checkType": "deterministic",
      "matchKind": "exact_component_rule",
      "forbiddenWidthOverride": [
