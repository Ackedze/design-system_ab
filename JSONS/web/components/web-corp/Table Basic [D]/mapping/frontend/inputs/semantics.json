{
  "$schema": "hub/facet.semantics@1",
  "summary": "Table Basic [D] — семейство более воздушных таблиц до пяти столбцов с поддержкой двух текстовых слотов в одной ячейке.",
  "components": [
    {
      "figmaName": "[D] BodyRow :: Basic",
      "figmaKey": "aca58bac6a6137109081a0f7289424b5a240d0fd",
      "purpose": "Строка данных для воздушной desktop-таблицы Basic с количеством столбцов до пяти.",
      "useWhen": [
        "Нужно собрать строку простой таблицы без горизонтального скролла."
      ],
      "doNotUseWhen": [
        "Таблица требует большого количества столбцов, горизонтального скролла или функциональной группировки."
      ],
      "relationship": "Основная строка Table Basic; после добавления наполняется библиотечными Basic-ячейками.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyCell :: Basic",
      "figmaKey": "04acf0fa2142daa01998e1a39d18167a64a64a9a",
      "purpose": "Обычная ячейка Table Basic для основного и опционального дополнительного текста или статусного пресета.",
      "useWhen": [
        "В строке Basic нужно показать основное значение и при необходимости второй текстовый слой."
      ],
      "doNotUseWhen": [
        "Колонка предназначена только для выбора строки или действия."
      ],
      "relationship": "Контентная ячейка внутри [D] BodyRow :: Basic.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyControlCell :: Basic",
      "figmaKey": "ca7c11e04c35a747c05c91eeb65fff6b24929194",
      "purpose": "Служебная ячейка строки Table Basic для выбора строки или другого предусмотренного контролла.",
      "useWhen": [
        "Строке Basic нужен фиксированный control-столбец."
      ],
      "doNotUseWhen": [
        "В колонке отображаются обычные данные или действия над строкой."
      ],
      "relationship": "Фиксированная control-ячейка внутри [D] BodyRow :: Basic; её ширина не настраивается вручную.",
      "status": "approved"
    },
    {
      "figmaName": "[D] BodyActionCell :: Basic",
      "figmaKey": "b6c7356c0b97488d7f63568ecc3e3d9c5e28f919",
      "purpose": "Служебная ячейка строки Table Basic для предусмотренного действия над объектом.",
      "useWhen": [
        "У строки Basic должно быть действие в отдельной фиксированной колонке."
      ],
      "doNotUseWhen": [
        "Действие относится ко всей таблице или является обычным значением строки."
      ],
      "relationship": "Фиксированная action-ячейка внутри [D] BodyRow :: Basic.",
      "status": "approved"
    },
    {
      "figmaName": "[D] GroupDivider :: Basic",
      "figmaKey": "be454edabe88cea4ec38e4402ca31af920d1cba6",
      "purpose": "Визуальный заголовок или разделитель группы строк в Table Basic без вложенной функциональной группировки.",
      "useWhen": [
        "Нужно визуально разделить последовательность строк или подписать их группу."
      ],
      "doNotUseWhen": [
        "Нужна раскрываемая или иерархическая группировка данных."
      ],
      "relationship": "Опциональная строка-разделитель Table Basic; не создаёт отдельный уровень структуры данных.",
      "status": "approved"
    }
  ],
