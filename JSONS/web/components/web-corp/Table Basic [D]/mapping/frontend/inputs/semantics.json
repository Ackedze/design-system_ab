    {
      "area": "usage",
      "topic": "agentGuidance",
      "body": [
        "Используй exact pattern или component-contract rule до повышения критичности.",
        "Считай Table Basic detached-композицией из [D] HeadRow :: Universal, [D] BodyRow :: Basic и соответствующих библиотечных ячеек.",
        "Проверяй лимит в пять столбцов и наличие CorporateTopbar, HeaderRow, BodyRow и Pagination внутри [D] BackgroundPlateSlot; TableView к этой сборке не относится.",
        "Считай Text 2 опциональным слотом с контекстным содержимым; control/action-ячейки и высота строк сохраняют effective baseline.",
        "Компоненты с префиксом 🔄 относятся к старой версии и крайне не рекомендуются для новых макетов.",
        "Служебные элементы таблицы нельзя рекомендовать для отдельного использования.",
        "Для вложенных слоёв используй effective baseline семейства Table Basic."
      ]
    },
    {
      "area": "api",
      "topic": "appliesTo",
      "body": {
        "generatedContract": "contract.generated.json",
        "rawCatalog": "Web _ Corp Components -- Table _ _ Basic [D].json"
      }
    },
    {
      "area": "api",
      "topic": "assemblyPolicy",
      "body": {
        "workflow": "detached-rows-with-library-cells",
        "headerRow": "[D] HeadRow :: Universal",
        "bodyRow": "[D] BodyRow :: Basic",
        "designerSteps": [
          "Добавить [D] HeadRow :: Universal и [D] BodyRow :: Basic.",
          "Детачить строки.",
          "Добавить нужные библиотечные ячейки из [D] HeadCells :: Universal и [D] BodyCells :: Basic.",
          "Подобрать ширину каждой ячейки в detached-композиции."
        ],
        "requiredSurroundingComponents": [
          "CorporateTopbar",
          "HeaderRow",
          "BodyRow",
          "Pagination",
          "[D] BackgroundPlateSlot"
        ],
        "unrelatedComponents": [
          "TableView"
        ]
      }
    },
    {
      "area": "api",
      "topic": "usagePolicy",
      "body": {
        "cellTextSlots": 2,
        "secondTextSlotRequired": false,
        "secondTextSlotContent": "context-dependent",
        "maxColumns": 5,
        "supportsHorizontalScroll": false,
        "supportsManyColumns": false
      }
    },
    {
      "area": "api",
      "topic": "geometryPolicy",
      "body": {
        "rowHeight": "effective-baseline-only",
        "columnWidth": {
          "designerEditable": true,
          "headAndBodyMustMatch": true,
          "horizontalOverflowAllowed": false,
          "compensateWithinAvailableWidth": true
        },
        "fixedWidthCells": [
          "[D] BodyControlCell :: Basic",
          "[D] BodyActionCell :: Basic",
          "[D] HeadActionCell",
          "[D] HeadControlCell"
        ]
      }
    },
    {
      "area": "api",
      "topic": "statePolicy",
      "body": {
        "sorting": {
          "enabledByContext": true,
          "maxActiveColumns": 1,
          "initialState": "product-defined"
        },
        "skeleton": {
          "defaultScope": "whole-table",
          "partialRowOrCellLoadingAllowed": true
        }
      }
    },
    {
      "area": "api",
      "topic": "interactionPolicy",
      "body": {
        "wholeRowClickable": true,
        "selectAllScope": "current-page",
        "headControlRequiredWhenSelectable": true
      }
    },
    {
      "area": "api",
      "topic": "columnControlPolicy",
      "body": {
        "required": true,
        "interactiveColumnMinWidth": 160,
        "pinningAllowed": false,
        "sortingActionsVisibleOnlyForSortableColumns": true
      }
    },
    {
      "area": "api",
      "topic": "bottomBlockPolicy",
      "body": {
        "component": "Pagination",
        "alwaysPresent": true,
        "singlePagePreset": "None",
        "selectedRowsPreset": "BulkActions",
        "stickyOnVerticalOverflow": true,
        "scrollbar": false,
        "bulkActions": {
          "standaloneTableBulkActionsAllowed": false,
          "maxActionButtons": 4,
          "actions": "context-dependent for selected rows"
        }
      }
    },
    {
      "area": "api",
      "topic": "actionCellPolicy",
      "body": {
        "allowedContent": [
          "one Button",
          "PickerButton",
          "Presets=None"
        ],
        "arbitraryInstanceSwap": false
      }
    },
    {
      "area": "api",
      "topic": "contentPolicy",
      "body": {
        "arbitraryInstanceSwap": false,
        "contentSelection": "component-supported presets only",
        "supportedPresetsAllowed": true,
        "emptyOrErrorState": {
          "component": "CorporateSystemMessage",
          "replaces": "BodyRow only",
          "preserves": [
            "CorporateTopbar",
            "[D] HeadRow :: Universal",
            "Pagination"
          ]
        }
      }
    },
    {
      "area": "api",
      "topic": "allowedLayerOverrides",
      "body": [
