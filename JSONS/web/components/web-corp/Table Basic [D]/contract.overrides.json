  "assemblyPolicy": {
    "workflow": "detached-rows-with-library-cells",
    "headerRow": "[D] HeadRow :: Universal",
    "bodyRow": "[D] BodyRow :: Basic",
    "designerSteps": [
      "Добавить [D] HeadRow :: Universal и [D] BodyRow :: Basic.",
      "Детачить строки.",
      "Добавить нужные библиотечные ячейки из [D] HeadCells :: Universal и [D] BodyCells :: Basic.",
      "Подобрать ширину каждой ячейки в detached-композиции."
    ],
    "requiredSurroundingComponents": [
      "CorporateTopbar",
      "HeaderRow",
      "BodyRow",
      "Pagination",
      "[D] BackgroundPlateSlot"
    ],
    "unrelatedComponents": [
      "TableView"
    ]
  },
  "usagePolicy": {
    "cellTextSlots": 2,
    "secondTextSlotRequired": false,
    "secondTextSlotContent": "context-dependent",
    "maxColumns": 5,
    "supportsHorizontalScroll": false,
    "supportsManyColumns": false
  },
  "geometryPolicy": {
    "rowHeight": "effective-baseline-only",
    "columnWidth": {
      "designerEditable": true,
      "headAndBodyMustMatch": true,
      "horizontalOverflowAllowed": false,
      "compensateWithinAvailableWidth": true
    },
    "fixedWidthCells": [
      "[D] BodyControlCell :: Basic",
      "[D] BodyActionCell :: Basic",
      "[D] HeadActionCell",
      "[D] HeadControlCell"
    ]
  },
  "statePolicy": {
    "sorting": {
      "enabledByContext": true,
      "maxActiveColumns": 1,
      "initialState": "product-defined"
    },
    "skeleton": {
      "defaultScope": "whole-table",
      "partialRowOrCellLoadingAllowed": true
    }
  },
  "interactionPolicy": {
    "wholeRowClickable": true,
    "selectAllScope": "current-page",
    "headControlRequiredWhenSelectable": true
  },
  "columnControlPolicy": {
    "required": true,
    "interactiveColumnMinWidth": 160,
    "pinningAllowed": false,
    "sortingActionsVisibleOnlyForSortableColumns": true
  },
  "bottomBlockPolicy": {
    "component": "Pagination",
    "alwaysPresent": true,
    "singlePagePreset": "None",
    "selectedRowsPreset": "BulkActions",
    "stickyOnVerticalOverflow": true,
    "scrollbar": false,
    "bulkActions": {
      "standaloneTableBulkActionsAllowed": false,
      "maxActionButtons": 4,
      "actions": "context-dependent for selected rows"
    }
  },
  "actionCellPolicy": {
    "allowedContent": [
      "one Button",
      "PickerButton",
      "Presets=None"
    ],
    "arbitraryInstanceSwap": false
  },
  "contentPolicy": {
    "arbitraryInstanceSwap": false,
    "contentSelection": "component-supported presets only",
    "supportedPresetsAllowed": true,
    "emptyOrErrorState": {
      "component": "CorporateSystemMessage",
      "replaces": "BodyRow only",
      "preserves": [
        "CorporateTopbar",
        "[D] HeadRow :: Universal",
        "Pagination"
      ]
    }
  },
  "allowedLayerOverrides": [
    "characters",
    "alignment in HeadCell and BodyCell",
    "width of ordinary HeadCell and matching BodyCell without horizontal scroll"
  ],
  "forbiddenLayerOverrides": [
    "typography",
    "fill",
    "stroke",
    "opacity",
    "padding",
    "spacing",
    "radius",
    "row height",
    "width of ControlCell and ActionCell"
  ],
  "visualStatePolicy": {
    "hover": "effective-baseline",
    "selected": "effective-baseline",
    "disabled": "effective-baseline"
  },
  "paginationPolicy": {
    "rowsPerPageUserEditable": true,
    "allowedRowsPerPage": [
      10,
      25,
      50,
      100
    ]
  },
  "linkedPatterns": [
    "ptrn:tables.data-formatting",
    "ptrn:controls.buttons-and-button-groups"
  ],
  "lifecyclePolicy": {
    "scheduledPrefix": "🔄",
    "status": "legacy",
    "recommendation": "Крайне не рекомендуется использовать в новых макетах."
  },
  "internalComponents": [
    "ActionButton",
    "Control",
    "Graphics",
    "GraphicsSkeleton",
    "LeftAddon",
    "RightAddon",
    "Text",
    "🔄 Chevron",
    "🔄 HeadControl",
    "🔄 Sorting"
  ],
  "anatomySemantics": {
    "root": {
      "path": "<variant root>",
      "scope": "component-root",
      "designerEditable": false
    },
    "rows": {
      "path": "*Row*",
      "scope": "table-row",
      "designerEditable": "component-properties-and-content"
    },
    "cells": {
      "path": "*Cell*",
      "scope": "table-cell",
      "designerEditable": "component-properties-and-content"
    },
    "addOns": {
      "path": "*Addon*",
      "scope": "cell-addon",
      "designerEditable": "component-properties-through-instance"
    }
  },
  "resetModel": {
    "componentProperties": [
      "variant.*"
    ],
    "layerProperties": [
      "fills",
      "strokes",
      "strokeWeight",
      "cornerRadius",
      "opacity",
      "layout.padding",
      "layout.itemSpacing",
      "styles.text",
      "typography"
    ],
    "contentProperties": [
      "characters"
    ],
    "dependencyPolicy": "Nested diffs семейства таблиц должны использовать effective baseline выбранного table component перед fallback к standalone baselines вложенных компонентов."
  }
}
