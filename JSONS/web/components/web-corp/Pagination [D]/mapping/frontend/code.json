{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/pagination",
  "version": "80.10.0",
  "component": "Pagination",
  "exports": [
    "Pagination"
  ],
  "props": [
    {
      "name": "activePadding",
      "type": "number",
      "description": "Количество видимых страниц вокруг выбранной"
    },
    {
      "name": "anchorNode",
      "type": "HTMLElement",
      "description": "Дом элемент к которому прокручивать страницу (если используется большой список)"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "currentPageIndex",
      "type": "number",
      "required": true,
      "description": "Текущая страница (с нуля)"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "hideArrows",
      "type": "boolean",
      "description": "Скрывает стрелки, если выбрана первая или последняя страница"
    },
    {
      "name": "onPageChange",
      "type": "(pageIndex: number) => void",
      "default": "() => null",
      "description": "Обработчик переключения страницы"
    },
    {
      "name": "onPerPageChange",
      "type": "(perPage: number) => void",
      "default": "() => null",
      "description": "Обработчик переключения perPage"
    },
    {
      "name": "pagesCount",
      "type": "number",
      "required": true,
      "description": "Количество страниц"
    },
    {
      "name": "perPage",
      "type": "number",
      "default": "25",
      "description": "Количество строк на страницу"
    },
    {
      "name": "possiblePerPage",
      "type": "number[]",
      "default": "[25, 50, 100]",
      "description": "Возможные варианты разбивки"
    },
    {
      "name": "sidePadding",
      "type": "number",
      "description": "Количество видимых страниц по бокам"
    },
    {
      "name": "view",
      "type": "\"default\" | \"per-page\"",
      "values": [
        "default",
        "per-page"
      ],
      "description": "Режим пагинации"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
