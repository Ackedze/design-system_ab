{
  "$schema": "hub/facet.code@1",
  "package": "arui-private",
  "import": "arui-private/header",
  "version": "80.10.0",
  "component": "Header",
  "exports": [
    "Header"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "displayMode",
      "type": "\"default\" | \"no-menu\"",
      "values": [
        "default",
        "no-menu"
      ],
      "description": "Режим отображения меню"
    },
    {
      "name": "hasLogo",
      "type": "boolean",
      "default": "true",
      "description": "Если `true` то отображается логотип"
    },
    {
      "name": "hasNavigationPane",
      "type": "boolean",
      "default": "false",
      "description": "Отобразить панель навигации"
    },
    {
      "name": "hasSidebar",
      "type": "boolean",
      "default": "true",
      "description": "Отобразить сайдбар"
    },
    {
      "name": "id",
      "type": "string",
      "description": "Уникальный идентификатор блока"
    },
    {
      "name": "isDesktop",
      "type": "boolean",
      "description": "Флаг, что размер экрана соотвествует переменной --desktop из\n@alfalab /core-components/mq/utils (1024px to 100%)"
    },
    {
      "name": "isMenuPopupVisible",
      "type": "boolean",
      "description": "Внешнее состояние для Modal menu"
    },
    {
      "name": "logo",
      "type": "ReactNode",
      "description": "Логотип вместо логотипа по умолчанию"
    },
    {
      "name": "logoClassName",
      "type": "string",
      "description": "Дополнительный класс для ссылки логотипа"
    },
    {
      "name": "menu",
      "type": "ReactNode",
      "description": "Содержимое меню в шапке"
    },
    {
      "name": "menuOpenerContent",
      "type": "ReactNode",
      "description": "Контент кнопки открытия меню"
    },
    {
      "name": "modalProps",
      "type": "Omit<ModalDesktopProps, \"open\">",
      "description": "Свойства мобильного модального окна"
    },
    {
      "name": "modalRightContent",
      "type": "ReactNode",
      "description": "Произвольный контент в правой части шапки модального окна"
    },
    {
      "name": "navigationPaneSettings",
      "type": "{ linkText?: string; label?: string; isButtonView?: boolean; }",
      "default": "{\nlabel: 'Application',\nlinkText: 'Go to somewhere'\n}",
      "description": "Настройки панели навигации."
    },
    {
      "name": "onboarding",
      "type": "HeaderOnboarding",
      "description": "Onboarding меню"
    },
    {
      "name": "onLogoClick",
      "type": "(event: MouseEvent<Element, MouseEvent>) => void",
      "description": "Обработчик события клика по логотипу Альфа-Банк"
    },
    {
      "name": "onMenuClick",
      "type": "(event: MouseEvent<Element, MouseEvent>) => void",
      "description": "Нажатие на кнопку меню"
    },
    {
      "name": "onMenuClose",
      "type": "(event: MouseEvent<Element, MouseEvent>) => void",
      "description": "Закрытие попапа с меню"
    },
    {
      "name": "onNavigationLinkClick",
      "type": "(event: MouseEvent<Element, MouseEvent>) => void",
      "description": "Обработчик клика по ссылке на панели навигации"
    },
    {
      "name": "rightContent",
      "type": "ReactNode",
      "description": "Произвольный контент в правой части шапки"
    },
    {
      "name": "rightContentAdaptive",
      "type": "ReactNode",
      "description": "Произвольный контент в правой части шапки адаптивной версии,\nесли не установлен будет использовано свойство `rightContent`"
    },
    {
      "name": "rootUrl",
      "type": "string",
      "default": "'/'",
      "description": "Корневая ссылка"
    },
    {
      "name": "shouldHideMenuOpenerButton",
      "type": "boolean",
      "description": "Скрытие кнопки меню в адаптиве"
    },
    {
      "name": "sidebarClassName",
      "type": "string",
      "description": "Дополнительный класс для сайдбара"
    },
    {
      "name": "sidebarContent",
      "type": "ReactNode",
      "description": "Произвольный контент перед меню в сайдбаре"
    },
    {
      "name": "sidebarSectionClassName",
      "type": "string",
      "description": "Дополнительный класс секции сайд бара"
    },
    {
      "name": "theme",
      "type": "ThemeType",
      "values": [
        "alfa-on-color",
        "alfa-on-white",
        "grey"
      ],
      "description": "Тема компонента"
    },
    {
      "name": "topContent",
      "type": "ReactNode",
      "description": "Произвольный контент в верхней части шапки"
    }
  ],
  "status": {
    "lifecycle": "active"
  }
}
