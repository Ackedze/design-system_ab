{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-action-button",
  "import": "@alfalab/core-components/action-button",
  "version": "3.0.6",
  "component": "ActionButton",
  "description": "Используется как триггер для выполнения определённого действия. Лейбл кнопки должен однозначно сообщать пользователю, что произойдёт после нажатия на неё.",
  "props": [
    {
      "name": "icon",
      "type": "ReactNode",
      "description": "Иконка кнопки"
    },
    {
      "name": "size",
      "type": "48",
      "default": 48,
      "description": "Размер кнопки"
    },
    {
      "name": "view",
      "type": "\"primary\" | \"secondary\"",
      "default": "primary",
      "description": "Тип кнопки"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "iconWrapperClassName",
      "type": "string",
      "description": "Дополнительный класс для обертки иконки"
    },
    {
      "name": "href",
      "type": "string",
      "description": "Значение href для ссылки"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Заблокировать кнопку"
    },
    {
      "name": "loading",
      "type": "boolean",
      "description": "Показать лоадер"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования.\nДля спиннера используется модификатор -loader"
    },
    {
      "name": "colors",
      "type": "Colors",
      "default": "default",
      "description": "Палитра, в контексте которой используется кнопка"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
