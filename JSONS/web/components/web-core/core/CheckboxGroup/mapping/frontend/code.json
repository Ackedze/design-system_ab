{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-checkbox-group",
  "import": "@alfalab/core-components/checkbox-group",
  "version": "6.0.7",
  "component": "CheckboxGroup",
  "description": "Используется для выбора одного или нескольких доступных значений.",
  "props": [
    {
      "name": "label",
      "type": "ReactNode",
      "description": "Заголовок группы"
    },
    {
      "name": "direction",
      "type": "Direction",
      "description": "Направление"
    },
    {
      "name": "type",
      "type": "CheckboxGroupType",
      "description": "Тип компонента"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "error",
      "type": "ReactNode",
      "description": "Отображение ошибки"
    },
    {
      "name": "hint",
      "type": "ReactNode",
      "description": "Текст подсказки снизу"
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "description": "Дочерние элементы. Ожидаются компоненты `Checkbox` или `Tag`"
    },
    {
      "name": "onChange",
      "type": "((event: ChangeEvent<Element> | MouseEvent<Element, MouseEvent>, payload: { checked: boolean; name?: string | undefined; }) => void)",
      "description": "Обработчик изменения значения 'checked' одного из дочерних компонентов"
    },
    {
      "name": "onBlur",
      "type": "((event: FocusEvent<HTMLInputElement, Element>) => void)",
      "description": "Обработчик блюра."
    },
    {
      "name": "onFocus",
      "type": "((event: FocusEvent<HTMLInputElement, Element>) => void)",
      "description": "Обработчик фокуса."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Управление возможностью изменения состояния 'checked' дочерних компонентов CheckBox"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "breakpoint",
      "type": "number",
      "default": "1024",
      "description": "Контрольная точка, с нее начинается desktop версия"
    },
    {
      "name": "client",
      "type": "\"desktop\" | \"mobile\"",
      "description": "Версия, которая будет использоваться при серверном рендеринге"
    },
    {
      "name": "defaultMatchMediaValue",
      "type": "boolean | (() => boolean)",
      "default": "client === undefined ? undefined : client === 'desktop'",
      "description": "Значение по-умолчанию для хука useMatchMedia\n@deprecated Используйте client"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
