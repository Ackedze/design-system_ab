    {
      "sourceRuleId": "web-core.checkbox.hub.16",
      "sourceNorm": "Пользователь может выбрать **несколько** значений или включить/выключить одну опцию.",
      "source": "core/web/components/checkbox/guidelines.md:16",
      "section": "Когда использовать",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.17",
      "sourceNorm": "Согласие, фильтры «показать только…», настройки без мгновенного применения на всю страницу.",
      "source": "core/web/components/checkbox/guidelines.md:17",
      "section": "Когда использовать",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.18",
      "sourceNorm": "Состояние «частично выбрано» у родителя — `indeterminate={true}`.",
      "source": "core/web/components/checkbox/guidelines.md:18",
      "section": "Когда использовать",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.22",
      "sourceNorm": "Взаимоисключающий выбор из списка → `Radio`.",
      "source": "core/web/components/checkbox/guidelines.md:22",
      "section": "Когда не использовать",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.23",
      "sourceNorm": "Мгновенное вкл/выкл настройки с метафорой переключателя → `Switch`.",
      "source": "core/web/components/checkbox/guidelines.md:23",
      "section": "Когда не использовать",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.24",
      "sourceNorm": "Главное действие → `Button`.",
      "source": "core/web/components/checkbox/guidelines.md:24",
      "section": "Когда не использовать",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.28",
      "sourceNorm": "Размер: **24** — дефолт для экранов и форм; **20** — только если так в макете. На экране/в форме — один размер, не смешивай.",
      "source": "core/web/components/checkbox/guidelines.md:28",
      "section": "Основные правила",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.29",
      "sourceNorm": "Лейбл — короткий и однозначный; подсказка — в `hint`, ошибка — в `error`. В группе — правила названий в `../checkbox-group/guidelines.md`.",
      "source": "core/web/components/checkbox/guidelines.md:29",
      "section": "Основные правила",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.30",
      "sourceNorm": "`position=\"before\"` (default) — чекбокс слева; `after` — справа. В Figma — базовый `CheckboxLabel_*` или `*_Reverse`.",
      "source": "core/web/components/checkbox/guidelines.md:30",
      "section": "Основные правила",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.31",
      "sourceNorm": "Компактная строка при `size=20` — в Figma `CompactLabel=True` на `CheckboxLabel_20*` (в коде prop нет).",
      "source": "core/web/components/checkbox/guidelines.md:31",
      "section": "Основные правила",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.32",
      "sourceNorm": "На тёмном фоне — `colors=\"inverted\"` или инстанс `*_Inverted` в Figma.",
      "source": "core/web/components/checkbox/guidelines.md:32",
      "section": "Основные правила",
      "route": "context-or-guidance",
      "manualRuleIds": [],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "web-core.checkbox.hub.36",
      "sourceNorm": "Код — `adapter.code.md`",
      "source": "core/web/components/checkbox/guidelines.md:36",
      "section": "Реализация",
      "route": "context-or-guidance",
