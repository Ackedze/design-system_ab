    {
      "sourceRuleId": "component:web-core.checkbox.component-properties-are-first-class",
      "sourceNorm": "Изменения variant/property в этом семействе компонентов являются component-property customizations. Показывай их отдельно от производных визуальных изменений layer.",
      "source": "rules.json",
      "route": "authored",
      "manualRuleIds": [
        "component:web-core.checkbox.component-properties-are-first-class"
      ],
      "compiledRuleIds": []
    },
    {
      "sourceRuleId": "component:web-core.checkbox.layer-properties-use-effective-baseline",
      "sourceNorm": "Layer/style свойства Core-компонента должны совпадать с effective baseline текущего component variant и nested owner context. Любое фактическое отклонение является нарушением, если отдельное approved правило явно не разрешает эту кастомизацию.",
      "source": "rules.json",
      "route": "authored",
