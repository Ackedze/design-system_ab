{
  "schemaVersion": 1,
  "documentType": "component-contract-overrides",
  "componentKey": "web-core.input",
  "status": "draft",
  "appliesTo": {
    "generatedContract": "contract.generated.json",
    "rawCatalog": "Web _ Core -- Input.json"
  },
  "publicApi": {
    "variantProperties": {
      "Size": {
        "kind": "component-property",
        "description": "Input height/size state.",
        "values": [
          "40",
          "48",
          "56",
          "64",
          "72"
        ]
      },
      "FilledState": {
        "kind": "component-property",
        "description": "Whether the input has a filled/value state.",
        "values": [
          "False",
          "True"
        ]
      },
      "ActiveState": {
        "kind": "component-property",
        "description": "Focus/active visual state.",
        "values": [
          "False",
          "True"
        ]
      },
      "DisabledState": {
        "kind": "component-property",
        "description": "Disabled/enabled component state.",
        "values": [
          "False",
          "True"
        ]
      },
      "ErrorState": {
        "kind": "component-property",
        "description": "Validation/error visual state.",
        "values": [
          "False",
          "True"
        ]
      },
      "OuterLabel": {
        "kind": "component-property",
        "description": "Whether the label is placed outside/above the field instead of inside/floating.",
        "values": [
          "False",
          "True"
        ]
      }
    }
  },
  "anatomySemantics": {
    "root": {
      "path": "<variant root>",
      "scope": "component-root",
      "designerEditable": false,
      "notes": "Root visibility/layout is controlled by component variant properties."
    },
    "label": {
      "path": "Label / Label",
      "scope": "content-layer",
      "designerEditable": "content-only",
      "notes": "Label text can be changed. Text style, fill and placement are controlled by component state and pattern rules."
    },
    "field": {
      "path": "Field",
      "scope": "visual-container",
      "designerEditable": false,
      "notes": "Field fill, radius, stroke and layout are controlled by size/state variants."
    },
    "placeholder": {
      "path": "Field / Content / Placeholder / Content / Placeholder",
      "scope": "content-layer",
      "designerEditable": "content-only",
      "notes": "Placeholder text can be changed. Text style and fill are layer properties and should normally stay controlled by the variant."
    },
    "hint": {
      "path": "Hint / HintMessage",
      "scope": "content-layer",
      "designerEditable": "content-only",
      "notes": "Hint or error text can be changed. ErrorState controls whether this text is interpreted as validation/error state."
    },
    "addons": {
      "path": "Field / LeftAddons/*, Field / RightAddons/*",
      "scope": "slot-instance",
      "designerEditable": "variant-property-only",
      "notes": "Addon instances are slot configuration. Manual fills/strokes on addon placeholders are layer customizations."
    }
  },
  "resetModel": {
    "componentProperties": [
      "variant.Size",
      "variant.FilledState",
      "variant.ActiveState",
      "variant.DisabledState",
      "variant.ErrorState",
      "variant.OuterLabel"
    ],
    "slotProperties": [
      "LeftAddon1.variant.Type",
      "LeftAddon2.variant.Type",
      "RightAddon1.variant.Type",
      "RightAddon2.variant.Type",
      "Placeholder.variant.Accent"
    ],
    "layerProperties": [
      "fills",
      "strokes",
      "strokeWeight",
      "cornerRadius",
      "opacity",
      "layout.padding",
      "layout.itemSpacing",
      "styles.text",
      "typography"
    ],
    "contentProperties": [
      "Label.characters",
      "Placeholder.characters",
      "HintMessage.characters"
    ],
    "dependencyPolicy": "When a component state is reset, layer differences caused only by that state may disappear automatically. Manual layer overrides should remain independently resettable until the parent state reset removes their target state."
  }
}
