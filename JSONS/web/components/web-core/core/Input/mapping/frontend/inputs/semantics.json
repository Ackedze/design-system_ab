{
  "$schema": "hub/facet.semantics@1",
  "summary": "Input — семейство text fields. Apollo должен трактовать изменения состояния Input как component property changes, а ручные изменения style/token/layout как layer customizations. Text content может требовать редакторской проверки по pattern.",
  "includes": [
    "[D] Input",
    "[D] Input_Inverted",
    "[M] Input",
    "[M] Input_Inverted",
    "scheduled Corporate/AO Input variants"
  ],
  "publicApi": {
    "variantProperties": {
      "Size": {
        "kind": "component-property",
        "description": "Height/size state компонента Input.",
        "values": [
          "40",
          "48",
          "56",
          "64",
          "72"
        ]
      },
      "FilledState": {
        "kind": "component-property",
        "description": "Есть ли у input filled/value state.",
        "values": [
          "False",
          "True"
        ]
      },
      "ActiveState": {
        "kind": "component-property",
        "description": "Focus/active visual state компонента.",
        "values": [
          "False",
          "True"
        ]
      },
      "DisabledState": {
        "kind": "component-property",
        "description": "Состояние компонента disabled/enabled.",
        "values": [
          "False",
          "True"
        ]
      },
      "ErrorState": {
        "kind": "component-property",
        "description": "Validation/error visual state компонента.",
        "values": [
          "False",
          "True"
        ]
      },
      "OuterLabel": {
        "kind": "component-property",
        "description": "Размещён ли label снаружи/над field вместо inside/floating.",
        "values": [
          "False",
          "True"
        ]
      }
    }
  },
  "patternRefs": [
    "input-fields"
  ],
  "guidance": [
    {
      "area": "usage",
      "topic": "publicComponentProperties",
      "body": {
        "variant.Size": [
          "40",
          "48",
          "56",
          "64",
          "72"
        ],
        "variant.FilledState": [
          "False",
          "True"
        ],
        "variant.ActiveState": [
          "False",
          "True"
        ],
        "variant.DisabledState": [
          "False",
          "True"
        ],
        "variant.ErrorState": [
          "False",
          "True"
        ],
        "variant.OuterLabel": [
          "False",
          "True"
        ]
      }
    },
    {
      "area": "usage",
      "topic": "anatomy",
      "body": [
        "Label / Label",
        "Field",
        "Field / LeftAddons",
        "Field / Content / Placeholder",
        "Field / RightAddons",
        "Hint / HintMessage"
      ]
    },
    {
      "area": "usage",
      "topic": "exampleInterpretations",
      "body": [
        {
          "case": "variant.ErrorState False -> True",
          "agentShouldSay": "Apollo нашёл component property customization: errorState false -> true.",
          "agentShouldNotSay": "Field fill был изменён вручную, если Apollo дополнительно не показывает явное layer fill change."
        },
        {
          "case": "variant.ErrorState change plus manual Field fill",
          "agentShouldSay": "Покажи оба изменения и сравни Field fill с ErrorState=True baseline.",
          "agentShouldNotSay": "Сравнивать ручной Field fill с ErrorState=False baseline."
        },
        {
          "case": "Label text ends with colon",
          "agentShouldSay": "Нужна текстовая проверка по pattern с использованием правила input-fields no-label-colon.",
          "agentShouldNotSay": "Это visual customization."
        }
      ]
    },
    {
      "area": "usage",
      "topic": "ruleReferences",
      "body": [
        "component:web-core.input.variant-state-is-component-property",
        "component:web-core.input.manual-field-visual-is-layer-property",
        "component:web-core.input.manual-text-style-is-layer-property",
        "component:web-core.input.desktop-label-placement",
        "component:web-core.input.label-text-pattern-rules",
        "component:web-core.input.placeholder-pattern-rules",
        "component:web-core.input.hint-error-pattern-rules"
      ]
    },
    {
      "area": "api",
      "topic": "appliesTo",
      "body": {
        "generatedContract": "contract.generated.json",
        "rawCatalog": "Web _ Core -- Input.json"
      }
    },
    {
      "area": "api",
      "topic": "anatomySemantics",
      "body": {
        "root": {
          "path": "<variant root>",
          "scope": "component-root",
          "designerEditable": false,
          "notes": "Root visibility/layout управляется component variant properties."
        },
        "label": {
          "path": "Label / Label",
          "scope": "content-layer",
          "designerEditable": "content-only",
          "notes": "Label text можно менять. Text style, fill и placement управляются состоянием компонента и pattern rules."
        },
        "field": {
          "path": "Field",
          "scope": "visual-container",
          "designerEditable": false,
          "notes": "Field fill, radius, stroke и layout управляются size/state variants."
        },
        "placeholder": {
          "path": "Field / Content / Placeholder / Content / Placeholder",
          "scope": "content-layer",
          "designerEditable": "content-only",
          "notes": "Placeholder text можно менять. Text style и fill являются layer properties и обычно должны оставаться под управлением variant."
        },
        "hint": {
          "path": "Hint / HintMessage",
          "scope": "content-layer",
          "designerEditable": "content-only",
          "notes": "Hint или error text можно менять. ErrorState управляет тем, интерпретируется ли этот текст как validation/error state."
        },
        "addons": {
          "path": "Field / LeftAddons/*, Field / RightAddons/*",
          "scope": "slot-instance",
          "designerEditable": "variant-property-only",
          "notes": "Addon instances являются slot configuration. Ручные fills/strokes на addon placeholders являются layer customizations."
        }
      }
    }
  ]
}
