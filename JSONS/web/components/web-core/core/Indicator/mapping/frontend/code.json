{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-indicator",
  "import": "@alfalab/core-components/indicator",
  "version": "4.0.2",
  "component": "Indicator",
  "description": "Используется для визаулизации количества уведомлений, сообщений и т. д.",
  "props": [
    {
      "name": "value",
      "type": "number | ReactElement<any, string | JSXElementConstructor<any>>",
      "description": "Значение индикатора"
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "description": "Цвет заливки"
    },
    {
      "name": "height",
      "type": "number",
      "description": "Высота компонента, min = 16; max = 48"
    },
    {
      "name": "size",
      "type": "8 | 16 | 20 | 24 | 32 | 40",
      "default": "getSize(height, value)",
      "description": "Размер компонента"
    },
    {
      "name": "border",
      "type": "boolean | Border",
      "description": "Настройки обводки"
    },
    {
      "name": "view",
      "type": "\"red\" | \"grey\" | \"white\"",
      "description": "Пресет компонента"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
