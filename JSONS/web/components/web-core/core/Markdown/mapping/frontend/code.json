{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-markdown",
  "import": "@alfalab/core-components/markdown",
  "version": "3.0.13",
  "component": "Markdown",
  "description": "Используется для отображения и форматирования текстового контента.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Css класс для обертки разметки"
    },
    {
      "name": "font",
      "type": "FontType",
      "description": "Шрифт разметки"
    },
    {
      "name": "overrides",
      "type": "Components",
      "description": "Переопределение компонентов для тегов разметки"
    },
    {
      "name": "transformLinkUri",
      "type": "boolean",
      "default": "true",
      "description": "Трансформация ссылок неизвестных форматов\nhttps://github.com/remarkjs/react-markdown/issues/537"
    },
    {
      "name": "breakpoint",
      "type": "number",
      "default": "1024",
      "description": "Контрольная точка, с нее начинается desktop версия"
    },
    {
      "name": "client",
      "type": "\"desktop\" | \"mobile\"",
      "description": "Версия, которая будет использоваться при серверном рендеринге"
    },
    {
      "name": "defaultMatchMediaValue",
      "type": "boolean | (() => boolean)",
      "default": "client === undefined ? undefined : client === 'desktop'",
      "description": "Значение по-умолчанию для хука useMatchMedia\n@deprecated Используйте client"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
