{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-segmented-control",
  "import": "@alfalab/core-components/segmented-control",
  "version": "3.1.3",
  "component": "SegmentedControl",
  "description": "Используется для переключения или фильтрации контента.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный className"
    },
    {
      "name": "onChange",
      "type": "(id: IDType) => void",
      "required": true,
      "description": "Обработчик смены выбранного сегмента"
    },
    {
      "name": "selectedId",
      "type": "IDType",
      "required": true,
      "description": "ID выбранного сегмента"
    },
    {
      "name": "size",
      "type": "32 | 40",
      "default": 32,
      "description": "Размер компонента"
    },
    {
      "name": "shape",
      "type": "\"rounded\" | \"rectangular\"",
      "default": "rectangular",
      "description": "Форма компонента"
    },
    {
      "name": "children",
      "type": "ReactElement<SegmentProps, string | JSXElementConstructor<any>>[]",
      "required": true,
      "description": "Дочерние элементы"
    },
    {
      "name": "colors",
      "type": "\"default\" | \"inverted\"",
      "default": "default",
      "description": "Набор цветов для компонента"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "style",
      "type": "CSSProperties",
      "description": "Дополнительные инлайн стили для враппера"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Отключает пользовательский ввод"
    },
    {
      "name": "skeleton",
      "type": "SkeletonProps",
      "description": "Настройки скелетона"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
