{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-link",
  "import": "@alfalab/core-components/link",
  "version": "7.0.3",
  "component": "Link",
  "description": "Ссылка — элемент навигации, который обозначает возможность перехода на другую страницу или вызова нового информационного слоя.",
  "props": [
    {
      "name": "view",
      "type": "\"primary\" | \"secondary\" | \"default\"",
      "default": "primary",
      "description": "Тип ссылки"
    },
    {
      "name": "pseudo",
      "type": "boolean",
      "default": false,
      "description": "Пунктирное подчеркивание"
    },
    {
      "name": "underline",
      "type": "boolean",
      "default": true,
      "description": "Включает / отключает подчеркивание"
    },
    {
      "name": "leftAddons",
      "type": "ReactNode",
      "description": "Слот слева"
    },
    {
      "name": "rightAddons",
      "type": "ReactNode",
      "description": "Слот справа"
    },
    {
      "name": "Component",
      "type": "ElementType",
      "default": "pseudo ? 'button' : 'a'",
      "description": "Позволяет использовать кастомный компонент для кнопки (например Link из роутера)"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "colors",
      "type": "\"default\" | \"inverted\"",
      "default": "default",
      "description": "Набор цветов для компонента"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
