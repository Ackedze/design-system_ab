    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Дочерние элементы."
    },
    {
      "name": "size",
      "type": "20 | 24 | 32 | 40",
      "default": 20,
      "description": "Размер компонента"
    },
    {
      "name": "shape",
      "type": "\"rounded\" | \"rectangular\"",
      "default": "rectangular",
      "description": "Форма компонента"
    },
    {
      "name": "uppercase",
      "type": "boolean",
      "default": true,
