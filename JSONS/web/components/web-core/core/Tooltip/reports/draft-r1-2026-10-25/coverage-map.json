      "sourceNorm": "Адаптеры: `code/adapter.md`, `figma/adapter.md`, bridge `bridge.md`. Сборка в Figma — `figma/cookbook.md`.",
      "section": "Tooltip",
      "sourceRuleId": "hub:tooltip:guidelines.md:14",
      "manualRuleIds": [],
      "route": "documentation-or-context",
      "compiledRuleIds": []
    },
    {
