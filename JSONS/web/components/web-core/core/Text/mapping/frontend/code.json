{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-text",
  "import": "@alfalab/core-components/text",
  "version": "3.0.2",
  "component": "Text",
  "description": "Используется для отображения и форматирования текстового контента. Компонент поддерживает все доступные дизайнерам стили текста, но не поддерживает адаптивность.",
  "props": [
    {
      "name": "tag",
      "type": "\"span\" | \"p\" | \"div\" | \"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\"",
      "default": "span",
      "description": "HTML тег"
    },
    {
      "name": "view",
      "type": "TypographyType",
      "default": "paragraph-primary-medium",
      "description": "Cтиль типографики"
    },
    {
      "name": "align",
      "type": "\"left\" | \"center\" | \"right\"",
      "default": "left",
      "description": "Выравнивание текста"
    },
    {
      "name": "color",
      "type": "string",
      "description": "Цвет текста"
    },
    {
      "name": "textBackgroundColor",
      "type": "string",
      "description": "Цвет фона"
    },
    {
      "name": "rowLimit",
      "type": "1 | 2 | 3",
      "description": "Количество строк"
    },
    {
      "name": "monospaceNumbers",
      "type": "boolean",
      "default": false,
      "description": "Делает цифры моноширинными"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Дочерние элементы"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования."
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
