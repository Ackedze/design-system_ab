{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-amount",
  "import": "@alfalab/core-components/amount",
  "version": "5.1.1",
  "component": "Amount",
  "description": "Используется для отображения сумм.",
  "props": [
    {
      "name": "value",
      "type": "number",
      "required": true,
      "description": "Денежное значение в минорных единицах"
    },
    {
      "name": "currency",
      "type": "\"ALL\" | \"AFN\" | \"ARS\" | \"AWG\" | \"AUD\" | \"AZN\" | \"BSD\" | \"BBD\" | \"BYN\" | \"BZD\" | \"BMD\" | \"BOB\" | \"BOV\" | \"BAM\" | \"BWP\" | \"BGN\" | \"BRL\" | \"BND\" | \"KHR\" | \"CAD\" | \"KYD\" | \"CLP\" | \"CNY\" | ... 157 more ...",
      "description": "Валюта"
    },
    {
      "name": "rightAddons",
      "type": "ReactNode",
      "description": "Слот справа"
    },
    {
      "name": "minority",
      "type": "number",
      "required": true,
      "description": "Количество минорных единиц в валюте"
    },
    {
      "name": "codeFormat",
      "type": "\"letter\" | \"symbolic\"",
      "description": "Формат отображения кода валюты"
    },
    {
      "name": "view",
      "type": "\"default\" | \"withZeroMinorPart\"",
      "description": "default - не отображаем копейки, если их значение 0\nwithZeroMinorPart - отображаем копейки, даже если их значение равно 0"
    },
    {
      "name": "bold",
      "type": "\"full\" | \"major\" | \"none\"",
      "description": "Управление жирностью\n@deprecated Используйте проп {@link AmountProps.fontWeight }"
    },
    {
      "name": "fontWeight",
      "type": "\"bold\" | \"medium\" | { major: \"bold\" | \"medium\"; }",
      "description": "Управление жирностью"
    },
    {
      "name": "transparentMinor",
      "type": "boolean",
      "description": "Делает минорную часть полупрозрачной"
    },
    {
      "name": "showPlus",
      "type": "boolean",
      "description": "Показывать значок + для положительных значений"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "trimZero",
      "type": "boolean",
      "default": "false",
      "description": "Обрезать ноль в минорной части. Например: 1.70 -> 1.7"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
