    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Управление состоянием включен / выключен"
    },
    {
      "name": "name",
      "type": "string",
      "description": "Html аттрибут name инпута"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Класс компонента"
    },
    {
      "name": "circleClassName",
      "type": "string",
      "description": "Доп. класс радио кнопки"
    },
    {
      "name": "contentClassName",
      "type": "string",
      "description": "Доп. класс контента"
    },
    {
      "name": "align",
      "type": "Align",
