{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-filter-tag",
  "import": "@alfalab/core-components/filter-tag",
  "version": "7.0.7",
  "component": "FilterTag",
  "description": "Используется чтобы вывести параметры фильтрации и отобразить примененное значение.",
  "props": [
    {
      "name": "checked",
      "type": "boolean",
      "description": "Состояние выбора"
    },
    {
      "name": "open",
      "type": "boolean",
      "description": "Состояние открытия"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Состояние блокировки"
    },
    {
      "name": "onClick",
      "type": "((event: MouseEvent<HTMLDivElement, MouseEvent>) => void)",
      "description": "Обработчик клика"
    },
    {
      "name": "onClear",
      "type": "(() => void)",
      "description": "Обработчик очистки"
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Контент"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "size",
      "type": "32 | 40 | 48",
      "description": "Размер компонента"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "showClear",
      "type": "boolean",
      "description": "Показывать крестик для очистки выбора"
    },
    {
      "name": "block",
      "type": "boolean",
      "default": "false",
      "description": "Растягивает компонент на ширину контейнера"
    },
    {
      "name": "shape",
      "type": "\"rounded\" | \"rectangular\"",
      "default": "rounded",
      "description": "Форма тега"
    },
    {
      "name": "view",
      "type": "\"outlined\" | \"filled\"",
      "description": "Стиль тега"
    },
    {
      "name": "colors",
      "type": "\"default\" | \"inverted\"",
      "default": "default",
      "description": "Набор цветов для компонента"
    },
    {
      "name": "leftAddons",
      "type": "ReactNode",
      "description": "Слот слева"
    },
    {
      "name": "breakpoint",
      "type": "number",
      "default": "1024",
      "description": "Контрольная точка, с нее начинается desktop версия"
    },
    {
      "name": "client",
      "type": "\"desktop\" | \"mobile\"",
      "description": "Версия, которая будет использоваться при серверном рендеринге"
    },
    {
      "name": "defaultMatchMediaValue",
      "type": "boolean | (() => boolean)",
      "default": "client === undefined ? undefined : client === 'desktop'",
      "description": "Значение по-умолчанию для хука useMatchMedia\n@deprecated Используйте client"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
