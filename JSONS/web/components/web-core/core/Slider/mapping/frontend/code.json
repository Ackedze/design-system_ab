{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-slider",
  "import": "@alfalab/core-components/slider",
  "version": "6.1.1",
  "component": "Slider",
  "props": [
    {
      "name": "min",
      "type": "number",
      "default": 0,
      "description": "Мин. допустимое число"
    },
    {
      "name": "max",
      "type": "number",
      "default": 100,
      "description": "Макс. допустимое число"
    },
    {
      "name": "step",
      "type": "number",
      "default": 1,
      "description": "Шаг (должен нацело делить отрезок между мин и макс)"
    },
    {
      "name": "pips",
      "type": "Pips",
      "description": "Отображение подписей\nhttps://refreshless.com/nouislider/pips/"
    },
    {
      "name": "range",
      "type": "RangeOptions",
      "default": "{ min, max }",
      "description": "Настройка шагов\nhttps://refreshless.com/nouislider/pips/#section-range"
    },
    {
      "name": "snap",
      "type": "boolean",
      "default": false,
      "description": "Флаг точной привязки к range\nhttps://refreshless.com/nouislider/examples/#section-skipping"
    },
    {
      "name": "value",
      "type": "number",
      "default": 0,
      "description": "Значение слайдера"
    },
    {
      "name": "valueTo",
      "type": "number",
      "description": "Второе значение слайдера (значение второго ползунка)\nесли передать ValueTo, то слайдер будет работать как range"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "Заблокированное состояние"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "behaviour",
      "type": "\"unconstrained-tap\" | \"tap\"",
      "default": "tap",
      "description": "Поведение ползунка"
    },
    {
      "name": "size",
      "type": "\"s\" | \"m\" | 2 | 4",
      "default": 2,
      "description": "Размер\n@description s, m deprecated, используйте вместо них 2, 4 соответственно"
    },
    {
      "name": "dots",
      "type": "boolean",
      "default": false,
      "description": "Включение/отключение отображения точек на слайдере"
    },
    {
      "name": "dotsSlider",
      "type": "\"step\" | \"custom\"",
      "default": "step",
      "description": "Тип отображения точек на слайдере: 'step' - по шагу, 'custom' - произвольные"
    },
    {
      "name": "showPipsDots",
      "type": "boolean",
      "default": false,
      "description": "Показывать точки для pips-значений вместе с customDots в режиме dotsSlider='custom'"
    },
    {
      "name": "customDots",
      "type": "number[]",
      "default": "[]",
      "description": "Массив значений для произвольного размещения точек"
    },
    {
      "name": "pipsLabel",
      "type": "PipsLabelMode",
      "default": "all",
      "description": "Отображение подписи под точками:\n- all: подпись для всех точек\n- pipsOnly: подпись только для pips-значений\n- customPipsOnly: подпись только для customDots\n- none: подписи отключены"
    },
    {
      "name": "onChange",
      "type": "((payload: { value: number; valueTo?: number | undefined; }) => void)",
      "description": "Обработчик поля ввода"
    },
    {
      "name": "onStart",
      "type": "(() => void)",
      "description": "@deprecated Обработчик начала перетаскивания ползунка"
    },
    {
      "name": "onEnd",
      "type": "(() => void)",
      "description": "Обработчик окончания перетаскивания ползунка\n@description https://refreshless.com/nouislider/events-callbacks/#section-change"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
