{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-carousel",
  "import": "@alfalab/core-components/carousel",
  "version": "1.1.2",
  "component": "Carousel",
  "description": "Используется для отображения массива элементов с возможностью скролла контейнера.",
  "props": [
    {
      "name": "navigation",
      "type": "\"hover\" | \"always\" | \"never\"",
      "default": "never",
      "description": "Управление каруселью через кнопки навигации"
    },
    {
      "name": "navigationPosition",
      "type": "\"start\" | \"center\"",
      "default": "center",
      "description": "Положение кнопок навигации"
    },
    {
      "name": "Pagination",
      "type": "ComponentType<T>",
      "default": "(): undefined => {}",
      "description": "Компонент для рендера пагинации"
    },
    {
      "name": "paginationProps",
      "type": "Omit<T, keyof PaginationProps>",
      "default": "{} as T",
      "description": "Дополнительные пропс для компонента пагинации"
    },
    {
      "name": "minHeight",
      "type": "string | number",
      "description": "Минимальная высота карусели"
    },
    {
      "name": "height",
      "type": "string | number",
      "default": "auto",
      "description": "Высота карусели"
    },
    {
      "name": "activeIndex",
      "type": "number",
      "description": "Индекс активного элемента карусели"
    },
    {
      "name": "defaultActiveIndex",
      "type": "number",
      "description": "Индекс активного элемента карусели по-умолчанию"
    },
    {
      "name": "onActiveIndexChange",
      "type": "((nextActiveIndex: number) => void)",
      "description": "Обработчик изменения индекса активного элемента карусели"
    },
    {
      "name": "gap",
      "type": "number",
      "default": "8",
      "description": "Отступ между элементами карусели"
    },
    {
      "name": "visibleItems",
      "type": "number | \"auto\"",
      "default": "auto",
      "description": "Количество видимых элементов карусели"
    },
    {
      "name": "items",
      "type": "ItemProps[]",
      "default": "auto",
      "description": "Массив элементов карусели"
    },
    {
      "name": "colors",
      "type": "\"default\" | \"inverted\"",
      "default": "default",
      "description": "Набор цветов для карусели"
    },
    {
      "name": "loop",
      "type": "boolean",
      "default": "false",
      "description": "Зациклена ли карусель"
    },
    {
      "name": "overflow",
      "type": "\"hidden\" | \"visible\"",
      "default": "hidden",
      "description": "Поведение при переполнении контента элементов карусели"
    },
    {
      "name": "mouseWheel",
      "type": "boolean",
      "default": "false",
      "description": "Управление каруселью через колесо мыши"
    },
    {
      "name": "touchMoveStopPropagation",
      "type": "boolean",
      "default": "false",
      "description": "Остановка всплытия событий при свайпе"
    },
    {
      "name": "captureEvent",
      "type": "boolean",
      "default": "false",
      "description": "Захват события при свайпе"
    },
    {
      "name": "shortSwipe",
      "type": "boolean",
      "default": "true",
      "description": "Обработка короткого свайпа"
    },
    {
      "name": "longSwipeTimeMs",
      "type": "number",
      "default": "300",
      "description": "Минимальная время длинного свайпа в миллисекундах"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
