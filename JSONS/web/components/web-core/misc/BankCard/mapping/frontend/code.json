{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-bank-card",
  "import": "@alfalab/core-components/bank-card",
  "version": "7.0.11",
  "component": "BankCard",
  "description": "Используется для ввода номера карты или банковского счета.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#EF3124",
      "description": "Цвет фона карты"
    },
    {
      "name": "bankLogo",
      "type": "ReactNode",
      "default": "<AlfaBankSignMIcon width={30} height={40} />",
      "description": "Иконка логотипа банка (размер L)"
    },
    {
      "name": "inputLabel",
      "type": "string",
      "default": "getDefaultInputLabel(maskType)",
      "description": "Лэйбл поля ввода"
    },
    {
      "name": "value",
      "type": "string",
      "description": "Значение поля ввода"
    },
    {
      "name": "onChange",
      "type": "((event: ChangeEvent<HTMLInputElement>, payload: { value: string; }) => void)",
      "description": "Обработчик ввода"
    },
    {
      "name": "onUsePhoto",
      "type": "((event: MouseEvent<HTMLButtonElement, MouseEvent>) => void)",
      "description": "Обработчик вызова камеры"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "maskType",
      "type": "MaskType",
      "default": "MaskTypeEnum.Default",
      "description": "Тип вводимой маски. Позволяет устанавливать необходимый тип номера (номер карты или номер счёта)\nЕсли параметр не передавать - работает с обоими типами номеров"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
