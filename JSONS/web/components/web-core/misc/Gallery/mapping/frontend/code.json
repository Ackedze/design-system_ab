{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-gallery",
  "import": "@alfalab/core-components/gallery",
  "version": "7.2.0",
  "component": "Gallery",
  "description": "Используется для просмотра изображений.",
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "required": true,
      "description": "Управление видимостью"
    },
    {
      "name": "images",
      "type": "GalleryImage[]",
      "required": true,
      "description": "Массив изображений"
    },
    {
      "name": "loop",
      "type": "boolean",
      "default": true,
      "description": "Зациклить галерею"
    },
    {
      "name": "initialSlide",
      "type": "number",
      "default": 0,
      "description": "Индекс открытого изображение"
    },
    {
      "name": "onClose",
      "type": "() => void",
      "required": true,
      "description": "Обработчик закрытия"
    },
    {
      "name": "slideIndex",
      "type": "number",
      "description": "Индекс текущего изображения"
    },
    {
      "name": "onSlideIndexChange",
      "type": "((index: number) => void)",
      "description": "Обработчик изменения текущего изображения"
    },
    {
      "name": "popupClassName",
      "type": "string",
      "description": "Дополнительный класс для попапа"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
