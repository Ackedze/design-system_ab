    },
    {
      "name": "header",
      "type": "ReactNode",
      "required": true,
      "description": "Элемент заголовка"
    },
    {
      "name": "control",
      "type": "ReactNode",
      "description": "Слот для элемента управления"
    },
    {
      "name": "controlPosition",
