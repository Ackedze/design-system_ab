    },
    {
      "name": "headerClassName",
      "type": "string",
      "description": "Дополнительный класс для header"
    },
    {
      "name": "controlClassName",
      "type": "string",
      "description": "Дополнительный класс для control"
    },
    {
      "name": "bodyClassName",
      "type": "string",
      "description": "Дополнительный класс для body"
    },
    {
      "name": "bodyContentClassName",
      "type": "string",
