{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-accordion",
  "import": "@alfalab/core-components/accordion",
  "version": "3.0.9",
  "component": "Accordion",
  "description": "Используется для отображения скрытого контента по клику.",
  "props": [
