{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-attach",
  "import": "@alfalab/core-components/attach",
  "version": "8.0.9",
  "component": "Attach",
  "description": "Используется для прикрепления файлов.",
  "props": [
    {
      "name": "buttonContent",
      "type": "ReactNode",
      "default": "Выберите файл",
      "description": "Содержимое кнопки для выбора файла"
    },
    {
      "name": "buttonProps",
      "type": "(ButtonProps & ButtonHTMLAttributes<HTMLButtonElement>)",
      "default": "{}",
      "description": "Свойства для кнопки"
    },
    {
      "name": "fileClassName",
      "type": "string",
      "description": "Дополнительный класс для блока с файлами"
    },
    {
      "name": "noFileClassName",
      "type": "string",
      "description": "Дополнительный класс для блока с подсказкой, когда файл не загружен"
    },
    {
      "name": "maxFilenameLength",
      "type": "number",
      "description": "Число символов, после которого имя файла будет обрезаться"
    },
    {
      "name": "noFileText",
      "type": "string",
      "default": "Нет файла",
      "description": "Текст для случая, когда файл не загружен"
    },
    {
      "name": "progressBarPercent",
      "type": "number",
      "description": "Процент выполнения загрузки файла"
    },
    {
      "name": "size",
      "type": "32 | 40 | 48 | 56 | 64",
      "default": 48,
      "description": "Размер компонента"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "description": "Возможность прикрепления нескольких файлов"
    },
    {
      "name": "value",
      "type": "File[] | null",
      "description": "Содержимое поля ввода. Принимает массив объектов типа File или null."
    },
    {
      "name": "defaultValue",
      "type": "File[] | null",
      "description": "Содержимое поля ввода, указанное по умолчанию. Принимает массив объектов типа File или null."
    },
    {
      "name": "onChange",
      "type": "((event: ChangeEvent<HTMLInputElement>, payload: { files: File[]; }) => void)",
      "description": "Обработчик поля ввода"
    },
    {
      "name": "onClear",
      "type": "((event: MouseEvent<HTMLButtonElement, MouseEvent>) => void)",
      "description": "Обработчик нажатия на кнопку очистки"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
