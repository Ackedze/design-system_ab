{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-file-upload-item",
  "import": "@alfalab/core-components/file-upload-item",
  "version": "8.1.1",
  "component": "FileUploadItem",
  "description": "Используется для отображения загружаемого файла.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "id",
      "type": "string",
      "description": "Идентификатор элемента"
    },
    {
      "name": "title",
      "type": "string",
      "description": "Имя файла / заголовок"
    },
    {
      "name": "subtitle",
      "type": "string",
      "description": "Подзаголовок файла"
    },
    {
      "name": "size",
      "type": "string | number",
      "description": "Размер файла"
    },
    {
      "name": "uploadDate",
      "type": "string",
      "description": "Дата загрузки файла"
    },
    {
      "name": "downloadLink",
      "type": "string",
      "description": "Ссылка на файл. Если прокидывается этот параметр, то появляется кнопка скачивания"
    },
    {
      "name": "download",
      "type": "string | true",
      "description": "Рекомендует браузеру скачивать контент по ссылке.\nВ проп может быть передано рекомендуемое название скачиваемого файла."
    },
    {
      "name": "showDelete",
      "type": "boolean",
      "description": "Отображение кнопки удаления"
    },
    {
      "name": "showRestore",
      "type": "boolean",
      "description": "Отображение кнопки восстановления"
    },
    {
      "name": "reupload",
      "type": "boolean | { onClick?: ((id: string) => void) | undefined; }",
      "description": "Отображает кнопку повторной загрузки.\nПринимает `true` или объект с обработчиком клика."
    },
    {
      "name": "uploadStatus",
      "type": "FileUploadItemStatus",
      "description": "Статус загрузки файла"
    },
    {
      "name": "error",
      "type": "string | string[]",
      "description": "Сообщение об ошибке"
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Дочерние элементы"
    },
    {
      "name": "onDownload",
      "type": "((id: string) => void)",
      "description": "Обработчик загрузки файла"
    },
    {
      "name": "onDelete",
      "type": "((id: string, event?: MouseEvent<HTMLElement, MouseEvent> | undefined) => void)",
      "description": "Обработчик удаления файла"
    },
    {
      "name": "onRestore",
      "type": "((id: string) => void)",
      "description": "Обработчик восстановления файла"
    },
    {
      "name": "disableButtons",
      "type": "boolean",
      "description": "Управление активностью кнопок"
    },
    {
      "name": "isClickable",
      "type": "boolean",
      "description": "Управление отображением кликабельности элемента Content"
    },
    {
      "name": "target",
      "type": "HTMLAttributeAnchorTarget",
      "description": "Указывает, где открыть скачиваемый документ"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "iconStyle",
      "type": "\"gray\" | \"colored\"",
      "default": "gray",
      "description": "Цвет заполнения иконки"
    },
    {
      "name": "customIcon",
      "type": "ElementType<{ className?: string | undefined; }>",
      "description": "Кастомная иконка"
    },
    {
      "name": "progressBar",
      "type": "number",
      "default": "0",
      "description": "Шкала прогресса\nот 0 до 100"
    },
    {
      "name": "progressBarAvailable",
      "type": "boolean",
      "default": "true",
      "description": "Шкала прогресса"
    },
    {
      "name": "customContent",
      "type": "ElementType",
      "description": "Кастомный контент"
    },
    {
      "name": "truncate",
      "type": "boolean",
      "default": "false",
      "description": "Отсечение контента"
    },
    {
      "name": "imageUrl",
      "type": "string",
      "description": "Фоновое изображение. Имеет приоритет над иконкой и заливкой"
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "description": "Цвет заливки `StatusControl`"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
