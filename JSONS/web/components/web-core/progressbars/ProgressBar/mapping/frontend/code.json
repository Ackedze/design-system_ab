{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-progress-bar",
  "import": "@alfalab/core-components/progress-bar",
  "version": "5.0.2",
  "component": "ProgressBar",
  "description": "Используется для отображения прогресса.",
  "props": [
    {
      "name": "value",
      "type": "number",
      "required": true,
      "description": "Значение заполненной части 0-100"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Css-класс для стилизации"
    },
    {
      "name": "view",
      "type": "\"positive\" | \"negative\" | \"attention\" | \"link\" | \"tertiary\" | \"secondary\" | \"primary\" | \"accent\"",
      "default": "positive",
      "description": "Цвет заполнения"
    },
    {
      "name": "size",
      "type": "4 | 8",
      "default": 8,
      "description": "Размер компонента"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Id компонента для тестов"
    },
    {
      "name": "colors",
      "type": "\"default\" | \"inverted\"",
      "default": "default",
      "description": "Набор цветов для компонента"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
