{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-hatching-progress-bar",
  "import": "@alfalab/core-components/hatching-progress-bar",
  "version": "4.0.1",
  "component": "HatchingProgressBar",
  "description": "Используется для отображения прогресса при заполнении формы.",
  "props": [
    {
      "name": "value",
      "type": "number",
      "required": true,
      "description": "Значение заполненной части 0-100"
    },
    {
      "name": "hatchValue",
      "type": "number",
      "required": true,
      "description": "Значение будущей заполненной части 0-100"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Css-класс для стилизации"
    },
    {
      "name": "view",
      "type": "\"positive\" | \"negative\" | \"attention\" | \"link\" | \"tertiary\" | \"secondary\" | \"primary\" | \"accent\"",
      "default": "positive",
      "description": "Цвет заполнения"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Id компонента для тестов"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
