{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-tab-bar",
  "import": "@alfalab/core-components/tab-bar",
  "version": "4.0.10",
  "component": "TabBar",
  "description": "Используется для навигации между разделами.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования.\nДля таба используется модификатор -tab"
    },
    {
      "name": "tabClassNames",
      "type": "{ className?: string | undefined; selectedClassName?: string | undefined; labelClassName?: string | undefined; iconClassName?: string | undefined; }",
      "description": "Дополнительные классы для таба."
    },
    {
      "name": "children",
      "type": "TabElementType[]",
      "required": true,
      "description": "Список табов"
    },
    {
      "name": "selectedId",
      "type": "string",
      "description": "Идентификатор выбранного таба"
    },
    {
      "name": "border",
      "type": "boolean",
      "description": "Включает верхний бордер"
    },
    {
      "name": "onChange",
      "type": "((id: string) => void)",
      "description": "Обработчик изменения выбранного таба"
    },
    {
      "name": "accentColor",
      "type": "\"primary\" | \"secondary\"",
      "default": "primary",
      "description": "Цвет активного таба"
    },
    {
      "name": "bgColor",
      "type": "\"modal-bg-primary\" | \"modal-bg-alt-primary\"",
      "default": "modal-bg-primary",
      "description": "Цвет фона"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
