{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-pagination",
  "import": "@alfalab/core-components/pagination",
  "version": "4.0.6",
  "component": "Pagination",
  "description": "Используется для переключения между страницами.",
  "props": [
    {
      "name": "currentPageIndex",
      "type": "number",
      "default": 0,
      "description": "Текущая страница (с нуля)"
    },
    {
      "name": "pagesCount",
      "type": "number",
      "required": true,
      "description": "Количество страниц"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "hideArrows",
      "type": "boolean",
      "default": true,
      "description": "Скрывает стрелки, если выбрана первая или последняя страница"
    },
    {
      "name": "sidePadding",
      "type": "number",
      "default": 1,
      "description": "Количество видимых страниц по бокам"
    },
    {
      "name": "activePadding",
      "type": "number",
      "default": 2,
      "description": "Количество видимых страниц вокруг выбранной"
    },
    {
      "name": "view",
      "type": "\"default\" | \"per-page\"",
      "default": "default",
      "description": "Режим пагинации"
    },
    {
      "name": "onPageChange",
      "type": "((pageIndex: number) => void)",
      "default": "() => null",
      "description": "Обработчик переключения страницы"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
