{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-tabs",
  "import": "@alfalab/core-components/tabs",
  "version": "10.0.18",
  "component": "Tabs",
  "description": "Используется для переключения контекстов страницы или блока.",
  "props": [
    {
      "name": "onChange",
      "type": "((event: MouseEvent<Element, MouseEvent>, payload: { selectedId: SelectedId; }) => void)",
      "description": "Обработчик переключения табов"
    },
    {
      "name": "children",
      "type": "ReactElement<TabProps, string | JSXElementConstructor<any>>[]",
      "required": true,
      "description": "Компоненты табов"
    },
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "style",
      "type": "CSSProperties",
      "description": "Дополнительные инлайн стили для враппера"
    },
    {
      "name": "containerClassName",
      "type": "string",
      "description": "Дополнительный класс контейнера"
    },
    {
      "name": "selectedId",
      "type": "SelectedId",
      "description": "Id активного таба"
    },
    {
      "name": "keepMounted",
      "type": "boolean",
      "description": "Рендерить неактивные табы"
    },
    {
      "name": "view",
      "type": "\"primary\" | \"secondary\"",
      "default": "primary",
      "description": "Внешний вид заголовков табов"
    },
    {
      "name": "textStyle",
      "type": "\"accent-primary-large\" | \"accent-primary-medium\" | \"accent-primary-small\" | \"action-primary-large\" | \"action-primary-medium\" | \"action-primary-small\" | \"headline-large\" | ... 12 more ...",
      "description": "Стиль текста. Имеет приоритет над size. Работает только в primary табах."
    },
    {
      "name": "size",
      "type": "\"xxs\" | \"xs\" | \"s\" | \"m\" | \"l\" | \"xl\"",
      "description": "Высота заголовков табов"
    },
    {
      "name": "mobile",
      "type": "boolean",
      "description": "Мобильный вид"
    },
    {
      "name": "scrollable",
      "type": "boolean",
      "default": false,
      "description": "Рендерить заголовки табов в контейнере со скроллом"
    },
    {
      "name": "fullWidthScroll",
      "type": "boolean",
      "description": "При скроле табы будут уходить в край экрана"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "breakpoint",
      "type": "number",
      "default": "1024",
      "description": "Контрольная точка, с нее начинается desktop версия"
    },
    {
      "name": "client",
      "type": "\"mobile\" | \"desktop\"",
      "description": "Версия, которая будет использоваться при серверном рендеринге"
    },
    {
      "name": "defaultMatchMediaValue",
      "type": "boolean | (() => boolean)",
      "default": "client === undefined ? undefined : client === 'desktop'",
      "description": "Значение по-умолчанию для хука useMatchMedia\n@deprecated Используйте client"
    },
    {
      "name": "tagShape",
      "type": "\"rounded\" | \"rectangular\"",
      "description": "Форма тега (для view secondary только)"
    },
    {
      "name": "tagView",
      "type": "\"outlined\" | \"filled\" | \"transparent\"",
      "description": "Стиль тега (для view secondary только)"
    },
    {
      "name": "showSkeleton",
      "type": "boolean",
      "description": "Показать скелетон"
    },
    {
      "name": "skeletonProps",
      "type": "Omit<SkeletonProps, \"visible\">",
      "description": "Доп. пропсы для скелетона"
    },
    {
      "name": "titleProps",
      "type": "TitleProps",
      "description": "Доп. пропсы для заголовка таба"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
