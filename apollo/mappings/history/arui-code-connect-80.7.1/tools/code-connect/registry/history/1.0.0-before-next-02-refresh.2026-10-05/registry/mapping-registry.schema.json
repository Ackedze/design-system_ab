{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "apollo.arui-private-mappings.v1",
  "title": "Code Connect owned registry input for Apollo v4 Generation",
  "type": "object",
  "required": ["schemaVersion", "registryVersion", "registryDigest", "targetProduct", "targetPath", "source", "mappingArtifacts", "mappings", "availabilityPolicy"],
  "properties": {
    "schemaVersion": {"const": "apollo.arui-private-mappings.v1"},
    "registryVersion": {"const": "1.0.0"},
    "registryDigest": {"$ref": "#/$defs/hash"},
    "targetProduct": {"const": "apollo-v4"},
    "targetPath": {"const": "projects/Apollo-v3/apps/apollo-v4"},
    "generatedAt": {"type": "string"},
    "source": {
      "type": "object", "required": ["package", "version", "commit", "files", "exportPolicy"],
      "properties": {
        "package": {"const": "arui-private"}, "version": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filePin"}}
      }
    },
    "mappingArtifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/filePin"}},
    "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
    "availabilityPolicy": {"type": "object", "required": ["allowedImports", "unknownComponents", "unknownProps", "unknownSlots", "unknownPlatforms", "stalePins"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filePin": {"type": "object", "required": ["path", "sha256", "trackedSourceDirty"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "trackedSourceDirty": {"type": "boolean"}}},
    "mapping": {
      "type": "object", "required": ["id", "kind", "contract", "figma", "code", "platforms", "status", "propertyMappings", "gaps", "evidence"],
      "properties": {
        "id": {"type": "string"}, "kind": {"enum": ["buttons-group", "corporate-content"]},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["desktop", "mobile-web"]}},
        "contract": {"type": "object", "required": ["componentId", "familyId", "contractId", "revision", "archivePath", "archiveSha256", "manualSha256"], "properties": {"revision": {"type": "integer", "minimum": 1}, "archiveSha256": {"$ref": "#/$defs/hash"}, "manualSha256": {"$ref": "#/$defs/hash"}}},
        "figma": {"type": "object", "required": ["representationId", "componentKey", "fileKey", "nodeId"]},
        "code": {"type": "object", "required": ["package", "version", "subpath", "export", "source", "api", "defaults", "publicExportStatus", "proposedRepresentationId"], "properties": {"package": {"const": "arui-private"}, "subpath": {"enum": ["arui-private/button-group", "arui-private/corporate-content"]}, "api": {"type": "array", "items": {"type": "object", "required": ["name", "required", "type", "evidence"]}}}},
        "status": {"type": "object", "required": ["apiMapping", "fullContractParity", "liveAcceptance", "publication", "release"], "properties": {"apiMapping": {"const": "confirmed-source-api"}, "fullContractParity": {"const": "not-confirmed"}}},
        "propertyMappings": {"type": "array", "items": {"type": "object", "required": ["from", "to", "transform"]}},
        "gaps": {"type": "array", "items": {"type": "object", "required": ["id", "description", "sources"]}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
