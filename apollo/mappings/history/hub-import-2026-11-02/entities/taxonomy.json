{
  "$schema": "hub/taxonomy@1",
  "description": "Авторский файл хаба: идентичность и классификация сущностей. Адаптеры его только читают. Новые пакеты источника без записи здесь импортируются не будут — адаптер выведет их список.",
  "libraries": {
    "core": "@alfalab/core-components — атомарные компоненты (read-only для хаба)",
    "corp": "arui-private — корпоративные компоненты Альфа-Бизнеса",
    "promo": "arui-private — промо-компоненты (лендинги, маркетинг)",
    "preset": "Figma-пресеты корпоративных экранов",
    "limited": "Ограниченные компоненты: не подключать в новые продукты",
    "helper": "Служебные Figma-компоненты (сетка, документация); нужны только для распознавания макетов"
  },
  "levels": {
    "primitive": "Атомарный компонент core-components",
    "component": "Самостоятельный переиспользуемый компонент",
    "composite": "Собирается из нескольких компонентов",
    "helper": "Вне иерархии: служебный Figma-компонент"
  },
  "categories": {
    "action": "Действия",
    "input": "Ввод данных",
    "layout": "Раскладка",
    "feedback": "Обратная связь",
    "data": "Отображение данных",
    "overlay": "Оверлеи",
    "navigation": "Навигация",
    "media": "Медиа",
    "calendar": "Календари",
    "upload": "Загрузка файлов"
