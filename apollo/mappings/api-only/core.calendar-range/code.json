{
  "$schema": "hub/facet.code@1",
  "package": "@alfalab/core-components-calendar-range",
  "import": "@alfalab/core-components/calendar-range",
  "version": "9.1.1",
  "component": "CalendarRange",
  "description": "Используется для ввода диапазона дат.",
  "props": [
    {
      "name": "className",
      "type": "string",
      "description": "Дополнительный класс"
    },
    {
      "name": "valueFrom",
      "type": "string",
      "description": "Значение инпута (используется и для календаря)"
    },
    {
      "name": "valueTo",
      "type": "string",
      "description": "Значение инпута (используется и для календаря)"
    },
    {
      "name": "defaultMonth",
      "type": "number",
      "description": "Месяц в календаре по умолчанию"
    },
    {
      "name": "minDate",
      "type": "number",
      "description": "Минимальная дата, доступная для выбора (timestamp)"
    },
    {
      "name": "maxDate",
      "type": "number",
      "description": "Максимальная дата, доступная для выбора (timestamp)"
    },
    {
      "name": "onDateFromChange",
      "type": "((payload: { date: number | null; value: string; }) => void)",
      "description": "Обработчик изменения даты от"
    },
    {
      "name": "onDateToChange",
      "type": "((payload: { date: number | null; value: string; }) => void)",
      "description": "Обработчик изменения даты до"
    },
    {
      "name": "onChange",
      "type": "((payload: { dateFrom: number | null; valueFrom: string; dateTo: number | null; valueTo: string; }) => void)",
      "description": "Обработчик изменения"
    },
    {
      "name": "onError",
      "type": "((hasError: boolean) => void)",
      "description": "Коллбэк, срабатывающий при возникновении ошибок валидации дат внутри компонента."
    },
    {
      "name": "events",
      "type": "(number | Date)[]",
      "description": "Список событий"
    },
    {
      "name": "offDays",
      "type": "(number | Date)[]",
      "description": "Список выходных"
    },
    {
      "name": "inputFromProps",
      "type": "CalendarInputResponsiveProps",
      "description": "Пропсы для инпута даты от"
    },
    {
      "name": "inputToProps",
      "type": "CalendarInputResponsiveProps",
      "description": "Пропсы для инпута даты до"
    },
    {
      "name": "dataTestId",
      "type": "string",
      "description": "Идентификатор для систем автоматизированного тестирования"
    },
    {
      "name": "calendarPosition",
      "type": "\"static\" | \"popover\"",
      "default": "static",
      "description": "Определяет, как рендерить календарь — в поповере или снизу инпута"
    },
    {
      "name": "defaultMonthPosition",
      "type": "\"left\" | \"right\"",
      "description": "calendarPosition = static\nОтображать начальный месяц слева или справа (влияет только на начальный рендер)"
    },
    {
      "name": "returnInvalidDates",
      "type": "boolean",
      "description": "Возвращать невалидную дату для кастомной валидации"
    },
    {
      "name": "calendarContainerClassName",
      "type": "string",
      "description": "Дополнительный класс для контейнера календаря"
    },
    {
      "name": "autoSwap",
      "type": "boolean",
      "description": "Автоподмена дат"
    }
  ],
  "propsSource": "core-components-mcp v50.20.0"
}
