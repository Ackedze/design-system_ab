{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "audit-analysis",
        "design-dialogue"
      ]
    },
    "primaryIntent": {
      "type": "string",
      "enum": [
        "analyze_report",
        "summarize_report",
        "explain_finding",
        "find_pattern_context",
        "explain_component_usage",
        "design_consultation",
        "find_examples",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "analyze",
        "summarize",
        "explain",
        "search",
        "consult",
        "clarify",
        "unknown"
      ]
    },
    "inputType": {
      "type": "string",
      "enum": [
        "apollo_agent_request",
        "apollo_agent_report",
        "apollo_full_report",
        "apollo_finding",
        "follow_up",
        "plain_request",
        "unknown"
      ]
    },
    "contextMode": {
      "type": "string",
      "enum": [
        "none",
        "selection",
        "finding",
        "audit_report",
        "mixed"
      ]
    },
    "reportKind": {
      "type": "string"
    },
    "sourceReportId": {
      "type": "string"
    },
    "requestedCategory": {
      "type": "string"
    },
    "requestedComponent": {
      "type": "string"
    },
    "requestedRuleId": {
      "type": "string"
    },
    "requestedPattern": {
      "type": "string"
    },
    "requestedScenario": {
      "type": "string"
    },
    "requestedSurface": {
      "type": "string"
    },
    "routingHints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "needsPattern": {
      "type": "boolean"
    },
    "needsRag": {
      "type": "boolean"
    },
    "shouldAnalyzeReport": {
      "type": "boolean"
    },
    "shouldUseConversationHistory": {
      "type": "boolean"
    },
    "needsClarification": {
      "type": "boolean"
    },
    "taskSummary": {
      "type": "string",
      "maxLength": 320
    }
  },
  "required": [
    "mode",
    "primaryIntent",
    "confidence",
    "action",
    "inputType",
    "contextMode",
    "reportKind",
    "sourceReportId",
    "requestedCategory",
    "requestedComponent",
    "requestedRuleId",
    "requestedPattern",
    "requestedScenario",
    "requestedSurface",
    "routingHints",
    "needsPattern",
    "needsRag",
    "shouldAnalyzeReport",
    "shouldUseConversationHistory",
    "needsClarification",
    "taskSummary"
