                "analyze",
                "summarize",
                "explain",
                "search",
                "unknown"
            ]
        },
        "inputType": {
            "type": "string",
            "enum": [
                "apollo_agent_report",
                "apollo_full_report",
                "apollo_finding",
                "follow_up",
                "plain_request",
                "unknown"
            ]
        },
        "reportKind": {
            "type": "string"
        },
        "sourceReportId": {
            "type": "string"
        },
        "requestedCategory": {
            "type": "string"
        },
        "requestedComponent": {
            "type": "string"
        },
        "requestedRuleId": {
            "type": "string"
        },
        "needsPattern": {
            "type": "boolean"
        },
        "needsRag": {
            "type": "boolean"
        },
        "shouldAnalyzeReport": {
            "type": "boolean"
        },
        "taskSummary": {
            "type": "string",
            "maxLength": 240
        }
