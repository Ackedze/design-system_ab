    "required": [
        "primaryIntent",
        "confidence",
        "action",
        "inputType",
        "reportKind",
        "sourceReportId",
        "requestedCategory",
        "requestedComponent",
        "requestedRuleId",
        "needsPattern",
        "needsRag",
        "shouldAnalyzeReport",
        "taskSummary"
