        "primaryIntent": {
            "type": "string",
            "enum": [
                "analyze_report",
                "summarize_report",
                "explain_finding",
                "find_pattern_context",
                "find_examples",
                "unknown"
            ]
        },
        "confidence": {
            "type": "string",
            "enum": [
                "high",
                "medium",
                "low"
            ]
        },
        "action": {
            "type": "string",
